// std.math — pure integer helpers over Rust math microarchitecture.
// Typed params keep contracts in the Phase-4 QF_BV modelable set.

pub fn math_add(a: u32, b: u32) -> u32 ensures(result == a + b) {
    return a + b;
}

pub fn math_sub(a: u32, b: u32) -> u32 ensures(result == a - b) {
    return a - b;
}

// Two u32 factors can product past i64: 4294967295^2 is about 1.8e19 against an i64 ceiling of
// 9.2e18, so an unbounded `a * b` wraps. The checker demanded a bound rather than assuming one, and
// these are its own counterexample-derived factors: 3037000499 is floor(sqrt(2^63 - 1)), so the
// product of two bounded factors still fits. Stated on the signature because a caller is entitled to
// know the domain from the declaration rather than from a wrap at run time.
pub fn math_mul(a: u32, b: u32) -> u32
    requires(a <= 3037000499)
    requires(b <= 3037000499)
    ensures(result == a * b)
{
    return a * b;
}

pub fn math_abs(x) {
    return abs(x);
}

pub fn math_min(a, b) {
    return min(a, b);
}

pub fn math_max(a, b) {
    return max(a, b);
}

pub fn math_clamp(x, lo, hi) {
    if x < lo { return lo; }
    if x > hi { return hi; }
    return x;
}

pub fn math_sign(x) {
    if x < 0 { return 0 - 1; }
    if x > 0 { return 1; }
    return 0;
}

// Integer power: base^exp for exp >= 0 (wrapping i64). No ensures — loop body.
pub fn math_pow_u(base, exp) {
    let mut r = 1;
    let mut e = exp;
    let mut b = base;
    while e > 0 {
        if e % 2 == 1 {
            r = r * b;
        }
        b = b * b;
        e = e / 2;
    }
    return r;
}

// Euclidean GCD (non-negative result).
pub fn math_gcd(a, b) {
    let mut x = abs(a);
    let mut y = abs(b);
    while y != 0 {
        let t = y;
        y = x % y;
        x = t;
    }
    return x;
}

pub fn math_lcm(a, b) {
    if a == 0 || b == 0 { return 0; }
    let g = math_gcd(a, b);
    return abs(a / g * b);
}
