// Anubis-SH self-hosting compiler (Phase 8) — single-file ASCII.
// args: lex|parse|check|compile <file> [-o out] | version
//
// Dogfood: the compiler's statement AST is an Anubis `enum` (below), built in
// parse_stmt and consumed by `match` in jstmt (codegen) and check_stmt (checker).
// The emitted JSON wire format is unchanged — this is internal representation.

enum Stmt {
    Let { name: any, ty: any, init: any },
    Assign { target: any, value: any },
    Return { value: any },
    ExprStmt { expr: any },
    If { cond: any, then_: any, else_: any, has_else: any },
    While { cond: any, body: any },
    For { var: any, iter: any, body: any },
}

// Expression AST. Tuple variants for the atoms (Int/Str/Bool/Var), struct variants
// for compound nodes. Built in parse_prefix/parse_expr; consumed by `match` in jexpr
// (codegen) and check_expr (checker). Emitted JSON wire format unchanged.
enum Expr {
    None,
    Int(any),
    Str(any),
    Bool(any),
    Var(any),
    Call { callee: any, args: any },
    Binary { op: any, lhs: any, rhs: any },
    Unary { op: any, expr: any },
    Index { base: any, index: any },
    List { elements: any },
    Range { start: any, end: any },
    Map { keys: any, vals: any },
    EnumInit { ty: any, variant: any, shape: any, tuple: any, fnames: any, fexprs: any },
    IfExpr { cond: any, then_: any, else_: any },
    Match { scrut: any, arms: any },
    // Phase-4 #104: closure literal `|p1, p2| body` (expression body). Only appears as an argument to
    // a higher-order builtin (map/filter/each/…); the effect engine descends into its body when the
    // callee is a closure-applying builtin (higher_order_closure_args). anubis_sh.anb itself uses no
    // lambdas, so this variant is unreached during self-compile.
    Lambda { params: any, body: any },
    // Phase-4 #108: method/receiver call `recv.method(args)` and field access `recv.field`. The Rust
    // effect engine treats a method/receiver call as OPEN (unresolvable — effects.rs:306-314) and a
    // field access as walk-base. anubis_sh.anb uses neither (it uses `m["k"]` indexing), so both are
    // unreached during self-compile.
    MethodCall { recv: any, method: any, args: any },
    FieldAccess { base: any, field: any },
}

fn json_escape(s) {
    let out = "";
    let i = 0;
    while i < len(s) {
        let c = char_at(s, i);
        let o = ord(c);
        out = out + if o == 92 { "\\\\" }
            else if o == 34 { "\\\"" }
            else if o == 10 { "\\n" }
            else if o == 9 { "\\t" }
            else { c };
        i = i + 1;
    }
    return out;
}

fn q(s) {
    return "\"" + json_escape(s) + "\"";
}

fn jbool(b) {
    return if b { "true" } else { "false" };
}

fn jtok(t) {
    return "{\"kind\":" + q(t["kind"]) + ",\"text\":" + q(t["text"]) + ",\"start\":" + ("" + t["start"]) + ",\"end\":" + ("" + t["end"]) + "}";
}

fn jtokens(ts) {
    let out = "[";
    let i = 0;
    while i < len(ts) {
        if i > 0 { out = out + ","; }
        out = out + jtok(ts[i]);
        i = i + 1;
    }
    return out + "]";
}

fn is_ws(o) { return o == 32 || o == 9 || o == 10 || o == 13; }
fn is_alpha(o) { return (o >= 65 && o <= 90) || (o >= 97 && o <= 122) || o == 95; }
fn is_digit(o) { return o >= 48 && o <= 57; }
fn is_alnum(o) { return is_alpha(o) || is_digit(o); }

fn is_kw(text) {
    return text == "fn" || text == "let" || text == "mut" || text == "if" || text == "else" || text == "while" || text == "for" || text == "in" || text == "return" || text == "pub" || text == "true" || text == "false" || text == "requires" || text == "ensures" || text == "uses";
}

fn tok(kind, text, start, end) {
    return {"kind": kind, "text": text, "start": start, "end": end};
}

fn sh_lex(src) {
    let tokens = [];
    let i = 0;
    let n = len(src);
    while i < n {
        let c = char_at(src, i);
        let o = ord(c);
        if is_ws(o) {
            i = i + 1;
        } else {
            if c == "/" && i + 1 < n && char_at(src, i + 1) == "/" {
                i = i + 2;
                while i < n {
                    if ord(char_at(src, i)) == 10 { break; }
                    i = i + 1;
                }
            } else {
                if c == "/" && i + 1 < n && char_at(src, i + 1) == "*" {
                    i = i + 2;
                    let depth = 1;
                    while i < n {
                        if depth == 0 { break; }
                        if char_at(src, i) == "/" && i + 1 < n && char_at(src, i + 1) == "*" {
                            depth = depth + 1;
                            i = i + 2;
                        } else {
                            if char_at(src, i) == "*" && i + 1 < n && char_at(src, i + 1) == "/" {
                                depth = depth - 1;
                                i = i + 2;
                            } else {
                                i = i + 1;
                            }
                        }
                    }
                } else {
                    let start = i;
                    if is_alpha(o) {
                        i = i + 1;
                        while i < n {
                            if is_alnum(ord(char_at(src, i))) == false { break; }
                            i = i + 1;
                        }
                        let text = substr(src, start, i - start);
                        let kind = "Ident";
                        if is_kw(text) { kind = "Keyword"; }
                        push(tokens, tok(kind, text, start, i));
                    } else {
                        if is_digit(o) {
                            i = i + 1;
                            while i < n {
                                if is_digit(ord(char_at(src, i))) == false { break; }
                                i = i + 1;
                            }
                            push(tokens, tok("Number", substr(src, start, i - start), start, i));
                        } else {
                            if c == "\"" {
                                i = i + 1;
                                let text = "";
                                while i < n {
                                    if char_at(src, i) == "\"" { break; }
                                    if char_at(src, i) == "\\" && i + 1 < n {
                                        let nx = char_at(src, i + 1);
                                        if nx == "n" { text = text + chr(10); }
                                        else {
                                            if nx == "t" { text = text + chr(9); }
                                            else { text = text + nx; }
                                        }
                                        i = i + 2;
                                    } else {
                                        text = text + char_at(src, i);
                                        i = i + 1;
                                    }
                                }
                                if i < n { i = i + 1; }
                                push(tokens, tok("String", text, start, i));
                            } else {
                                let advanced = 0;
                                if i + 1 < n {
                                    let two = substr(src, i, 2);
                                    if two == "::" { push(tokens, tok("ColonColon", "::", start, i + 2)); i = i + 2; advanced = 1; }
                                    if advanced == 0 && two == ".." { push(tokens, tok("DotDot", "..", start, i + 2)); i = i + 2; advanced = 1; }
                                    if advanced == 0 && two == "&&" { push(tokens, tok("AmpAmp", "&&", start, i + 2)); i = i + 2; advanced = 1; }
                                    if advanced == 0 && two == "||" { push(tokens, tok("PipePipe", "||", start, i + 2)); i = i + 2; advanced = 1; }
                                    if advanced == 0 && two == "==" { push(tokens, tok("EqEq", "==", start, i + 2)); i = i + 2; advanced = 1; }
                                    if advanced == 0 && two == "!=" { push(tokens, tok("Ne", "!=", start, i + 2)); i = i + 2; advanced = 1; }
                                    if advanced == 0 && two == "<=" { push(tokens, tok("Le", "<=", start, i + 2)); i = i + 2; advanced = 1; }
                                    if advanced == 0 && two == ">=" { push(tokens, tok("Ge", ">=", start, i + 2)); i = i + 2; advanced = 1; }
                                }
                                if advanced == 0 {
                                    let kind = if c == "(" { "LParen" }
                                        else if c == ")" { "RParen" }
                                        else if c == "{" { "LBrace" }
                                        else if c == "}" { "RBrace" }
                                        else if c == "[" { "LBracket" }
                                        else if c == "]" { "RBracket" }
                                        else if c == ":" { "Colon" }
                                        else if c == ";" { "Semi" }
                                        else if c == "," { "Comma" }
                                        else if c == "." { "Dot" }
                                        else if c == "+" { "Plus" }
                                        else if c == "-" { "Minus" }
                                        else if c == "*" { "Star" }
                                        else if c == "/" { "Slash" }
                                        else if c == "%" { "Percent" }
                                        else if c == "=" { "Eq" }
                                        else if c == "<" { "Lt" }
                                        else if c == ">" { "Gt" }
                                        else if c == "!" { "Bang" }
                                        else if c == "&" { "Amp" }
                                        else if c == "|" { "Pipe" }
                                        else { "Other" };
                                    push(tokens, tok(kind, c, start, start + 1));
                                    i = i + 1;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return tokens;
}

// Parser: integer pos threaded in results as "pos"
fn perr(msg, pos) { return {"ok": false, "err": msg, "pos": pos}; }
fn pok(node, pos) { return {"ok": true, "node": node, "pos": pos}; }

fn prec_of(op) {
    return if op == "||" { 1 }
        else if op == "&&" { 2 }
        else if op == "==" || op == "!=" { 3 }
        else if op == "<" || op == ">" || op == "<=" || op == ">=" { 4 }
        else if op == "+" || op == "-" { 5 }
        else if op == "*" || op == "/" || op == "%" { 6 }
        else { 0 };
}

fn at_end(tokens, pos) { return pos >= len(tokens); }
fn peek(tokens, pos) {
    if at_end(tokens, pos) { return {"kind": "Eof", "text": "", "start": 0, "end": 0}; }
    return tokens[pos];
}
fn kind_is(tokens, pos, kind) { return peek(tokens, pos)["kind"] == kind; }
fn text_is(tokens, pos, text) { return peek(tokens, pos)["text"] == text; }

fn parse_prefix(tokens, pos) {
    let t = peek(tokens, pos);
    if t["kind"] == "Pipe" {
        // Phase-4 #104: closure literal `|p1, p2| body`. A single `|` (Pipe) has no infix precedence
        // (prec_of == 0) and `||` is a distinct token (PipePipe), so a `|` at prefix position is
        // unambiguously a lambda. Params are bare idents; the body is a single expression.
        pos = pos + 1;
        let params = [];
        if kind_is(tokens, pos, "Pipe") == false {
            while true {
                let pt = peek(tokens, pos);
                push(params, pt["text"]);
                pos = pos + 1;
                if kind_is(tokens, pos, "Comma") { pos = pos + 1; } else { break; }
            }
        }
        if kind_is(tokens, pos, "Pipe") == false { return perr("expected | to close lambda params", pos); }
        pos = pos + 1;
        let body = parse_expr(tokens, pos, 0);
        if body["ok"] == false { return body; }
        return pok(Expr::Lambda { params: params, body: body["node"] }, body["pos"]);
    }
    if t["text"] == "if" && t["kind"] == "Keyword" {
        return parse_if_expr(tokens, pos);
    }
    if t["text"] == "match" && t["kind"] == "Ident" {
        return parse_match_expr(tokens, pos);
    }
    if t["kind"] == "Number" {
        return pok(Expr::Int(t["text"]), pos + 1);
    }
    if t["kind"] == "String" {
        return pok(Expr::Str(t["text"]), pos + 1);
    }
    if t["text"] == "true" {
        return pok(Expr::Bool(true), pos + 1);
    }
    if t["text"] == "false" {
        return pok(Expr::Bool(false), pos + 1);
    }
    if t["kind"] == "Ident" || t["kind"] == "Keyword" {
        // Keywords may be used as ordinary names in SH sources (e.g. list named `requires`).
        let name = t["text"];
        if name == "true" {
            return pok(Expr::Bool(true), pos + 1);
        }
        if name == "false" {
            return pok(Expr::Bool(false), pos + 1);
        }
        pos = pos + 1;
        if kind_is(tokens, pos, "ColonColon") {
            return parse_enum_init(tokens, pos + 1, name);
        }
        if kind_is(tokens, pos, "LParen") {
            pos = pos + 1;
            let args = [];
            if kind_is(tokens, pos, "RParen") == false {
                let a0 = parse_expr(tokens, pos, 0);
                if a0["ok"] == false { return a0; }
                push(args, a0["node"]);
                pos = a0["pos"];
                while kind_is(tokens, pos, "Comma") {
                    pos = pos + 1;
                    let a = parse_expr(tokens, pos, 0);
                    if a["ok"] == false { return a; }
                    push(args, a["node"]);
                    pos = a["pos"];
                }
            }
            if kind_is(tokens, pos, "RParen") == false { return perr("expected )", pos); }
            pos = pos + 1;
            return pok(Expr::Call { callee: name, args: args }, pos);
        }
        return pok(Expr::Var(name), pos);
    }
    if t["kind"] == "LParen" {
        let e = parse_expr(tokens, pos + 1, 0);
        if e["ok"] == false { return e; }
        pos = e["pos"];
        if kind_is(tokens, pos, "RParen") == false { return perr("expected )", pos); }
        return pok(e["node"], pos + 1);
    }
    if t["kind"] == "LBracket" {
        pos = pos + 1;
        let els = [];
        if kind_is(tokens, pos, "RBracket") == false {
            let e0 = parse_expr(tokens, pos, 0);
            if e0["ok"] == false { return e0; }
            push(els, e0["node"]);
            pos = e0["pos"];
            while kind_is(tokens, pos, "Comma") {
                pos = pos + 1;
                let e = parse_expr(tokens, pos, 0);
                if e["ok"] == false { return e; }
                push(els, e["node"]);
                pos = e["pos"];
            }
        }
        if kind_is(tokens, pos, "RBracket") == false { return perr("expected ]", pos); }
        return pok(Expr::List { elements: els }, pos + 1);
    }
    if t["kind"] == "LBrace" {
        // map literal: { "k": expr, ... }  (expression position)
        pos = pos + 1;
        let keys = [];
        let vals = [];
        if kind_is(tokens, pos, "RBrace") == false {
            while true {
                let kt = peek(tokens, pos);
                if kt["kind"] != "String" && kt["kind"] != "Ident" && kt["kind"] != "Keyword" {
                    return perr("map key", pos);
                }
                pos = pos + 1;
                let key = kt["text"];
                if kind_is(tokens, pos, "Colon") == false { return perr("expected :", pos); }
                pos = pos + 1;
                let v = parse_expr(tokens, pos, 0);
                if v["ok"] == false { return v; }
                push(keys, key);
                push(vals, v["node"]);
                pos = v["pos"];
                if kind_is(tokens, pos, "Comma") {
                    pos = pos + 1;
                } else {
                    break;
                }
            }
        }
        if kind_is(tokens, pos, "RBrace") == false { return perr("expected }", pos); }
        return pok(Expr::Map { keys: keys, vals: vals }, pos + 1);
    }
    if t["kind"] == "Bang" || t["kind"] == "Minus" {
        let op = t["text"];
        let e = parse_prefix(tokens, pos + 1);
        if e["ok"] == false { return e; }
        return pok(Expr::Unary { op: op, expr: e["node"] }, e["pos"]);
    }
    return perr("bad expr near " + t["text"], pos);
}

fn parse_expr(tokens, pos, min_prec) {
    let left = parse_prefix(tokens, pos);
    if left["ok"] == false { return left; }
    let node = left["node"];
    pos = left["pos"];
    while kind_is(tokens, pos, "LBracket") || (kind_is(tokens, pos, "Dot") && (kind_is(tokens, pos + 1, "Ident") || kind_is(tokens, pos + 1, "Keyword"))) {
        // The `.` postfix fires ONLY when a NAME follows (a method/field). A `.` followed by a Number
        // is a float literal fragment (SH lexes `1.5` as `1` `.` `5`, unsupported) — leave it for the
        // pre-#108 behaviour (parse error → SKIP), NOT a bogus FieldAccess on the digits.
        if kind_is(tokens, pos, "LBracket") {
            let ix = parse_expr(tokens, pos + 1, 0);
            if ix["ok"] == false { return ix; }
            pos = ix["pos"];
            if kind_is(tokens, pos, "RBracket") == false { return perr("expected ]", pos); }
            pos = pos + 1;
            node = Expr::Index { base: node, index: ix["node"] };
        } else {
            // #108: postfix `.` — a method call `recv.method(args)` or a field access `recv.field`.
            pos = pos + 1;
            let m = peek(tokens, pos);
            pos = pos + 1;
            if kind_is(tokens, pos, "LParen") {
                pos = pos + 1;
                let margs = [];
                if kind_is(tokens, pos, "RParen") == false {
                    let a0 = parse_expr(tokens, pos, 0);
                    if a0["ok"] == false { return a0; }
                    push(margs, a0["node"]);
                    pos = a0["pos"];
                    while kind_is(tokens, pos, "Comma") {
                        pos = pos + 1;
                        let a = parse_expr(tokens, pos, 0);
                        if a["ok"] == false { return a; }
                        push(margs, a["node"]);
                        pos = a["pos"];
                    }
                }
                if kind_is(tokens, pos, "RParen") == false { return perr("expected )", pos); }
                pos = pos + 1;
                node = Expr::MethodCall { recv: node, method: m["text"], args: margs };
            } else {
                node = Expr::FieldAccess { base: node, field: m["text"] };
            }
        }
    }
    while true {
        let t = peek(tokens, pos);
        let p = prec_of(t["text"]);
        if p == 0 || p < min_prec { break; }
        let op = t["text"];
        let right = parse_expr(tokens, pos + 1, p + 1);
        if right["ok"] == false { return right; }
        node = Expr::Binary { op: op, lhs: node, rhs: right["node"] };
        pos = right["pos"];
    }
    return pok(node, pos);
}

fn parse_type(tokens, pos) {
    let t = peek(tokens, pos);
    if t["kind"] == "Ident" || t["kind"] == "Keyword" {
        return {"ok": true, "ty": t["text"], "pos": pos + 1};
    }
    return perr("type", pos);
}

// Enum construction: Name::Variant | Name::Variant(a, b) | Name::Variant { f: e, ... }
// `pos` points at the variant name token (just past `::`); `ty` is the enum name.
fn parse_enum_init(tokens, pos, ty) {
    let vt = peek(tokens, pos);
    let variant = vt["text"];
    pos = pos + 1;
    if kind_is(tokens, pos, "LParen") {
        pos = pos + 1;
        let tup = [];
        if kind_is(tokens, pos, "RParen") == false {
            let a0 = parse_expr(tokens, pos, 0);
            if a0["ok"] == false { return a0; }
            push(tup, a0["node"]);
            pos = a0["pos"];
            while kind_is(tokens, pos, "Comma") {
                pos = pos + 1;
                let a = parse_expr(tokens, pos, 0);
                if a["ok"] == false { return a; }
                push(tup, a["node"]);
                pos = a["pos"];
            }
        }
        if kind_is(tokens, pos, "RParen") == false { return perr("expected ) in variant", pos); }
        pos = pos + 1;
        return pok(Expr::EnumInit { ty: ty, variant: variant, shape: "tuple", tuple: tup, fnames: [], fexprs: [] }, pos);
    }
    if kind_is(tokens, pos, "LBrace") {
        pos = pos + 1;
        let fnames = [];
        let fexprs = [];
        if kind_is(tokens, pos, "RBrace") == false {
            while true {
                let fnt = peek(tokens, pos);
                pos = pos + 1;
                if kind_is(tokens, pos, "Colon") == false { return perr("expected : in variant", pos); }
                pos = pos + 1;
                let v = parse_expr(tokens, pos, 0);
                if v["ok"] == false { return v; }
                push(fnames, fnt["text"]);
                push(fexprs, v["node"]);
                pos = v["pos"];
                if kind_is(tokens, pos, "Comma") { pos = pos + 1; } else { break; }
            }
        }
        if kind_is(tokens, pos, "RBrace") == false { return perr("expected } in variant", pos); }
        pos = pos + 1;
        return pok(Expr::EnumInit { ty: ty, variant: variant, shape: "struct", tuple: [], fnames: fnames, fexprs: fexprs }, pos);
    }
    return pok(Expr::EnumInit { ty: ty, variant: variant, shape: "unit", tuple: [], fnames: [], fexprs: [] }, pos);
}

// if-expression: `if cond { block } else { block }` / `else if ...` chains.
// `pos` points at the `if` keyword.
fn parse_if_expr(tokens, pos) {
    let cond = parse_expr(tokens, pos + 1, 0);
    if cond["ok"] == false { return cond; }
    let th = parse_block(tokens, cond["pos"]);
    if th["ok"] == false { return th; }
    pos = th["pos"];
    let el = [];
    if text_is(tokens, pos, "else") {
        pos = pos + 1;
        if text_is(tokens, pos, "if") {
            let nested = parse_if_expr(tokens, pos);
            if nested["ok"] == false { return nested; }
            el = [Stmt::ExprStmt { expr: nested["node"] }];
            pos = nested["pos"];
        } else {
            let eb = parse_block(tokens, pos);
            if eb["ok"] == false { return eb; }
            el = eb["stmts"];
            pos = eb["pos"];
        }
    }
    return pok(Expr::IfExpr { cond: cond["node"], then_: th["stmts"], else_: el }, pos);
}

// match-expression: `match scrut { pat => expr, ... }`.  `pos` points at `match`.
fn parse_match_expr(tokens, pos) {
    let scrut = parse_expr(tokens, pos + 1, 0);
    if scrut["ok"] == false { return scrut; }
    pos = scrut["pos"];
    if kind_is(tokens, pos, "LBrace") == false { return perr("expected { in match", pos); }
    pos = pos + 1;
    let arms = [];
    while at_end(tokens, pos) == false && kind_is(tokens, pos, "RBrace") == false {
        let pat = parse_pattern(tokens, pos);
        if pat["ok"] == false { return pat; }
        pos = pat["pos"];
        // `=>` lexes as Eq then Gt (no fat-arrow token in the SH lexer).
        if kind_is(tokens, pos, "Eq") == false { return perr("expected => in match arm", pos); }
        pos = pos + 1;
        if kind_is(tokens, pos, "Gt") == false { return perr("expected => in match arm", pos); }
        pos = pos + 1;
        let body = parse_expr(tokens, pos, 0);
        if body["ok"] == false { return body; }
        pos = body["pos"];
        push(arms, {"pat": pat["node"], "body": body["node"]});
        if kind_is(tokens, pos, "Comma") { pos = pos + 1; }
    }
    if kind_is(tokens, pos, "RBrace") == false { return perr("expected } in match", pos); }
    pos = pos + 1;
    return pok(Expr::Match { scrut: scrut["node"], arms: arms }, pos);
}

// match patterns: `_` | Enum::Variant | Enum::Variant(a, b) | Enum::Variant { f: bind, ... }
fn parse_pattern(tokens, pos) {
    let t = peek(tokens, pos);
    if t["text"] == "_" {
        return pok({"pk": "wild"}, pos + 1);
    }
    let ty = t["text"];
    pos = pos + 1;
    if kind_is(tokens, pos, "ColonColon") {
        pos = pos + 1;
        let vt = peek(tokens, pos);
        let variant = vt["text"];
        pos = pos + 1;
        if kind_is(tokens, pos, "LParen") {
            pos = pos + 1;
            let binds = [];
            if kind_is(tokens, pos, "RParen") == false {
                while true {
                    let b = peek(tokens, pos);
                    pos = pos + 1;
                    push(binds, b["text"]);
                    if kind_is(tokens, pos, "Comma") { pos = pos + 1; } else { break; }
                }
            }
            if kind_is(tokens, pos, "RParen") == false { return perr("expected ) in pattern", pos); }
            pos = pos + 1;
            return pok({"pk": "enum", "ty": ty, "variant": variant, "shape": "tuple", "binds": binds}, pos);
        }
        if kind_is(tokens, pos, "LBrace") {
            pos = pos + 1;
            let fnames = [];
            let binds = [];
            if kind_is(tokens, pos, "RBrace") == false {
                while true {
                    let fnt = peek(tokens, pos);
                    pos = pos + 1;
                    if kind_is(tokens, pos, "Colon") == false { return perr("expected : in pattern", pos); }
                    pos = pos + 1;
                    let bnt = peek(tokens, pos);
                    pos = pos + 1;
                    push(fnames, fnt["text"]);
                    push(binds, bnt["text"]);
                    if kind_is(tokens, pos, "Comma") { pos = pos + 1; } else { break; }
                }
            }
            if kind_is(tokens, pos, "RBrace") == false { return perr("expected } in pattern", pos); }
            pos = pos + 1;
            return pok({"pk": "enum", "ty": ty, "variant": variant, "shape": "struct", "fnames": fnames, "binds": binds}, pos);
        }
        return pok({"pk": "enum", "ty": ty, "variant": variant, "shape": "unit"}, pos);
    }
    return pok({"pk": "wild"}, pos);
}

// top-level enum declaration: `enum Name { Unit, Tuple(T), Struct { f: T } }`
fn parse_enum(tokens, pos) {
    pos = pos + 1;
    let name_t = peek(tokens, pos);
    let name = name_t["text"];
    pos = pos + 1;
    if kind_is(tokens, pos, "LBrace") == false { return perr("expected { in enum", pos); }
    pos = pos + 1;
    let variants = [];
    while at_end(tokens, pos) == false && kind_is(tokens, pos, "RBrace") == false {
        let vt = peek(tokens, pos);
        let vname = vt["text"];
        pos = pos + 1;
        if kind_is(tokens, pos, "LParen") {
            pos = pos + 1;
            let arity = 0;
            if kind_is(tokens, pos, "RParen") == false {
                while true {
                    let tt = parse_type(tokens, pos);
                    if tt["ok"] == false { return tt; }
                    pos = tt["pos"];
                    arity = arity + 1;
                    if kind_is(tokens, pos, "Comma") { pos = pos + 1; } else { break; }
                }
            }
            if kind_is(tokens, pos, "RParen") == false { return perr("expected ) in enum", pos); }
            pos = pos + 1;
            push(variants, {"name": vname, "shape": "tuple", "arity": arity});
        } else {
            if kind_is(tokens, pos, "LBrace") {
                pos = pos + 1;
                let fnames = [];
                if kind_is(tokens, pos, "RBrace") == false {
                    while true {
                        let fnt = peek(tokens, pos);
                        pos = pos + 1;
                        if kind_is(tokens, pos, "Colon") == false { return perr("expected : in enum", pos); }
                        pos = pos + 1;
                        let tt = parse_type(tokens, pos);
                        if tt["ok"] == false { return tt; }
                        pos = tt["pos"];
                        push(fnames, fnt["text"]);
                        if kind_is(tokens, pos, "Comma") { pos = pos + 1; } else { break; }
                    }
                }
                if kind_is(tokens, pos, "RBrace") == false { return perr("expected } in enum", pos); }
                pos = pos + 1;
                push(variants, {"name": vname, "shape": "struct", "fnames": fnames});
            } else {
                push(variants, {"name": vname, "shape": "unit"});
            }
        }
        if kind_is(tokens, pos, "Comma") { pos = pos + 1; }
    }
    if kind_is(tokens, pos, "RBrace") == false { return perr("expected } in enum", pos); }
    pos = pos + 1;
    return pok({"kind": "Enum", "name": name, "variants": variants}, pos);
}

fn parse_block(tokens, pos) {
    if kind_is(tokens, pos, "LBrace") == false { return perr("expected {", pos); }
    pos = pos + 1;
    let stmts = [];
    while at_end(tokens, pos) == false && kind_is(tokens, pos, "RBrace") == false {
        let st = parse_stmt(tokens, pos);
        if st["ok"] == false { return st; }
        push(stmts, st["node"]);
        pos = st["pos"];
    }
    if kind_is(tokens, pos, "RBrace") == false { return perr("expected }", pos); }
    return {"ok": true, "stmts": stmts, "pos": pos + 1};
}

fn parse_stmt(tokens, pos) {
    if text_is(tokens, pos, "let") {
        pos = pos + 1;
        if text_is(tokens, pos, "mut") { pos = pos + 1; }
        let name_t = peek(tokens, pos);
        pos = pos + 1;
        let ty = "";
        if kind_is(tokens, pos, "Colon") {
            let tn = parse_type(tokens, pos + 1);
            if tn["ok"] == false { return tn; }
            ty = tn["ty"];
            pos = tn["pos"];
        }
        if kind_is(tokens, pos, "Eq") == false { return perr("expected =", pos); }
        let init = parse_expr(tokens, pos + 1, 0);
        if init["ok"] == false { return init; }
        pos = init["pos"];
        if kind_is(tokens, pos, "Semi") { pos = pos + 1; }
        return pok(Stmt::Let { name: name_t["text"], ty: ty, init: init["node"] }, pos);
    }
    if text_is(tokens, pos, "break") {
        pos = pos + 1;
        if kind_is(tokens, pos, "Semi") { pos = pos + 1; }
        return pok(Stmt::ExprStmt { expr: Expr::Call { callee: "break", args: [] } }, pos);
    }
    if text_is(tokens, pos, "return") {
        pos = pos + 1;
        let val = Expr::None;
        if kind_is(tokens, pos, "Semi") == false && kind_is(tokens, pos, "RBrace") == false {
            let e = parse_expr(tokens, pos, 0);
            if e["ok"] == false { return e; }
            val = e["node"];
            pos = e["pos"];
        }
        if kind_is(tokens, pos, "Semi") { pos = pos + 1; }
        return pok(Stmt::Return { value: val }, pos);
    }
    if text_is(tokens, pos, "if") {
        let cond = parse_expr(tokens, pos + 1, 0);
        if cond["ok"] == false { return cond; }
        let th = parse_block(tokens, cond["pos"]);
        if th["ok"] == false { return th; }
        pos = th["pos"];
        let el = [];
        let has_else = false;
        if text_is(tokens, pos, "else") {
            let eb = parse_block(tokens, pos + 1);
            if eb["ok"] == false { return eb; }
            el = eb["stmts"];
            pos = eb["pos"];
            has_else = true;
        }
        return pok(Stmt::If { cond: cond["node"], then_: th["stmts"], else_: el, has_else: has_else }, pos);
    }
    if text_is(tokens, pos, "while") {
        let cond = parse_expr(tokens, pos + 1, 0);
        if cond["ok"] == false { return cond; }
        let body = parse_block(tokens, cond["pos"]);
        if body["ok"] == false { return body; }
        return pok(Stmt::While { cond: cond["node"], body: body["stmts"] }, body["pos"]);
    }
    if text_is(tokens, pos, "for") {
        pos = pos + 1;
        let var_t = peek(tokens, pos);
        pos = pos + 1;
        if text_is(tokens, pos, "in") == false { return perr("expected in", pos); }
        pos = pos + 1;
        let start = parse_expr(tokens, pos, 0);
        if start["ok"] == false { return start; }
        pos = start["pos"];
        if kind_is(tokens, pos, "DotDot") {
            let end = parse_expr(tokens, pos + 1, 0);
            if end["ok"] == false { return end; }
            let body = parse_block(tokens, end["pos"]);
            if body["ok"] == false { return body; }
            return pok(Stmt::For { var: var_t["text"], iter: Expr::Range { start: start["node"], end: end["node"] }, body: body["stmts"] }, body["pos"]);
        }
        let bodyc = parse_block(tokens, pos);
        if bodyc["ok"] == false { return bodyc; }
        return pok(Stmt::For { var: var_t["text"], iter: start["node"], body: bodyc["stmts"] }, bodyc["pos"]);
    }
    let e = parse_expr(tokens, pos, 0);
    if e["ok"] == false { return e; }
    pos = e["pos"];
    if kind_is(tokens, pos, "Eq") {
        let v = parse_expr(tokens, pos + 1, 0);
        if v["ok"] == false { return v; }
        pos = v["pos"];
        if kind_is(tokens, pos, "Semi") { pos = pos + 1; }
        return pok(Stmt::Assign { target: e["node"], value: v["node"] }, pos);
    }
    if kind_is(tokens, pos, "Semi") { pos = pos + 1; }
    return pok(Stmt::ExprStmt { expr: e["node"] }, pos);
}

fn parse_fn(tokens, pos) {
    let is_pub = false;
    if text_is(tokens, pos, "pub") { pos = pos + 1; is_pub = true; }
    if text_is(tokens, pos, "fn") == false { return perr("expected fn", pos); }
    pos = pos + 1;
    let name_t = peek(tokens, pos);
    pos = pos + 1;
    if kind_is(tokens, pos, "LParen") == false { return perr("expected (", pos); }
    pos = pos + 1;
    let params = [];
    if kind_is(tokens, pos, "RParen") == false {
        while true {
            let pn = peek(tokens, pos);
            pos = pos + 1;
            let pty = "";
            if kind_is(tokens, pos, "Colon") {
                let tn = parse_type(tokens, pos + 1);
                if tn["ok"] == false { return tn; }
                pty = tn["ty"];
                pos = tn["pos"];
            }
            push(params, {"name": pn["text"], "ty": pty});
            if kind_is(tokens, pos, "Comma") { pos = pos + 1; } else { break; }
        }
    }
    if kind_is(tokens, pos, "RParen") == false { return perr("expected )", pos); }
    pos = pos + 1;
    let ret = "";
    if kind_is(tokens, pos, "Minus") {
        pos = pos + 1;
        if kind_is(tokens, pos, "Gt") == false { return perr("expected >", pos); }
        let tn = parse_type(tokens, pos + 1);
        if tn["ok"] == false { return tn; }
        ret = tn["ty"];
        pos = tn["pos"];
    }
    let requires = [];
    let ensures = [];
    let effects = [];
    while text_is(tokens, pos, "requires") || text_is(tokens, pos, "ensures") || text_is(tokens, pos, "uses") {
        let which = peek(tokens, pos)["text"];
        pos = pos + 1;
        if kind_is(tokens, pos, "LParen") == false { return perr("expected (", pos); }
        pos = pos + 1;
        if which == "uses" {
            if kind_is(tokens, pos, "RParen") == false {
                while true {
                    let et = peek(tokens, pos);
                    pos = pos + 1;
                    let en = et["text"];
                    while kind_is(tokens, pos, "Dot") {
                        pos = pos + 1;
                        let more = peek(tokens, pos);
                        pos = pos + 1;
                        en = en + "." + more["text"];
                    }
                    push(effects, en);
                    if kind_is(tokens, pos, "Comma") { pos = pos + 1; } else { break; }
                }
            }
        } else {
            let e = parse_expr(tokens, pos, 0);
            if e["ok"] == false { return e; }
            if which == "requires" { push(requires, e["node"]); } else { push(ensures, e["node"]); }
            pos = e["pos"];
        }
        if kind_is(tokens, pos, "RParen") == false { return perr("expected )", pos); }
        pos = pos + 1;
    }
    let body = parse_block(tokens, pos);
    if body["ok"] == false { return body; }
    return pok({
        "kind": "Fn",
        "name": name_t["text"],
        "pub": is_pub,
        "params": params,
        "ret": ret,
        "requires": requires,
        "ensures": ensures,
        "effects": effects,
        "body": body["stmts"]
    }, body["pos"]);
}

fn sh_parse(src) {
    let tokens = sh_lex(src);
    let pos = 0;
    let items = [];
    while at_end(tokens, pos) == false {
        let f = parse_fn(tokens, pos);
        if text_is(tokens, pos, "enum") {
            f = parse_enum(tokens, pos);
        }
        if f["ok"] == false {
            let t = peek(tokens, f["pos"]);
            return {"ok": false, "err": f["err"] + " at pos " + ("" + f["pos"]) + " tok " + t["kind"] + ":" + t["text"] + " @" + ("" + t["start"])};
        }
        push(items, f["node"]);
        pos = f["pos"];
    }
    return {"ok": true, "ast": {"kind": "Program", "items": items}};
}

// Emit a list of parameter-name strings as a JSON string array (for a Lambda node's params).
fn jparams(ps) {
    let out = "[";
    let i = 0;
    while i < len(ps) {
        if i > 0 { out = out + ","; }
        out = out + q(ps[i]);
        i = i + 1;
    }
    return out + "]";
}

fn jexpr(e) {
    return match e {
        Expr::None => "null",
        Expr::Int(v) => "{\"kind\":\"Int\",\"value\":" + q(v) + "}",
        Expr::Str(v) => "{\"kind\":\"Str\",\"value\":" + q(v) + "}",
        Expr::Bool(v) => "{\"kind\":\"Bool\",\"value\":" + jbool(v) + "}",
        Expr::Var(nm) => "{\"kind\":\"Var\",\"name\":" + q(nm) + "}",
        Expr::Call { callee: cn, args: a } => jcall(cn, a),
        Expr::Binary { op: o, lhs: l, rhs: r } => "{\"kind\":\"Binary\",\"op\":" + q(o) + ",\"lhs\":" + jexpr(l) + ",\"rhs\":" + jexpr(r) + "}",
        Expr::Unary { op: o, expr: x } => "{\"kind\":\"Unary\",\"op\":" + q(o) + ",\"expr\":" + jexpr(x) + "}",
        Expr::Index { base: b, index: ix } => "{\"kind\":\"Index\",\"base\":" + jexpr(b) + ",\"index\":" + jexpr(ix) + "}",
        Expr::List { elements: els } => jlist(els),
        Expr::Range { start: s, end: en } => "{\"kind\":\"Range\",\"start\":" + jexpr(s) + ",\"end\":" + jexpr(en) + "}",
        Expr::Map { keys: k, vals: vs } => jmap(k, vs),
        Expr::EnumInit { ty: ty, variant: vr, shape: sh, tuple: tp, fnames: fnm, fexprs: fx } => jenuminit(ty, vr, sh, tp, fnm, fx),
        Expr::IfExpr { cond: c, then_: t, else_: el } => "{\"kind\":\"IfExpr\",\"cond\":" + jexpr(c) + ",\"then\":" + jstmts(t) + ",\"else\":" + jstmts(el) + "}",
        Expr::Match { scrut: sc, arms: ar } => jmatch(sc, ar),
        Expr::Lambda { params: ps, body: b } => "{\"kind\":\"Lambda\",\"params\":" + jparams(ps) + ",\"body\":" + jexpr(b) + "}",
        Expr::MethodCall { recv: r, method: m, args: a } => "{\"kind\":\"MethodCall\",\"recv\":" + jexpr(r) + ",\"method\":" + q(m) + ",\"args\":" + jlist(a) + "}",
        Expr::FieldAccess { base: b, field: f } => "{\"kind\":\"FieldAccess\",\"base\":" + jexpr(b) + ",\"field\":" + q(f) + "}",
        _ => "{\"kind\":\"UnsupportedExpr\"}",
    };
}

fn jcall(cn, a) {
    let out = "{\"kind\":\"Call\",\"callee\":" + q(cn) + ",\"args\":[";
    let i = 0;
    while i < len(a) {
        if i > 0 { out = out + ","; }
        out = out + jexpr(a[i]);
        i = i + 1;
    }
    return out + "]}";
}

fn jlist(els) {
    let out = "{\"kind\":\"List\",\"elements\":[";
    let i = 0;
    while i < len(els) {
        if i > 0 { out = out + ","; }
        out = out + jexpr(els[i]);
        i = i + 1;
    }
    return out + "]}";
}

fn jmap(keys, vals) {
    let out = "{\"kind\":\"Map\",\"keys\":[";
    let i = 0;
    while i < len(keys) {
        if i > 0 { out = out + ","; }
        out = out + q(keys[i]);
        i = i + 1;
    }
    out = out + "],\"vals\":[";
    i = 0;
    while i < len(vals) {
        if i > 0 { out = out + ","; }
        out = out + jexpr(vals[i]);
        i = i + 1;
    }
    return out + "]}";
}

fn jenuminit(ty, vr, sh, tp, fnames, fx) {
    let out = "{\"kind\":\"EnumInit\",\"ty\":" + q(ty) + ",\"variant\":" + q(vr) + ",\"shape\":" + q(sh);
    if sh == "tuple" {
        out = out + ",\"tuple\":[";
        let i = 0;
        while i < len(tp) { if i > 0 { out = out + ","; } out = out + jexpr(tp[i]); i = i + 1; }
        out = out + "]";
    }
    if sh == "struct" {
        out = out + ",\"fnames\":[";
        let i = 0;
        while i < len(fnames) { if i > 0 { out = out + ","; } out = out + q(fnames[i]); i = i + 1; }
        out = out + "],\"fexprs\":[";
        i = 0;
        while i < len(fx) { if i > 0 { out = out + ","; } out = out + jexpr(fx[i]); i = i + 1; }
        out = out + "]";
    }
    return out + "}";
}

fn jmatch(sc, arms) {
    let out = "{\"kind\":\"Match\",\"scrut\":" + jexpr(sc) + ",\"arms\":[";
    let i = 0;
    while i < len(arms) {
        if i > 0 { out = out + ","; }
        out = out + "{\"pat\":" + jpat(arms[i]["pat"]) + ",\"body\":" + jexpr(arms[i]["body"]) + "}";
        i = i + 1;
    }
    return out + "]}";
}

fn jpat(p) {
    if p["pk"] == "wild" { return "{\"pk\":\"wild\"}"; }
    let out = "{\"pk\":\"enum\",\"variant\":" + q(p["variant"]) + ",\"shape\":" + q(p["shape"]);
    if p["shape"] == "tuple" {
        out = out + ",\"binds\":[";
        let binds = p["binds"];
        let i = 0;
        while i < len(binds) {
            if i > 0 { out = out + ","; }
            out = out + q(binds[i]);
            i = i + 1;
        }
        out = out + "]";
    }
    if p["shape"] == "struct" {
        out = out + ",\"fnames\":[";
        let fnames = p["fnames"];
        let i = 0;
        while i < len(fnames) {
            if i > 0 { out = out + ","; }
            out = out + q(fnames[i]);
            i = i + 1;
        }
        out = out + "],\"binds\":[";
        let binds = p["binds"];
        i = 0;
        while i < len(binds) {
            if i > 0 { out = out + ","; }
            out = out + q(binds[i]);
            i = i + 1;
        }
        out = out + "]";
    }
    return out + "}";
}

fn jenum(it) {
    let out = "{\"kind\":\"Enum\",\"name\":" + q(it["name"]) + ",\"variants\":[";
    let vs = it["variants"];
    let i = 0;
    while i < len(vs) {
        if i > 0 { out = out + ","; }
        out = out + "{\"name\":" + q(vs[i]["name"]) + ",\"shape\":" + q(vs[i]["shape"]) + "}";
        i = i + 1;
    }
    return out + "]}";
}

fn jitem(it) {
    if it["kind"] == "Enum" { return jenum(it); }
    return jfn(it);
}

fn jstmts(ss) {
    let out = "[";
    let i = 0;
    while i < len(ss) {
        if i > 0 { out = out + ","; }
        out = out + jstmt(ss[i]);
        i = i + 1;
    }
    return out + "]";
}

fn jstmt(s) {
    return match s {
        Stmt::Let { name: nm, ty: t, init: ini } =>
            "{\"kind\":\"Let\",\"name\":" + q(nm) + ",\"ty\":" + (if t != "" { q(t) } else { "null" }) + ",\"init\":" + jexpr(ini) + "}",
        Stmt::Assign { target: tg, value: v } =>
            "{\"kind\":\"Assign\",\"target\":" + jexpr(tg) + ",\"value\":" + jexpr(v) + "}",
        Stmt::Return { value: v } =>
            "{\"kind\":\"Return\",\"value\":" + jexpr(v) + "}",
        Stmt::ExprStmt { expr: e } =>
            "{\"kind\":\"ExprStmt\",\"expr\":" + jexpr(e) + "}",
        Stmt::If { cond: c, then_: t, else_: e, has_else: he } =>
            "{\"kind\":\"If\",\"cond\":" + jexpr(c) + ",\"then\":" + jstmts(t) + ",\"else\":" + (if he { jstmts(e) } else { "null" }) + "}",
        Stmt::While { cond: c, body: b } =>
            "{\"kind\":\"While\",\"cond\":" + jexpr(c) + ",\"body\":" + jstmts(b) + "}",
        Stmt::For { var: vr, iter: it, body: b } =>
            "{\"kind\":\"For\",\"var\":" + q(vr) + ",\"iter\":" + jexpr(it) + ",\"body\":" + jstmts(b) + "}",
        _ => "{\"kind\":\"UnsupportedStmt\"}",
    };
}

fn jfn(f) {
    let out = "{\"kind\":\"Fn\",\"name\":" + q(f["name"]) + ",\"pub\":" + jbool(f["pub"]) + ",\"params\":[";
    let ps = f["params"];
    let i = 0;
    while i < len(ps) {
        if i > 0 { out = out + ","; }
        let tyj = "null";
        if ps[i]["ty"] != "" { tyj = q(ps[i]["ty"]); }
        out = out + "{\"name\":" + q(ps[i]["name"]) + ",\"ty\":" + tyj + "}";
        i = i + 1;
    }
    out = out + "],\"ret\":";
    if f["ret"] == "" { out = out + "null"; }
    else { out = out + q(f["ret"]); }
    out = out + ",\"requires\":[";
    i = 0;
    while i < len(f["requires"]) {
        if i > 0 { out = out + ","; }
        out = out + jexpr(f["requires"][i]);
        i = i + 1;
    }
    out = out + "],\"ensures\":[";
    i = 0;
    while i < len(f["ensures"]) {
        if i > 0 { out = out + ","; }
        out = out + jexpr(f["ensures"][i]);
        i = i + 1;
    }
    out = out + "],\"effects\":[";
    i = 0;
    while i < len(f["effects"]) {
        if i > 0 { out = out + ","; }
        out = out + q(f["effects"][i]);
        i = i + 1;
    }
    out = out + "],\"body\":" + jstmts(f["body"]) + "}";
    return out;
}

fn jast(ast) {
    let out = "{\"kind\":\"Program\",\"items\":[";
    let items = ast["items"];
    let i = 0;
    while i < len(items) {
        if i > 0 { out = out + ","; }
        out = out + jitem(items[i]);
        i = i + 1;
    }
    return out + "]}";
}


fn is_builtin(name) {
    return name == "print" || name == "println" || name == "len" || name == "push" || name == "char_at" || name == "ord" || name == "chr" || name == "substr" || name == "index_of" || name == "split" || name == "read_file" || name == "write_file" || name == "args" || name == "env" || name == "declassify" || name == "append_file" || name == "exit" || name == "get" || name == "has_key" || name == "keys" || name == "values" || name == "break" || name == "continue";
}

fn check_expr(e, env, fns, diags) {
    return match e {
        Expr::None => diags,
        Expr::Int(v) => diags,
        Expr::Str(v) => diags,
        Expr::Bool(v) => diags,
        Expr::Var(nm) => check_var(nm, env, fns, diags),
        Expr::Call { callee: cn, args: a } => check_call(cn, a, env, fns, diags),
        Expr::Binary { op: o, lhs: l, rhs: r } => check_expr(r, env, fns, check_expr(l, env, fns, diags)),
        Expr::Unary { op: o, expr: x } => check_expr(x, env, fns, diags),
        Expr::Index { base: b, index: ix } => check_expr(ix, env, fns, check_expr(b, env, fns, diags)),
        Expr::List { elements: els } => check_exprs(els, env, fns, diags),
        Expr::Range { start: s, end: en } => check_expr(en, env, fns, check_expr(s, env, fns, diags)),
        Expr::Map { keys: k, vals: vs } => check_exprs(vs, env, fns, diags),
        Expr::EnumInit { ty: ty, variant: vr, shape: sh, tuple: tp, fnames: fnm, fexprs: fx } => check_exprs(fx, env, fns, check_exprs(tp, env, fns, diags)),
        Expr::IfExpr { cond: c, then_: t, else_: el } => check_stmts(el, env, fns, check_stmts(t, env, fns, check_expr(c, env, fns, diags))),
        Expr::Match { scrut: sc, arms: ar } => check_match_arms(ar, env, fns, check_expr(sc, env, fns, diags)),
        Expr::Lambda { params: ps, body: b } => check_lambda(ps, b, env, fns, diags),
        Expr::MethodCall { recv: r, method: m, args: a } => check_exprs(a, env, fns, check_expr(r, env, fns, diags)),
        Expr::FieldAccess { base: b, field: f } => check_expr(b, env, fns, diags),
        _ => diags,
    };
}

// A lambda binds its params into a FRESH copy of the scope (maps are by-value) and checks its body;
// param binds do not leak out.
fn check_lambda(ps, b, env, fns, diags) {
    let i = 0;
    while i < len(ps) {
        env[ps[i]] = "";
        i = i + 1;
    }
    return check_expr(b, env, fns, diags);
}

fn check_exprs(es, env, fns, diags) {
    let i = 0;
    while i < len(es) {
        diags = check_expr(es[i], env, fns, diags);
        i = i + 1;
    }
    return diags;
}

fn check_var(nm, env, fns, diags) {
    if get(env, nm, false) == false && is_builtin(nm) == false && has_key(fns, nm) == false {
        push(diags, "ANUBIS_SH_UNKNOWN_IDENT: " + nm);
    }
    return diags;
}

fn check_call(cn, a, env, fns, diags) {
    diags = check_exprs(a, env, fns, diags);
    if is_builtin(cn) { return diags; }
    if has_key(fns, cn) == false {
        push(diags, "ANUBIS_SH_UNKNOWN_IDENT: " + cn);
        return diags;
    }
    let rec = fns[cn];
    let arity = rec["arity"];
    if len(a) != arity {
        push(diags, "ANUBIS_SH_ARITY: " + cn + " expected " + ("" + arity) + " got " + ("" + len(a)));
    } else {
        // slice-2: argument-position type check (mirrors mod.rs:5407-5418), only when arity matches.
        // An arg whose inferred type is not assignable to the callee's declared param type is a mismatch.
        // sh_infer_type is a strict under-approximation (Call/Index/… => "" => skipped) so SH ⊆ Rust.
        let ptys = rec["ptys"];
        let i = 0;
        while i < len(a) {
            let got = sh_infer_type(a[i], env);
            if got != "" {
                if ty_assignable(ptys[i], got) == false {
                    push(diags, "ANUBIS_TYPE_MISMATCH: type mismatch: argument " + ("" + i) + " of `" + cn + "` expects `" + ptys[i] + "`, got `" + got + "`");
                }
            }
            i = i + 1;
        }
    }
    return diags;
}

fn check_match_arms(arms, env, fns, diags) {
    let i = 0;
    while i < len(arms) {
        env = bind_pattern(arms[i]["pat"], env);
        diags = check_expr(arms[i]["body"], env, fns, diags);
        i = i + 1;
    }
    return diags;
}

fn bind_pattern(p, env) {
    if p["pk"] == "enum" {
        if p["shape"] == "tuple" {
            let binds = p["binds"];
            let i = 0;
            while i < len(binds) {
                if binds[i] != "_" { env[binds[i]] = ""; }
                i = i + 1;
            }
        }
        if p["shape"] == "struct" {
            let binds = p["binds"];
            let i = 0;
            while i < len(binds) {
                if binds[i] != "_" { env[binds[i]] = ""; }
                i = i + 1;
            }
        }
    }
    return env;
}

// `env` is threaded (returned) because Anubis passes maps by value: a helper that
// binds a name must hand the updated env back so later statements see it. check_stmt
// returns [env, diags]; check_stmts re-threads both. Nested blocks (if/while/for body)
// receive env by value, so their inner binds do not leak up — only the loop var and
// top-level `let` bindings persist, matching the original inline checker.
fn check_stmts(ss, env, fns, diags) {
    let i = 0;
    while i < len(ss) {
        let r = check_stmt(ss[i], env, fns, diags);
        env = r[0];
        diags = r[1];
        i = i + 1;
    }
    return diags;
}

fn check_stmt(s, env, fns, diags) {
    return match s {
        Stmt::Let { name: nm, ty: t, init: ini } => check_let(nm, t, ini, env, fns, diags),
        Stmt::Assign { target: tg, value: v } => [env, check_expr(v, env, fns, check_expr(tg, env, fns, diags))],
        Stmt::Return { value: v } => [env, check_expr(v, env, fns, diags)],
        Stmt::ExprStmt { expr: e } => [env, check_expr(e, env, fns, diags)],
        Stmt::If { cond: c, then_: t, else_: e, has_else: he } => check_if(c, t, e, he, env, fns, diags),
        Stmt::While { cond: c, body: b } => [env, check_stmts(b, env, fns, check_expr(c, env, fns, diags))],
        Stmt::For { var: vr, iter: it, body: b } => check_for(vr, it, b, env, fns, diags),
        _ => [env, diags],
    };
}

fn is_bool_expr(e) {
    return match e {
        Expr::Bool(v) => true,
        _ => false,
    };
}

// Phase-4 TYPE-engine slice 1: port of mod.rs let-binding ANUBIS_TYPE_MISMATCH (:3450). Generalizes the
// former 4-hardcoded bool-vs-int checks to the full ty_assignable relation over sh_infer_type. Binds
// env[nm] to the DECLARED type (or the inferred init type when unannotated), mirroring Rust's
// scope[nm].ty = ty.or(infer_expr_type_scoped) (:3505). sh_infer_type is a strict UNDER-approximation of
// Rust's inferer (Call/Index/FieldAccess/IfExpr/Match/Cast => "" = accept), so a "" got NEVER emits and
// SH ⊆ Rust holds by construction (no spurious mismatch).
fn check_let(nm, t, ini, env, fns, diags) {
    diags = check_expr(ini, env, fns, diags);
    let got = sh_infer_type(ini, env);
    if t != "" {
        if got != "" {
            if ty_assignable(t, got) == false {
                push(diags, "ANUBIS_TYPE_MISMATCH: type mismatch: expected `" + t + "`, got `" + got + "`");
            }
        }
        env[nm] = t;
    } else {
        env[nm] = got;
    }
    return [env, diags];
}

fn check_if(c, t, e, he, env, fns, diags) {
    diags = check_expr(c, env, fns, diags);
    diags = check_stmts(t, env, fns, diags);
    if he { diags = check_stmts(e, env, fns, diags); }
    return [env, diags];
}

fn check_for(vr, it, b, env, fns, diags) {
    diags = check_expr(it, env, fns, diags);
    env[vr] = "";
    diags = check_stmts(b, env, fns, diags);
    return [env, diags];
}

// ===== TYPE ENGINE slice 1 (Anubis-authored port of compiler/src/middle/ty.rs:149-408) =====
// Pure string-in/string-out predicates. "" annotation = dynamically typed => accept.
// NOTE: uses ONLY builtins the self-host EMITTED INTERPRETER supports (char_at/chr/ord/substr/index_of/
// len/get) — NOT lower/trim/starts_with/ends_with, which are host-run.rs builtins the bootstrap
// interpreter does not implement (they would panic "unknown function" in stage1). Case-folding is
// hand-rolled (sh_lower); type annotations are single tokens so trim is a no-op and dropped.

// ASCII lowercase, hand-rolled (the emitted interpreter has no `lower`). A-Z (ord 65-90) -> +32.
fn sh_lower(s) {
    let out = "";
    let i = 0;
    while i < len(s) {
        let c = char_at(s, i);
        let o = ord(c);
        if o >= 65 && o <= 90 { out = out + chr(o + 32); } else { out = out + c; }
        i = i + 1;
    }
    return out;
}

fn ty_norm(t) {
    let s = sh_lower(t);
    if s == "int" || s == "i8" || s == "i16" || s == "i32" || s == "i64" || s == "i128" || s == "u128" || s == "usize" || s == "isize" || s == "number" { return "u32"; }
    if s == "u8" || s == "u16" || s == "u32" || s == "u64" { return s; }
    if s == "str" || s == "string" { return "string"; }
    if s == "bool" || s == "boolean" { return "bool"; }
    if s == "list" || s == "array" || s == "vec" { return "list"; }
    if s == "map" || s == "dict" || s == "dictionary" { return "map"; }
    return s;
}

fn ty_is_numeric(t) {
    let s = ty_norm(t);
    return s == "u8" || s == "u16" || s == "u32" || s == "u64" || s == "f32" || s == "f64" || s == "float";
}

// Strip a tainted<T>/secret<T> qualifier to base T (ty.rs strip_flow_qualifier). In the SH subset a
// type annotation is a SINGLE token (parse_type reads one bare token), so `tainted<u32>` can never be an
// SH annotation — the `<` splits it and the file PARSE_ERRORs. The peel is therefore INAPPLICABLE over
// the SH-parseable corpus, so this collapses to identity (and avoids starts_with/ends_with, which the
// self-host bootstrap interpreter does not implement).
fn ty_strip_flow(t) {
    return t;
}

fn ty_is_integer(t) {
    let s = ty_norm(ty_strip_flow(t));
    return s == "u8" || s == "u16" || s == "u32" || s == "u64";
}

fn ty_is_float(t) {
    let s = ty_norm(ty_strip_flow(t));
    return s == "f32" || s == "f64" || s == "float";
}

// generic param (<=2 all-uppercase chars, e.g. `T`) OR generic instantiation (contains '<'). Runtime-erased.
fn ty_is_generic(t) {
    let s = t;
    if index_of(s, "<") >= 0 { return true; }
    if len(s) == 0 { return false; }
    if len(s) > 2 { return false; }
    let i = 0;
    while i < len(s) {
        let c = ord(char_at(s, i));
        if c < 65 || c > 90 { return false; }
        i = i + 1;
    }
    return true;
}

// tainted<T> inner (ty.rs tainted_inner). Inapplicable in the SH subset (annotations are single tokens,
// no `<`), so always "" — avoids lower/starts_with/ends_with (unsupported by the bootstrap interpreter).
fn ty_tainted_inner(t) {
    return "";
}

// ty.rs compatible(): symmetric numeric interop; bool/string/enum do not cross. Recurses only through the
// shallow tainted<> peel (inert in SH).
fn ty_compatible(expected, actual) {
    let e_raw = expected;
    let a_raw = actual;
    if e_raw == "" || a_raw == "" { return true; }
    if ty_is_generic(e_raw) || ty_is_generic(a_raw) { return true; }
    let e = ty_norm(e_raw);
    let a = ty_norm(a_raw);
    if e == a || e_raw == a_raw { return true; }
    if e == "any" || a == "any" || e == "unknown" || a == "unknown" { return true; }
    if (index_of(e_raw, "*") >= 0 || index_of(e, "rawptr") >= 0) && (index_of(a_raw, "*") >= 0 || index_of(a, "rawptr") >= 0) { return true; }
    let ti_e = ty_tainted_inner(e_raw);
    if ti_e != "" { if ty_compatible(ti_e, a_raw) { return true; } }
    let ti_a = ty_tainted_inner(a_raw);
    if ti_a != "" { if ty_compatible(e_raw, ti_a) { return true; } }
    if ty_is_numeric(e) && ty_is_numeric(a) { return true; }
    return false;
}

// ty.rs assignable(): compatible + the one asymmetric rule — a float value must not narrow into an
// integer annotation.
fn ty_assignable(expected, actual) {
    if ty_compatible(expected, actual) == false { return false; }
    if ty_is_integer(expected) && ty_is_float(actual) { return false; }
    return true;
}

// Flat inference (ports mod.rs infer_expr_type_scoped:11743, SH subset). Returns a raw annotation
// string; "" = unknown => accept. No float-literal arm (SH cannot lex `1.5`). This is a strict
// UNDER-approximation of Rust's inferer, so SH ⊆ Rust holds by construction (no spurious mismatch).
fn sh_infer_type(e, env) {
    return match e {
        Expr::Int(v) => "u32",
        Expr::Str(v) => "string",
        Expr::Bool(v) => "bool",
        Expr::Var(nm) => get(env, nm, ""),
        Expr::Unary { op: o, expr: x } => sh_infer_unary(o, x, env),
        Expr::Binary { op: o, lhs: l, rhs: r } => sh_infer_binary(o, l, r, env),
        Expr::List { elements: xs } => "list",
        Expr::Map { keys: k, vals: v } => "map",
        Expr::EnumInit { ty: n, variant: vr, shape: sh, tuple: tp, fnames: fnm, fexprs: fx } => n,
        // Omitted vs Rust: IfExpr/Match (value_branch_type), Index/Call/FieldAccess (None in Rust too),
        // Cast (no SH Cast variant). All => "" (accept) — a tolerated INCOMPLETE residual (slice-2 cand.).
        _ => "",
    };
}

fn sh_infer_unary(o, x, env) {
    if o == "!" { return "bool"; }
    if o == "~" { return "u32"; }
    return sh_infer_type(x, env);
}

fn sh_infer_binary(o, l, r, env) {
    if o == "==" || o == "!=" || o == "<" || o == "<=" || o == ">" || o == ">=" || o == "&&" || o == "||" { return "bool"; }
    if o == "+" {
        // Rust maps BOTH operands through normalize_ty here; the lt.or(rt) fallback is NORMALIZED.
        let lt = ty_norm(sh_infer_type(l, env));
        let rt = ty_norm(sh_infer_type(r, env));
        if lt == "string" || rt == "string" { return "string"; }
        if lt == "list" || rt == "list" { return "list"; }
        if ty_is_float(lt) || ty_is_float(rt) { return "f64"; }
        if lt != "" { return lt; }
        return rt;
    }
    if o == "&" || o == "|" || o == "^" || o == "<<" || o == ">>" { return "u32"; }
    // arithmetic (- * / %): f64 if either operand float, else propagate lt.or(rt) RAW.
    let lt2 = sh_infer_type(l, env);
    let rt2 = sh_infer_type(r, env);
    if ty_is_float(lt2) || ty_is_float(rt2) { return "f64"; }
    if lt2 != "" { return lt2; }
    return rt2;
}

// ===== TAINT ENGINE slice 1 (Anubis-authored) — intraprocedural source→sink information flow =====
// Ports the DIRECT case of mod.rs expr_taint_source_m (:13200) + the sink gate (:5493-5518): a value from
// an I/O taint source (input/read_file/…) reaching a sink (send/shell/write_file/print/…) without a
// declassify wrapper is flagged with the byte-identical ANUBIS_TAINTED_SINK_WITHOUT_DECLASSIFY. Scope is a
// dedicated map name->taint-source-label ("" / absent = clean). Params are clean (tainted<T>/secret<T>
// qualifiers are inexpressible in the SH parser — the `<` splits the annotation). Uses ONLY the
// emitted-interpreter builtins (get/push/len/== /|| /+). SH ⊆ Rust BY CONSTRUCTION: a general
// (non-io-source) call — including declassify() and taint_source() — and every composite
// (List/Map/EnumInit) + interprocedural-summary + closure path yields "" (deferred), so SH only ever
// UNDER-reports vs Rust, never a spurious reject. Slice-2 = the two interprocedural fixpoints
// (compute_tainting_fns + compute_param_return_taint) + composite + declassify-wellformed precision.

fn sh_is_egress_sink(n) {
    return n == "send" || n == "network_send" || n == "connect" || n == "http_get" || n == "http_post" || n == "shell" || n == "exec" || n == "system" || n == "target_run" || n == "print" || n == "println" || n == "eprint" || n == "eprintln";
}
fn sh_is_sink(n) {
    if sh_is_egress_sink(n) { return true; }
    return n == "sink" || n == "write" || n == "write_file" || n == "append_file" || n == "memcpy" || n == "sql";
}
fn sh_is_io_taint_source(n) {
    return n == "read_file" || n == "open" || n == "input" || n == "read_line" || n == "recv" || n == "net_recv" || n == "env" || n == "getenv";
}

fn tnt_or(a, b) { if a != "" { return a; } return b; }
fn tnt_io_src(cn) { if sh_is_io_taint_source(cn) { return "io source `" + cn + "`"; } return ""; }
// The taint label of a CALL result: an io source directly, OR (interproc return-propagation) the label
// of a tainted arg passed at a RETURN position of `cn` — so `fwd(input())` where `fn fwd(x){return x}`
// carries input()'s taint out of the call. Reads the `$R$fn$pos` flags seeded into `scope`.
fn tnt_call_src(cn, a, scope) {
    let s = tnt_io_src(cn);
    if s != "" { return s; }
    let i = 0;
    while i < len(a) {
        if get(scope, "$R$" + cn + "$" + ("" + i), false) {
            let asrc = tnt_source(a[i], scope);
            if asrc != "" { return asrc; }
        }
        i = i + 1;
    }
    return "";
}

// The taint-source LABEL of an expr (mirrors expr_taint_source_m Var/Binary/Unary/Index/FieldAccess/
// io-source-Call arms), or "" if clean. Composite (List/Map/EnumInit), general-call, closure, and
// declassify/taint_source arms => "" (deferred, SH-under-reports-safe).
fn tnt_source(e, scope) {
    return match e {
        Expr::Var(nm) => get(scope, nm, ""),
        Expr::Binary { op: o, lhs: l, rhs: r } => tnt_or(tnt_source(l, scope), tnt_source(r, scope)),
        Expr::Unary { op: o, expr: x } => tnt_source(x, scope),
        Expr::Index { base: b, index: ix } => tnt_or(tnt_source(b, scope), tnt_source(ix, scope)),
        Expr::FieldAccess { base: b, field: f } => tnt_source(b, scope),
        Expr::Call { callee: cn, args: a } => tnt_call_src(cn, a, scope),
        _ => "",
    };
}

fn taint_walk_exprs(es, scope, diags) {
    let i = 0;
    while i < len(es) {
        diags = taint_walk_expr(es[i], scope, diags);
        i = i + 1;
    }
    return diags;
}

// Sink-finding walker: recurse everywhere; at a sink call, flag each tainted arg. Threads diags only
// (scope is read-only here — mutation happens in the stmt walker's let/assign).
fn taint_walk_expr(e, scope, diags) {
    return match e {
        Expr::Call { callee: cn, args: a } => taint_walk_call(cn, a, scope, diags),
        Expr::Binary { op: o, lhs: l, rhs: r } => taint_walk_expr(r, scope, taint_walk_expr(l, scope, diags)),
        Expr::Unary { op: o, expr: x } => taint_walk_expr(x, scope, diags),
        Expr::Index { base: b, index: ix } => taint_walk_expr(ix, scope, taint_walk_expr(b, scope, diags)),
        Expr::List { elements: els } => taint_walk_exprs(els, scope, diags),
        Expr::Range { start: s, end: en } => taint_walk_expr(en, scope, taint_walk_expr(s, scope, diags)),
        Expr::Map { keys: k, vals: vs } => taint_walk_exprs(vs, scope, taint_walk_exprs(k, scope, diags)),
        Expr::EnumInit { ty: ty, variant: vr, shape: sh, tuple: tp, fnames: fnm, fexprs: fx } => taint_walk_exprs(fx, scope, taint_walk_exprs(tp, scope, diags)),
        Expr::IfExpr { cond: c, then_: t, else_: el } => taint_walk_stmts(el, scope, taint_walk_stmts(t, scope, taint_walk_expr(c, scope, diags))),
        Expr::Match { scrut: sc, arms: ar } => taint_walk_match_arms(ar, scope, taint_walk_expr(sc, scope, diags)),
        Expr::MethodCall { recv: r, method: m, args: a } => taint_walk_exprs(a, scope, taint_walk_expr(r, scope, diags)),
        Expr::FieldAccess { base: b, field: f } => taint_walk_expr(b, scope, diags),
        _ => diags,
    };
}

fn taint_walk_match_arms(arms, scope, diags) {
    let i = 0;
    while i < len(arms) {
        diags = taint_walk_expr(arms[i]["body"], scope, diags);
        i = i + 1;
    }
    return diags;
}

fn taint_walk_call(cn, a, scope, diags) {
    // Recurse into args first so a NESTED sink is found (`send(f(shell(input())))` flags the shell).
    diags = taint_walk_exprs(a, scope, diags);
    if sh_is_sink(cn) {
        let i = 0;
        while i < len(a) {
            let src = tnt_source(a[i], scope);
            if src != "" {
                push(diags, "ANUBIS_TAINTED_SINK_WITHOUT_DECLASSIFY: safe mode tainted flow from `" + src + "` to sink `" + cn + "` requires declassify() or research boundary");
            }
            i = i + 1;
        }
    }
    // INTERPROCEDURAL sink (mod.rs:5746): `cn` is a user fn whose param j reaches a sink; a tainted arg
    // at position j is a leak at the call boundary — byte-identical ANUBIS_INTERPROC_SINK.
    let j = 0;
    while j < len(a) {
        if get(scope, "$S$" + cn + "$" + ("" + j), false) {
            let src = tnt_source(a[j], scope);
            if src != "" {
                push(diags, "ANUBIS_INTERPROC_SINK: safe mode tainted flow from `" + src + "` into parameter " + ("" + j) + " of `" + cn + "`, which reaches a sink without declassify");
            }
        }
        j = j + 1;
    }
    return diags;
}

fn taint_walk_stmts(ss, scope, diags) {
    let i = 0;
    while i < len(ss) {
        let r = taint_walk_stmt(ss[i], scope, diags);
        scope = r[0];
        diags = r[1];
        i = i + 1;
    }
    return diags;
}

fn taint_walk_stmt(s, scope, diags) {
    return match s {
        Stmt::Let { name: nm, ty: t, init: iv } => taint_stmt_let(nm, iv, scope, diags),
        Stmt::Assign { target: tg, value: v } => taint_stmt_assign(tg, v, scope, diags),
        Stmt::Return { value: v } => [scope, taint_walk_expr(v, scope, diags)],
        Stmt::ExprStmt { expr: e } => [scope, taint_walk_expr(e, scope, diags)],
        Stmt::If { cond: c, then_: t, else_: e, has_else: he } => taint_stmt_if(c, t, e, he, scope, diags),
        Stmt::While { cond: c, body: b } => [scope, taint_walk_stmts(b, scope, taint_walk_expr(c, scope, diags))],
        Stmt::For { var: vr, iter: it, body: b } => taint_stmt_for(vr, it, b, scope, diags),
        _ => [scope, diags],
    };
}

fn taint_stmt_let(nm, iv, scope, diags) {
    diags = taint_walk_expr(iv, scope, diags);
    scope[nm] = tnt_source(iv, scope);
    return [scope, diags];
}

// A reassignment to a bare Var re-labels it from the RHS — a clean RHS CLEARS the taint (flow-sensitive,
// matching Rust straight-line reassignment). Assign to an index/field leaves scope (deferred).
fn taint_stmt_assign(tg, v, scope, diags) {
    diags = taint_walk_expr(v, scope, taint_walk_expr(tg, scope, diags));
    scope = match tg {
        Expr::Var(nm) => taint_set(scope, nm, tnt_source(v, scope)),
        _ => scope,
    };
    return [scope, diags];
}
fn taint_set(scope, nm, label) { scope[nm] = label; return scope; }

fn taint_stmt_if(c, t, el, he, scope, diags) {
    // Branch bodies receive scope BY VALUE (maps are by-value in Anubis) — a taint minted inside a branch
    // does not leak past the join, giving the conservative "tainted if any path taints" merge for free.
    diags = taint_walk_expr(c, scope, diags);
    diags = taint_walk_stmts(t, scope, diags);
    if he { diags = taint_walk_stmts(el, scope, diags); }
    return [scope, diags];
}

fn taint_stmt_for(vr, it, b, scope, diags) {
    diags = taint_walk_expr(it, scope, diags);
    diags = taint_walk_stmts(b, scope, diags);
    return [scope, diags];
}

// ===== TAINT ENGINE slice 2 (Anubis-authored) — INTERPROCEDURAL summaries =====
// Ports the DIRECT case of Rust's param->sink (compute_param_sinks/body_param_sinks) + param->return
// (compute_param_return_taint/body_param_returns) summaries and the call-site consult (mod.rs:5746 ->
// byte-identical ANUBIS_INTERPROC_SINK). A per-fn FIXPOINT computes, for each fn, which PARAM POSITIONS
// reach a sink and which are returned; both flatten into scope flags ($S$fn$pos / $R$fn$pos) that the
// intraproc walker reads at call sites. CONSERVATIVE (subset of Rust): param-flow through Var/Binary/
// Unary/Index/FieldAccess + simple lets/assigns + transitive calls; closures/containers/method interproc
// stay deferred (SH UNDER-reports vs Rust => SH subset Rust, no spurious). Uses only emitted-interpreter
// builtins (keys/get/has_key/len/push).
fn pmap0() { let m = {}; return m; }
fn pmap_one(k) { let m = {}; m[k] = true; return m; }
fn pmap_union(a, b) {
    let ks = keys(b);
    let i = 0;
    while i < len(ks) { a[ks[i]] = true; i = i + 1; }
    return a;
}
fn pmap_eq(a, b) {
    let ka = keys(a);
    if len(ka) != len(keys(b)) { return false; }
    let i = 0;
    while i < len(ka) { if has_key(b, ka[i]) == false { return false; } i = i + 1; }
    return true;
}

// PARAM POSITIONS whose value flows into `e` (which formals derive e). `sm_ret` = fn->return-positions
// for the transitive `return f(p)` case; `pscope` = local -> param-pos set.
fn sum_pflow(e, pscope, sm_ret) {
    return match e {
        Expr::Var(nm) => get(pscope, nm, pmap0()),
        Expr::Binary { op: o, lhs: l, rhs: r } => pmap_union(sum_pflow(l, pscope, sm_ret), sum_pflow(r, pscope, sm_ret)),
        Expr::Unary { op: o, expr: x } => sum_pflow(x, pscope, sm_ret),
        Expr::Index { base: b, index: ix } => pmap_union(sum_pflow(b, pscope, sm_ret), sum_pflow(ix, pscope, sm_ret)),
        Expr::FieldAccess { base: b, field: f } => sum_pflow(b, pscope, sm_ret),
        Expr::Call { callee: cn, args: a } => sum_call_pflow(cn, a, pscope, sm_ret),
        _ => pmap0(),
    };
}
fn sum_call_pflow(cn, a, pscope, sm_ret) {
    let acc = pmap0();
    if has_key(sm_ret, cn) {
        let rp = sm_ret[cn];
        let i = 0;
        while i < len(a) {
            if has_key(rp, "" + i) { acc = pmap_union(acc, sum_pflow(a[i], pscope, sm_ret)); }
            i = i + 1;
        }
    }
    return acc;
}

// Union the param-flow of every SUNK arg reachable in `e` into `sinkacc` (builtin sinks + transitive
// callee sink-params). Recurses into sub-exprs.
fn sum_exprs_sinks(es, pscope, sm_sink, sm_ret, sinkacc) {
    let i = 0;
    while i < len(es) { sinkacc = sum_expr_sinks(es[i], pscope, sm_sink, sm_ret, sinkacc); i = i + 1; }
    return sinkacc;
}
fn sum_expr_sinks(e, pscope, sm_sink, sm_ret, sinkacc) {
    return match e {
        Expr::Call { callee: cn, args: a } => sum_call_sinks(cn, a, pscope, sm_sink, sm_ret, sinkacc),
        Expr::Binary { op: o, lhs: l, rhs: r } => sum_expr_sinks(r, pscope, sm_sink, sm_ret, sum_expr_sinks(l, pscope, sm_sink, sm_ret, sinkacc)),
        Expr::Unary { op: o, expr: x } => sum_expr_sinks(x, pscope, sm_sink, sm_ret, sinkacc),
        Expr::Index { base: b, index: ix } => sum_expr_sinks(ix, pscope, sm_sink, sm_ret, sum_expr_sinks(b, pscope, sm_sink, sm_ret, sinkacc)),
        Expr::List { elements: els } => sum_exprs_sinks(els, pscope, sm_sink, sm_ret, sinkacc),
        Expr::Range { start: s, end: en } => sum_expr_sinks(en, pscope, sm_sink, sm_ret, sum_expr_sinks(s, pscope, sm_sink, sm_ret, sinkacc)),
        Expr::Map { keys: k, vals: vs } => sum_exprs_sinks(vs, pscope, sm_sink, sm_ret, sum_exprs_sinks(k, pscope, sm_sink, sm_ret, sinkacc)),
        Expr::MethodCall { recv: r, method: m, args: a } => sum_exprs_sinks(a, pscope, sm_sink, sm_ret, sum_expr_sinks(r, pscope, sm_sink, sm_ret, sinkacc)),
        Expr::FieldAccess { base: b, field: f } => sum_expr_sinks(b, pscope, sm_sink, sm_ret, sinkacc),
        _ => sinkacc,
    };
}
fn sum_call_sinks(cn, a, pscope, sm_sink, sm_ret, sinkacc) {
    sinkacc = sum_exprs_sinks(a, pscope, sm_sink, sm_ret, sinkacc);
    if sh_is_sink(cn) {
        let i = 0;
        while i < len(a) { sinkacc = pmap_union(sinkacc, sum_pflow(a[i], pscope, sm_ret)); i = i + 1; }
    } else {
        if has_key(sm_sink, cn) {
            let sp = sm_sink[cn];
            let i = 0;
            while i < len(a) {
                if has_key(sp, "" + i) { sinkacc = pmap_union(sinkacc, sum_pflow(a[i], pscope, sm_ret)); }
                i = i + 1;
            }
        }
    }
    return sinkacc;
}

// Statement walker for the summary: thread [pscope, sinkacc, retacc].
fn sum_walk_stmts(ss, pscope, sm_sink, sm_ret, sinkacc, retacc) {
    let i = 0;
    while i < len(ss) {
        let r = sum_walk_stmt(ss[i], pscope, sm_sink, sm_ret, sinkacc, retacc);
        pscope = r[0]; sinkacc = r[1]; retacc = r[2];
        i = i + 1;
    }
    return [pscope, sinkacc, retacc];
}
fn sum_walk_stmt(s, pscope, sm_sink, sm_ret, sinkacc, retacc) {
    return match s {
        Stmt::Let { name: nm, ty: t, init: iv } => sum_stmt_let(nm, iv, pscope, sm_sink, sm_ret, sinkacc, retacc),
        Stmt::Return { value: v } => sum_stmt_return(v, pscope, sm_sink, sm_ret, sinkacc, retacc),
        Stmt::ExprStmt { expr: e } => [pscope, sum_expr_sinks(e, pscope, sm_sink, sm_ret, sinkacc), retacc],
        Stmt::If { cond: c, then_: t, else_: el, has_else: he } => sum_stmt_if(c, t, el, he, pscope, sm_sink, sm_ret, sinkacc, retacc),
        Stmt::While { cond: c, body: b } => sum_stmt_loop(c, b, pscope, sm_sink, sm_ret, sinkacc, retacc),
        Stmt::For { var: vr, iter: it, body: b } => sum_stmt_loop(it, b, pscope, sm_sink, sm_ret, sinkacc, retacc),
        Stmt::Assign { target: tg, value: v } => sum_stmt_assign(tg, v, pscope, sm_sink, sm_ret, sinkacc, retacc),
        _ => [pscope, sinkacc, retacc],
    };
}
fn sum_set(pscope, nm, val) { pscope[nm] = val; return pscope; }
fn sum_stmt_let(nm, iv, pscope, sm_sink, sm_ret, sinkacc, retacc) {
    sinkacc = sum_expr_sinks(iv, pscope, sm_sink, sm_ret, sinkacc);
    pscope[nm] = sum_pflow(iv, pscope, sm_ret);
    return [pscope, sinkacc, retacc];
}
fn sum_stmt_assign(tg, v, pscope, sm_sink, sm_ret, sinkacc, retacc) {
    sinkacc = sum_expr_sinks(v, pscope, sm_sink, sm_ret, sinkacc);
    pscope = match tg {
        Expr::Var(nm) => sum_set(pscope, nm, sum_pflow(v, pscope, sm_ret)),
        _ => pscope,
    };
    return [pscope, sinkacc, retacc];
}
fn sum_stmt_return(v, pscope, sm_sink, sm_ret, sinkacc, retacc) {
    sinkacc = sum_expr_sinks(v, pscope, sm_sink, sm_ret, sinkacc);
    retacc = pmap_union(retacc, sum_pflow(v, pscope, sm_ret));
    return [pscope, sinkacc, retacc];
}
fn sum_stmt_if(c, t, el, he, pscope, sm_sink, sm_ret, sinkacc, retacc) {
    sinkacc = sum_expr_sinks(c, pscope, sm_sink, sm_ret, sinkacc);
    let rt = sum_walk_stmts(t, pscope, sm_sink, sm_ret, sinkacc, retacc);
    sinkacc = rt[1]; retacc = rt[2];
    if he {
        let re = sum_walk_stmts(el, pscope, sm_sink, sm_ret, sinkacc, retacc);
        sinkacc = re[1]; retacc = re[2];
    }
    return [pscope, sinkacc, retacc];
}
fn sum_stmt_loop(hd, b, pscope, sm_sink, sm_ret, sinkacc, retacc) {
    sinkacc = sum_expr_sinks(hd, pscope, sm_sink, sm_ret, sinkacc);
    let r = sum_walk_stmts(b, pscope, sm_sink, sm_ret, sinkacc, retacc);
    return [pscope, r[1], r[2]];
}
fn sum_seed_params(params) {
    let ps = {};
    let i = 0;
    while i < len(params) { ps[params[i]["name"]] = pmap_one("" + i); i = i + 1; }
    return ps;
}
// Fixpoint over all fns: recompute each fn's [sink-positions, return-positions] until stable (a fn's
// summary grows when a callee's summary grows). Guard bounds the iterations (at most #fns rounds needed).
fn tnt_compute_summaries(items) {
    let sm_sink = {};
    let sm_ret = {};
    let i = 0;
    while i < len(items) {
        if items[i]["kind"] == "Fn" { sm_sink[items[i]["name"]] = pmap0(); sm_ret[items[i]["name"]] = pmap0(); }
        i = i + 1;
    }
    let changed = true;
    let guard = 0;
    while changed && guard < 300 {
        changed = false;
        guard = guard + 1;
        let j = 0;
        while j < len(items) {
            if items[j]["kind"] == "Fn" {
                let f = items[j];
                let nm = f["name"];
                let pscope = sum_seed_params(f["params"]);
                let r = sum_walk_stmts(f["body"], pscope, sm_sink, sm_ret, pmap0(), pmap0());
                let ps2 = r[0];
                let sinkacc = r[1];
                let retacc = r[2];
                let bd = f["body"];
                if len(bd) > 0 {
                    // implicit-tail return (a trailing bare expr is the return value).
                    retacc = match bd[len(bd) - 1] {
                        Stmt::ExprStmt { expr: e } => pmap_union(retacc, sum_pflow(e, ps2, sm_ret)),
                        _ => retacc,
                    };
                }
                if pmap_eq(sinkacc, sm_sink[nm]) == false { sm_sink[nm] = sinkacc; changed = true; }
                if pmap_eq(retacc, sm_ret[nm]) == false { sm_ret[nm] = retacc; changed = true; }
            }
            j = j + 1;
        }
    }
    return [sm_sink, sm_ret];
}
// Flatten the two summary maps into read-only scope FLAGS the intraproc walker consults at call sites:
// `$S$<fn>$<pos>` = param pos reaches a sink; `$R$<fn>$<pos>` = param pos is returned. `$` can't start a
// real var name, so no collision with taint labels.
fn tnt_flatten_flags(sm_sink, sm_ret) {
    let flags = {};
    let fs = keys(sm_sink);
    let i = 0;
    while i < len(fs) {
        let sp = keys(sm_sink[fs[i]]);
        let k = 0;
        while k < len(sp) { flags["$S$" + fs[i] + "$" + sp[k]] = true; k = k + 1; }
        i = i + 1;
    }
    let fr = keys(sm_ret);
    let j = 0;
    while j < len(fr) {
        let rp = keys(sm_ret[fr[j]]);
        let k = 0;
        while k < len(rp) { flags["$R$" + fr[j] + "$" + rp[k]] = true; k = k + 1; }
        j = j + 1;
    }
    return flags;
}

fn taint_check(ast) {
    let diags = [];
    let items = ast["items"];
    // Interprocedural pass: compute param->sink + param->return summaries, then seed each fn's scope with
    // the read-only flags so a call site can see a callee whose param reaches a sink / is returned.
    let sums = tnt_compute_summaries(items);
    let flags = tnt_flatten_flags(sums[0], sums[1]);
    let i = 0;
    while i < len(items) {
        if items[i]["kind"] == "Fn" {
            let scope = flags;
            diags = taint_walk_stmts(items[i]["body"], scope, diags);
        }
        i = i + 1;
    }
    return diags;
}

// ===== TYPE ENGINE slice 2: argument-position + return-position type checks =====
// Ports mod.rs:5407 (arg) + :11703 (return). A CONSTANT return expr (is_constant_expr:11868) is the only
// return form Rust statically type-checks (a variable/call return stays dynamic) — sh_is_constant mirrors
// the SH-expressible SUBSET of that (Int/Str/Bool/List/Map/Binary/Unary; If/Cast deferred → false), so SH
// only ever checks a return Rust also checks (SH ⊆ Rust, no spurious on `return x`).
fn sh_all_constant(es) {
    let i = 0;
    while i < len(es) { if sh_is_constant(es[i]) == false { return false; } i = i + 1; }
    return true;
}
fn sh_is_constant(e) {
    return match e {
        Expr::Int(v) => true,
        Expr::Str(v) => true,
        Expr::Bool(v) => true,
        Expr::List { elements: els } => sh_all_constant(els),
        Expr::Map { keys: k, vals: vs } => sh_all_constant(k) && sh_all_constant(vs),
        Expr::Binary { op: o, lhs: l, rhs: r } => sh_is_constant(l) && sh_is_constant(r),
        Expr::Unary { op: o, expr: x } => sh_is_constant(x),
        _ => false,
    };
}

// One return obligation (mirrors mod.rs check_one_return:11693): a CONSTANT v whose inferred type is not
// assignable to the declared return type `rt` is a return-type lie (byte-identical ANUBIS_RETURN_TYPE_
// MISMATCH). sh_is_constant ⊆ Rust is_constant_expr and sh_infer_type ⊆ Rust infer, so SH ⊆ Rust. The
// scope `penv` is params-only (Rust's pscope) — irrelevant for constants (they contain no Var) but faithful.
fn sh_one_return(v, rt, penv, diags) {
    if sh_is_constant(v) {
        let got = sh_infer_type(v, penv);
        if got != "" {
            if ty_assignable(rt, got) == false {
                push(diags, "ANUBIS_RETURN_TYPE_MISMATCH: function declared `-> " + rt + "` but returns a value of type `" + got + "`");
            }
        }
    }
    return diags;
}

// Return-type pass over a fn body — mirrors mod.rs check_return_types:11670 EXACTLY: only the implicit-
// return TAIL (last stmt when it is a bare expr) and the TOP-LEVEL explicit `return X;` statements are
// checked. Returns nested inside if/while/for bodies are left dynamic (Rust does not recurse), so the SH
// return check does not either — a nested constant return-mismatch would otherwise be spurious vs Rust.
fn sh_return_types(body, rt, penv, diags) {
    if rt == "" { return diags; }
    if len(body) > 0 {
        let last = body[len(body) - 1];
        // A trailing bare expression is the implicit return value (Anubis fns yield their last expr).
        diags = match last {
            Stmt::ExprStmt { expr: e } => sh_one_return(e, rt, penv, diags),
            _ => diags,
        };
    }
    let i = 0;
    while i < len(body) {
        diags = match body[i] {
            Stmt::Return { value: v } => sh_one_return(v, rt, penv, diags),
            _ => diags,
        };
        i = i + 1;
    }
    return diags;
}

fn sh_check(ast) {
    let diags = [];
    let fns = {};
    let items = ast["items"];
    let i = 0;
    while i < len(items) {
        if items[i]["kind"] == "Fn" {
            // slice-2: the fns table now carries a {arity, ptys, ret} RECORD (was a bare arity int) so the
            // call-site argument-type check and the return-type check can read the declared signature.
            let ff = items[i];
            let ptys = [];
            let k = 0;
            while k < len(ff["params"]) { push(ptys, ff["params"][k]["ty"]); k = k + 1; }
            fns[ff["name"]] = {"arity": len(ff["params"]), "ptys": ptys, "ret": ff["ret"]};
        }
        i = i + 1;
    }
    i = 0;
    while i < len(items) {
        let f = items[i];
        if f["kind"] == "Fn" {
            let env = {};
            let j = 0;
            while j < len(f["params"]) {
                // Seed each param with its DECLARED type (or "" if unannotated), mirroring Rust's
                // scope[param].ty. This is the type env sh_infer_type reads for Expr::Var (arg-position check).
                env[f["params"][j]["name"]] = f["params"][j]["ty"];
                j = j + 1;
            }
            // slice-2: the return-type check runs over a PARAMS-ONLY env (Rust's pscope) — clone `env`
            // BEFORE the body walk so it carries no let-binding types (faithful to check_return_types).
            let penv = {};
            let pj = 0;
            while pj < len(f["params"]) { penv[f["params"][pj]["name"]] = f["params"][pj]["ty"]; pj = pj + 1; }
            diags = check_stmts(f["body"], env, fns, diags);
            diags = sh_return_types(f["body"], f["ret"], penv, diags);
        }
        i = i + 1;
    }
    return diags;
}

// ── Phase-4 slice 1: Anubis-authored effect inference ────────────────────────────────────────
// A self-hosted port of the Rust effect engine (compiler/src/middle/effects.rs) + the
// `inferred ⊆ declared` gate (compiler/src/middle/mod.rs ANUBIS_UNDECLARED_EFFECT). Validated by
// scripts/run_effect_selfhost_gate.sh: a native_shadow-style differential that requires THIS engine
// and the Rust engine to AGREE on the reported undeclared-effect cap set over an SH-parseable corpus
// (0-disagreement invariant, exactly as native-vs-z3). This is a PARALLEL, self-hosted pass — its
// AUTHORITY transfers only after the gate is a permanent 0-disagreement invariant and the Rust
// checker is flipped to delegate (the shadow → opt-in-authoritative → default-flip arc of the native
// SMT solver). Scope: the SH subset — named-fn call graph, builtin classification, declared uses(),
// transitive fixpoint. The Rust higher_order_closure_args lambda-descent (effects.rs:87-99,291-300)
// and the CallExpr→open arm (effects.rs:306-314) are STRUCTURALLY UNREACHABLE here (the SH parser has
// no Lambda/CallExpr variant), not silently dropped — growing the SH parser with those is slice 2.

// The six canonical capability ids a row may contain (effects.rs CAPABILITY_IDS).
fn sh_is_cap(name) {
    return name == "fs.read" || name == "fs.write" || name == "net.send" || name == "shell" || name == "time.now" || name == "rand.gen";
}

// Canonical capability id a builtin callee carries, or "" if none. A pure mirror of
// effects.rs::builtin_effect_of (and the inline classification arms in mod.rs analyze_stmts).
fn sh_builtin_effect_of(callee) {
    if callee == "shell" || callee == "exec" || callee == "system" || callee == "target_run" {
        return "shell";
    }
    if callee == "read_file" || callee == "open" {
        return "fs.read";
    }
    if callee == "write_file" || callee == "write" || callee == "append_file" {
        return "fs.write";
    }
    if index_of(callee, "network") >= 0 || callee == "send" || callee == "connect" || callee == "http_get" || callee == "http_post" {
        return "net.send";
    }
    if callee == "time" || callee == "time_now" || callee == "now" {
        return "time.now";
    }
    if callee == "rand" || callee == "rand_gen" || callee == "random" {
        return "rand.gen";
    }
    return "";
}

// Fold a declared uses() token to its canonical id. Slice-1 scope: canonical dotted ids pass
// through unchanged (the corpus uses canonical ids only). Full alias folding (mod.rs
// normalize_effect_name) is a named slice-2 follow-up; an alias here would diverge from Rust and
// the differential gate would flag it, so the corpus avoids aliases.
fn sh_normalize_effect(name) {
    return name;
}

// Is `name` a known Anubis builtin — a MIRROR of backends/run.rs::is_builtin_name (emit_builtin_call
// ∪ is_proof_input_builtin ∪ is_poc_kit_builtin ∪ is_non_run_builtin ∪ the hardcoded list). The effect
// engine uses this in eff_walk_call to decide CLOSED (a known effect-free builtin) vs OPEN (a
// genuinely unknown callee): without it, an effect-free builtin the SH parser's own 24-name is_builtin
// omits (crypto/proof/symbolic/poc/cap/…) would spuriously OPEN the row, over-restricting the derived
// confinement (fail-closed but imprecise). The full 199-name registry is extracted + completeness-
// verified against run.rs; drift is caught by scripts/run_capset_corpus_failclosed.sh --strict
// (CONSERVATIVE must be 0). Effect builtins (send/shell/read_file/…) are ALSO here but are resolved
// earlier by sh_builtin_effect_of, so this list only decides the effect-free closed/open split.
fn sh_is_known_builtin(name) {
    return name == "abs" || name == "acos" || name == "aead_open" || name == "aead_seal" || name == "all" || name == "any" ||
name == "append_file" || name == "apply" || name == "argon2id_hash" || name == "args" || name == "asin" || name == "assert" ||
name == "assume" || name == "atan" || name == "atan2" || name == "bool" || name == "break" || name == "bytes_hex" ||
name == "call" || name == "cap_acquire" || name == "cap_use" || name == "capitalize" || name == "cbrt" || name == "ceil" ||
name == "chacha20_poly1305_open" || name == "chacha20_poly1305_seal" || name == "char_at" || name == "chars" || name == "chr" ||
name == "chunk" || name == "clamp" || name == "compose" || name == "concat" || name == "connect" || name == "constant_time_eq" ||
name == "contains" || name == "continue" || name == "cos" || name == "count" || name == "crypto_backend" || name == "ct_eq" ||
name == "cyclic" || name == "declassify" || name == "domain_hash" || name == "drop" || name == "drop_while" || name == "e" ||
name == "each" || name == "ed25519_keygen" || name == "ed25519_public_key" || name == "ed25519_sign" || name == "ed25519_verify" ||
name == "ends_with" || name == "entries" || name == "enumerate" || name == "env" || name == "eprint" || name == "eprintln" ||
name == "exec" || name == "exit" || name == "exp" || name == "factorial" || name == "filter" || name == "find" || name == "first" ||
name == "flat" || name == "flat_map" || name == "flatten" || name == "float" || name == "floor" || name == "gcd" || name == "get" ||
name == "getenv" || name == "has_key" || name == "hkdf_sha256" || name == "hmac_sha256" || name == "hmac_sha256_bytes" ||
name == "hmac_sha256_hex" || name == "hmac_sha256_verify" || name == "http_get" || name == "http_post" || name == "hypot" ||
name == "identity" || name == "index_of" || name == "input" || name == "insert" || name == "int" || name == "is_empty" ||
name == "join" || name == "keys" || name == "last" || name == "len" || name == "lines" || name == "ln" || name == "log" ||
name == "log10" || name == "log2" || name == "lower" || name == "map" || name == "map_values" || name == "max" || name == "max_by" ||
name == "memcpy" || name == "merge" || name == "min" || name == "min_by" || name == "network_send" || name == "now" || name == "open" ||
name == "ord" || name == "p16" || name == "p32" || name == "p64" || name == "p8" || name == "pad_end" || name == "pad_start" ||
name == "panic" || name == "parse_float" || name == "parse_float_opt" || name == "parse_int" || name == "parse_int_opt" ||
name == "partition" || name == "password_hash" || name == "password_hash_encode" || name == "password_hash_pbkdf2_encode" ||
name == "password_hash_phc" || name == "password_hash_phc_raw" || name == "password_verify" || name == "password_verify_encoding" ||
name == "pbkdf2_hmac_sha256" || name == "pi" || name == "pop" || name == "position" || name == "pow" || name == "print" ||
name == "println" || name == "product" || name == "proof_assert" || name == "proof_commit_bool" || name == "proof_commit_u32" ||
name == "proof_input_bool" || name == "proof_input_u32" || name == "proof_input_u64" || name == "push" || name == "rand" ||
name == "rand_gen" || name == "random" || name == "random_bytes" || name == "range" || name == "read_file" || name == "read_line" ||
name == "reduce" || name == "remove" || name == "repeat" || name == "replace" || name == "return" || name == "reverse" ||
name == "round" || name == "secret_source" || name == "send" || name == "sha256" || name == "sha256_bytes" || name == "sha256_hex" ||
name == "shell" || name == "sign" || name == "sin" || name == "sink" || name == "slice" || name == "sort" || name == "sort_by" ||
name == "split" || name == "sql" || name == "sqrt" || name == "starts_with" || name == "str" || name == "substr" || name == "sum" ||
