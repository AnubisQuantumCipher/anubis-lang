// EXPECT: 20
fn run_vm(prog) {
    let stack = [];
    for ins in prog {
        let op = ins[0];
        if op == "push" { stack = stack + [ins[1]]; }
        else if op == "add" { let b = stack[-1]; let a = stack[-2]; stack = slice(stack, 0, len(stack)-2) + [a + b]; }
        else if op == "mul" { let b = stack[-1]; let a = stack[-2]; stack = slice(stack, 0, len(stack)-2) + [a * b]; }
    }
    stack[-1]
}
fn main() {
    // (2 + 3) * 4
    print(run_vm([["push", 2], ["push", 3], ["add"], ["push", 4], ["mul"]]));
}
