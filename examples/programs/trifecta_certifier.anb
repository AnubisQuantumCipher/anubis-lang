// =============================================================================
// TRIFECTA-CERTIFIER — a proof-carrying firewall for AI-agent tool-call policies
// =============================================================================
// THE PROBLEM (real, current, unsolved as of 2026):
//   AI agents suffer "prompt injection." The industry consensus is that it is
//   architectural and not patchable at the model level, because trusted
//   instructions and untrusted content share ONE token channel. The dangerous
//   case is the "lethal trifecta" (Simon Willison, 2025-06): an agent that at
//   once (1) reads UNTRUSTED content, (2) can read PRIVATE data, and (3) can
//   COMMUNICATE EXTERNALLY. Any attacker who controls content the agent reads
//   can then steer its tool calls to exfiltrate secrets. This is not theory:
//   EchoLeak (CVE-2025-32711, CVSS 9.3) made Microsoft 365 Copilot exfiltrate
//   private data from a single crafted email, zero-click.
//
//   The best defenses (Meta's "Rule of Two", Google DeepMind's CaMeL) push
//   enforcement OUTSIDE the model into deterministic policy over data
//   provenance — but they enforce at RUNTIME and emit no independently
//   re-verifiable proof. The Dec-2025 "Auditable Agents / proof-of-guardrail"
//   literature names exactly this gap: current authorization "neither produces
//   a verifiable audit record" that a third party can re-check.
//
// WHAT THIS PROGRAM DOES (the never-been-built part):
//   It is a COMPILE-TIME certifier that takes an agent's tool-call policy graph
//   and emits a SIGNED, COLD-RE-VERIFIABLE certificate that the policy provably
//   cannot let untrusted or private data reach an external sink outside an
//   explicit, tagged declassification gate. Three layers, three compiler phases:
//
//     • `anubis run`   — a fixpoint information-flow analysis over the manifest
//                        (the "lethal trifecta" detector). ALLOW / DENY + the
//                        exact leaking confidentiality domain and flow path.
//     • `anubis check` — Z3 DISCHARGES the policy kernel's theorems: the
//                        confidentiality-subset non-interference law (bitmask
//                        AND), redaction-gate correctness, Rule-of-Two soundness,
//                        monotone taint, and fixpoint termination. A false law is
//                        rejected with a concrete counterexample bitmask.
//     • `anubis build --evidence` + `sign` — seals source + IR + the literal Z3
//                        queries + the analysis into a tamper-evident, Ed25519-
//                        signed Proof-Carrying Artifact an auditor re-checks cold.
//
//   Honest scope: this certifies a MODEL of the tool-call policy graph. It does
//   NOT read the LLM's tokens, classify natural language, or intercept live
//   calls. A green certificate means the modeled, pinned policy composition is
//   provably exfiltration-free at the tool-call layer — a machine-checked
//   proof-of-guardrail for the orchestration layer, re-verifiable by anyone.
// =============================================================================


// ---------------------------------------------------------------------------
// PART 1 — THE VERIFIED POLICY KERNEL   (theorems Z3 discharges at check-time)
// ---------------------------------------------------------------------------
// Confidentiality domains are bits of a u64 secrecy mask. These are not
// assertions — each is proved from its `requires` alone; a false one yields a
// concrete counterexample (see trifecta_attack_rejected.anb for a live refutation).

// NON-INTERFERENCE: data may flow to a recipient only if the recipient is
// authorized for EVERY confidentiality domain the data carries.
//   (data & allow) == data   <=>   domains(data) is a subset of domains(allow)
fn permitted(data: u64, allow: u64) -> u64
    requires(data >= 0) requires(allow >= 0)
    requires((data & allow) == data)
    ensures(result == data) {
    return data & allow;
}

// REDACTION-GATE CORRECTNESS: masking data to a recipient's allow-set yields a
// value the recipient IS authorized to receive (idempotence of AND). This is
// why the one audited declassification gate is sound.
fn redact(data: u64, allow: u64) -> u64
    requires(data >= 0) requires(allow >= 0)
    ensures((result & allow) == result) {
    return data & allow;
}

// RULE-OF-TWO SOUNDNESS (Meta, 2025-11): if a session activates at most two of
// the three trifecta legs, then NOT all three are active at once (their product
// is zero) — so exfiltration is structurally out of reach.
fn rule_of_two_sound(untrusted: u64, private: u64, egress: u64) -> u64
    requires(untrusted >= 0) requires(untrusted <= 1)
    requires(private >= 0)   requires(private <= 1)
    requires(egress >= 0)    requires(egress <= 1)
    requires(untrusted + private + egress <= 2)
    ensures(result == 0) {
    return untrusted * private * egress;
}

// The trifecta score is well-formed: bounded in [0, 3].
fn trifecta_score(a: u64, b: u64, c: u64) -> u64
    requires(a >= 0) requires(a <= 1) requires(b >= 0) requires(b <= 1) requires(c >= 0) requires(c <= 1)
    ensures(result >= 0) ensures(result <= 3) {
    return a + b + c;
}

// TAINT MONOTONICITY: an untrusted label never decreases through a pure step
// (only the audited declassify gate may lower it). Composition-checked.
fn escalate(t: u64) -> u64 requires(t >= 0) requires(t <= 1) ensures(result >= t) ensures(result <= 1) { return 1; }
fn escalate2(t: u64) -> u64 requires(t >= 0) requires(t <= 1) ensures(result >= t) ensures(result <= 1) {
    let q = escalate(t);
    return q;
}

// RISK JOIN: combining two risk scores never lowers either (additive, so it is
// provable where a `max` — being branch-dependent — would not be).
fn combine(a: u64, b: u64) -> u64
    requires(a >= 0) requires(a < 1000000) requires(b >= 0) requires(b < 1000000)
    ensures(result >= a) ensures(result >= b) {
    return a + b;
}

// FIXPOINT TERMINATION: the analysis budget strictly decreases and never goes
// negative — a machine-checked witness that the propagation loop terminates.
fn charge(fuel: u64) -> u64 requires(fuel > 0) requires(fuel < 1000000) ensures(result < fuel) ensures(result >= 0) {
    return fuel - 1;
}


// ---------------------------------------------------------------------------
// PART 2 — THE MANIFEST MODEL   (an agent tool-call policy graph, as data)
// ---------------------------------------------------------------------------
// A node kind. READ ingests a source; TRANSFORM joins inputs; DECLASSIFY is the
// one audited escape hatch (redacts secrecy, clears taint); EGRESS sends to an
// external sink with a declared recipient authorization mask.
struct Step {
    id: int,
    kind: int,         // 0=READ 1=TRANSFORM 2=DECLASSIFY 3=EGRESS
    inputs: list,      // ids of input steps
    trust: int,        // READ: 1=trusted, 0=untrusted (attacker-influenced)
    secrecy: int,      // READ: confidentiality bitmask of the source
    redact_mask: int,  // DECLASSIFY: keep only these domains
    sink_mask: int,    // EGRESS: recipient's authorized read mask
    label: string,
}

fn read_node(id, trust, secrecy, label)   { return Step { id: id, kind: 0, inputs: [],     trust: trust, secrecy: secrecy, redact_mask: 0, sink_mask: 0,        label: label }; }
fn xform(id, inputs, label)               { return Step { id: id, kind: 1, inputs: inputs, trust: 1,     secrecy: 0,       redact_mask: 0, sink_mask: 0,        label: label }; }
fn gate(id, inputs, redact_mask, label)   { return Step { id: id, kind: 2, inputs: inputs, trust: 1,     secrecy: 0,       redact_mask: redact_mask, sink_mask: 0, label: label }; }
fn egress(id, inputs, sink_mask, label)   { return Step { id: id, kind: 3, inputs: inputs, trust: 1,     secrecy: 0,       redact_mask: 0, sink_mask: sink_mask, label: label }; }

fn kind_name(k) {
    if k == 0 { return "READ"; }
    if k == 1 { return "XFORM"; }
    if k == 2 { return "DECLASSIFY"; }
    return "EGRESS";
}

// Name the confidentiality domains present in a bitmask.
fn domain_names(mask) {
    let names = ["PII", "FINANCIAL", "CREDENTIALS", "HEALTH", "SOURCE_CODE"];
    let mut out = [];
    let mut i = 0;
    let mut bit = 1;
    while i < len(names) {
        if (mask & bit) != 0 { push(out, names[i]); }
        bit = bit * 2;
        i = i + 1;
    }
    if len(out) == 0 { return "-"; }
    return join(out, "+");
}


// ---------------------------------------------------------------------------
// PART 3 — THE CERTIFICATION ENGINE   (a fixpoint information-flow analysis)
// ---------------------------------------------------------------------------
fn zeros(n) { let mut xs = []; let mut i = 0; while i < n { push(xs, 0); i = i + 1; } return xs; }

struct Report { name: string, verdict: string, violations: int, legs: int }

fn certify(name, steps) {
    let n = len(steps);
    let mut taint = zeros(n);      // 0 = trusted, 1 = untrusted/attacker-influenced
    let mut secrecy = zeros(n);    // confidentiality bitmask carried by each step's value

    // Fixpoint propagation, bounded by a strictly-decreasing fuel budget (charge()).
    let mut fuel = n * n + 4;
    let mut changed = true;
    while changed && fuel > 0 {
        fuel = fuel - 1;
        changed = false;
        for s in steps {
            let mut t = 0;
            let mut sec = 0;
            if s.kind == 0 {                       // READ: untrusted source raises taint
                t = 1 - s.trust;
                sec = s.secrecy;
            }
            if s.kind == 1 {                       // TRANSFORM: join taint (OR), union secrecy
                for inp in s.inputs { if taint[inp] == 1 { t = 1; } sec = sec | secrecy[inp]; }
            }
            if s.kind == 2 {                       // DECLASSIFY: the one audited escape hatch
                for inp in s.inputs { sec = sec | secrecy[inp]; }
                sec = sec & s.redact_mask;         // redact to permitted domains
                t = 0;                             // taint explicitly, accountably cleared
            }
            if s.kind == 3 {                       // EGRESS: carries its input value outward
                for inp in s.inputs { if taint[inp] == 1 { t = 1; } sec = sec | secrecy[inp]; }
            }
            if t != taint[s.id] || sec != secrecy[s.id] {
                taint[s.id] = t;
                secrecy[s.id] = sec;
                changed = true;
            }
        }
    }

    // Audit every EGRESS. Two ways a policy can fail:
    //   reason 1 INJECTION      — untrusted content reaches an external sink
    //   reason 2 CONFIDENTIALITY — data carries a domain the recipient may not receive
    let mut violations = [];
    for s in steps {
        if s.kind == 3 {
            let t = taint[s.id];
            let sec = secrecy[s.id];
            let leaked = sec & (0 - s.sink_mask - 1);   // sec & ~sink_mask
            if t == 1 { push(violations, [s.id, 1, leaked]); }
            else if leaked != 0 { push(violations, [s.id, 2, leaked]); }
        }
    }

    // Trifecta legs.
    let mut untrusted_in = 0;
    let mut private_read = 0;
    let mut external_egress = 0;
    for s in steps {
        if s.kind == 0 && s.trust == 0 { untrusted_in = 1; }
        if s.kind == 0 && s.secrecy != 0 { private_read = 1; }
        if s.kind == 3 { external_egress = 1; }
    }
    let legs = untrusted_in + private_read + external_egress;
    let verdict = if len(violations) == 0 { "ALLOW" } else { "DENY" };

    // ---- report ----
    print("");
    print("┌── certifying manifest: ${name}");
    for s in steps {
        let tstr = if taint[s.id] == 1 { "UNTRUSTED" } else { "trusted  " };
        let flow = if len(s.inputs) == 0 { "" } else { "  <- ${s.inputs}" };
        print("│   [${s.id}] ${pad_end(kind_name(s.kind), 10)} taint=${tstr} secrecy={${domain_names(secrecy[s.id])}}  ${s.label}${flow}");
    }
    print("│");
    print("│   trifecta legs: untrusted_read=${untrusted_in} private_read=${private_read} external_egress=${external_egress}  (score ${legs}/3)");
    if legs >= 3 {
        print("│   Rule-of-Two: WARN — all 3 legs present (heuristic). Flow certification decides precisely:");
    } else {
        print("│   Rule-of-Two: OK — ${rule_of_two_sound(untrusted_in, private_read, external_egress)} (proved: a leg is absent, exfiltration structurally impossible)");
    }
    if len(violations) == 0 {
        print("│   no undeclassified untrusted/private flow reaches any external sink.");
    } else {
        for v in violations {
            let reason = if v[1] == 1 { "INJECTION: untrusted content reaches external sink" } else { "CONFIDENTIALITY: recipient not authorized for these domains" };
            print("│   ✗ egress step [${v[0]}]  ${reason}");
            print("│       offending domains: {${domain_names(v[2])}}");
        }
    }
    print("└── VERDICT: ${verdict}");
    return Report { name: name, verdict: verdict, violations: len(violations), legs: legs };
}


// ---------------------------------------------------------------------------
// PART 4 — TWO REAL AGENT MANIFESTS
// ---------------------------------------------------------------------------
// Domain bits: 1=PII  2=FINANCIAL  4=CREDENTIALS  8=HEALTH  16=SOURCE_CODE

// SAFE: a research assistant that reads untrusted web results AND private mail
// AND can notify externally (all three legs) — yet is PROVABLY safe because a
// declassification gate strips secrecy to the recipient's authorized set and
// clears the attacker-influenced taint before egress.
fn manifest_safe() {
    return [
        read_node(0, 1, 0, "user_request(trusted)"),
        read_node(1, 0, 0, "web_search_result(untrusted)"),
        read_node(2, 1, 1, "user_mailbox(private:PII)"),
        xform(3, [1, 2], "draft_reply"),
        gate(4, [3], 1, "policy_redaction_gate[keep:PII, clear taint]"),
        egress(5, [4], 1, "notify_user(recipient authz:PII)"),
    ];
}

// ATTACK: the EchoLeak shape (CVE-2025-32711). A crafted inbound email
// (untrusted) drives the agent to read private SharePoint data and exfiltrate
// it to an attacker-controlled URL that is authorized for NOTHING. No gate.
fn manifest_attack() {
    return [
        read_node(0, 0, 0, "inbound_email_body(untrusted)"),
        read_node(1, 1, 3, "sharepoint_doc(private:PII+FINANCIAL)"),
        xform(2, [0, 1], "copilot_compose_reply"),
        egress(3, [2], 0, "fetch_markdown_image(attacker_url, authz:none)"),
    ];
}


// ---------------------------------------------------------------------------
// MAIN — prove the kernel, certify the manifests, seal the verdict
// ---------------------------------------------------------------------------
fn main() {
    print("═══════════════════════════════════════════════════════════════════");
    print("  TRIFECTA-CERTIFIER — a proof-carrying firewall for AI agents");
    print("═══════════════════════════════════════════════════════════════════");

    // PART 1 — the policy kernel. At `anubis check` these are Z3 theorems; here
    // at runtime they simply compute — one law, two readings.
    print("");
    print("policy kernel (each law discharged by Z3 at check-time):");
    print("  permitted(0b001, 0b101)   = ${permitted(1, 5)}   |= (data & allow)==data  (non-interference)");
    print("  redact(0b111, 0b001)      = ${redact(7, 1)}   |= (result & allow)==result (gate correctness)");
    print("  rule_of_two_sound(1,1,0)  = ${rule_of_two_sound(1, 1, 0)}   |= result==0            (a leg is absent)");
    print("  trifecta_score(1,1,1)     = ${trifecta_score(1, 1, 1)}   |= 0<=result<=3         (well-formed)");
    print("  escalate2(1)              = ${escalate2(1)}   |= result>=t & result<=1  (taint monotone)");
    print("  combine(2, 3)             = ${combine(2, 3)}   |= result>=a & result>=b   (risk join)");
    print("  charge(9)                 = ${charge(9)}   |= result<fuel & result>=0 (termination)");

    // PART 2 — certify two real agent tool-call policies.
    print("");
    print("───────────────────────────────────────────────────────────────────");
    print("information-flow certification of agent tool-call policies:");
    let r_safe = certify("research-assistant (well-configured)", manifest_safe());
    let r_attack = certify("m365-copilot (EchoLeak / CVE-2025-32711 shape)", manifest_attack());

    // Seal the verdicts.
    print("");
    print("───────────────────────────────────────────────────────────────────");
    print("CERTIFICATION SUMMARY");
    print("  ${pad_end(r_safe.name, 46)} -> ${r_safe.verdict}  (${r_safe.violations} violations)");
    print("  ${pad_end(r_attack.name, 46)} -> ${r_attack.verdict}  (${r_attack.violations} violations)");
    let ok = r_safe.verdict == "ALLOW" && r_attack.verdict == "DENY";
    print("  certifier self-test: ${if ok { "PASS — allows safe, denies EchoLeak" } else { "FAIL" }}");
    print("═══════════════════════════════════════════════════════════════════");
    return if ok { 0 } else { 1 };
}
