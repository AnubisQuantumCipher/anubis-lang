// EXPECT: circle: 12|shape: 12|circle: 3|total area: 27
trait Shape { fn area(self); fn name(self) { "shape" } }
struct Circle { r: int }
struct Rect { w: int, h: int }
impl Shape for Circle { fn area(self) { 3 * self.r * self.r } fn name(self) { "circle" } }
impl Shape for Rect { fn area(self) { self.w * self.h } }
fn main() {
    let shapes = [Circle { r: 2 }, Rect { w: 3, h: 4 }, Circle { r: 1 }];
    let total = reduce(map(shapes, |s| s.area()), |a, b| a + b, 0);
    for s in shapes { print("${s.name()}: ${s.area()}"); }
    print("total area: ${total}");
}
