// =============================================================================
// AEGIS — a verified stack machine, written in Anubis
// =============================================================================
// Anubis is two languages fused into one file: an ordinary, expressive runtime,
// AND a proof surface where `requires`/`ensures` contracts are discharged by an
// SMT solver at `anubis check` time. Almost every program in the corpus uses one
// half or the other. Aegis uses BOTH:
//
//   • `anubis run  examples/programs/aegis_vm.anb`
//        assembles and executes four real programs on a stack VM.
//
//   • `anubis check examples/programs/aegis_vm.anb`
//        asks Z3 to PROVE the machine's five integer-safety contracts. If any
//        proof fails, the program is rejected — the artifact cannot be built.
//
//   • `anubis build examples/programs/aegis_vm.anb --evidence`
//        seals source + IR + solver query + native artifact into a tamper-evident
//        Proof-Carrying Artifact you can `verify` and Ed25519-`sign`.
//
// Language features exercised: enums (18-variant ISA), exhaustive `match`, traits
// with default methods, generics, closures, methods on structs, Option/`get`,
// two-pass assembly with a label map, in-place VM state, string interpolation, a
// self-sealing FNV hash chain — and SMT-verified contracts.
// =============================================================================


// ---------------------------------------------------------------------------
// 1. VERIFIED SAFETY ENVELOPE  (the crown jewel: proved by Z3 at check-time)
// ---------------------------------------------------------------------------
// Each contract is discharged from its `requires` alone — the solver models
// 64-bit signed integers, so every bound below is load-bearing.

// The program counter strictly advances on a straight-line step: no self-stall.
fn advance_pc(pc: u32) -> u32 requires(pc >= 0) requires(pc < 1000000) ensures(result > pc) {
    return pc + 1;
}

// Fuel strictly decreases every step — the machine's termination pressure.
fn fuel_tick(fuel: u32) -> u32 requires(fuel > 0) requires(fuel < 1000000) ensures(result < fuel) {
    return fuel - 1;
}

// Doubling a magnitude never shrinks it (a sanity bound the MUL path relies on).
fn nonneg_double(x: u32) -> u32 requires(x >= 0) requires(x < 1000000) ensures(result >= x) {
    return x + x;
}

// Composition: this proof leans on advance_pc's proven postcondition.
fn advance2(pc: u32) -> u32 requires(pc >= 0) requires(pc < 1000000) ensures(result > pc) {
    let q = advance_pc(pc);
    return q;
}

// Every return path is proved positive from the precondition alone (not the branch).
fn keep_positive(x: u32) -> u32 requires(x > 0) requires(x < 1000000) ensures(result > 0) {
    if x > 100 { return x; }
    return x + 1;
}


// ---------------------------------------------------------------------------
// 2. THE INSTRUCTION SET  (an enum: unit + tuple variants)
// ---------------------------------------------------------------------------
enum Op {
    Push(int),
    Pop, Dup, Swap,
    Add, Sub, Mul, Div, Mod,
    Lt, Gt, Eq,
    Load(int), Store(int),
    Jmp(int), Jz(int),
    Print, Halt,
}

// A trait with a default method, implemented by the enum — used to disassemble.
trait Show {
    fn tag(self);
    fn show(self) { "<${self.tag()}>" }   // default, built from the required method
}
impl Show for Op {
    fn tag(self) {
        match self {
            Op::Push(v)  => "push ${v}",
            Op::Pop      => "pop",
            Op::Dup      => "dup",
            Op::Swap     => "swap",
            Op::Add      => "add",
            Op::Sub      => "sub",
            Op::Mul      => "mul",
            Op::Div      => "div",
            Op::Mod      => "mod",
            Op::Lt       => "lt",
            Op::Gt       => "gt",
            Op::Eq       => "eq",
            Op::Load(i)  => "load ${i}",
            Op::Store(i) => "store ${i}",
            Op::Jmp(t)   => "jmp ${t}",
            Op::Jz(t)    => "jz ${t}",
            Op::Print    => "print",
            Op::Halt     => "halt",
        }
    }
}

// A generic result record (generics are erased, but self-documenting).
struct Outcome<T> { label: string, value: T, status: string, steps: int }
impl<T> Outcome<T> {
    fn report(self) { "${self.label} = ${self.value}  [${self.status}, ${self.steps} steps]" }
}


// ---------------------------------------------------------------------------
// 3. THE ASSEMBLER  (two passes, a label map, Option-style lookup)
// ---------------------------------------------------------------------------
fn strip_comment(line) {
    let idx = index_of(line, ";");
    if idx >= 0 { return trim(substr(line, 0, idx)); }
    return trim(line);
}

// Turn one cleaned mnemonic line into an Op. Jumps resolve labels through `labels`.
fn parse_op(mn, arg, labels) {
    if mn == "PUSH"  { return Op::Push(parse_int(arg)); }
    if mn == "POP"   { return Op::Pop; }
    if mn == "DUP"   { return Op::Dup; }
    if mn == "SWAP"  { return Op::Swap; }
    if mn == "ADD"   { return Op::Add; }
    if mn == "SUB"   { return Op::Sub; }
    if mn == "MUL"   { return Op::Mul; }
    if mn == "DIV"   { return Op::Div; }
    if mn == "MOD"   { return Op::Mod; }
    if mn == "LT"    { return Op::Lt; }
    if mn == "GT"    { return Op::Gt; }
    if mn == "EQ"    { return Op::Eq; }
    if mn == "LOAD"  { return Op::Load(parse_int(arg)); }
    if mn == "STORE" { return Op::Store(parse_int(arg)); }
    if mn == "JMP"   { return Op::Jmp(get(labels, arg, 0)); }
    if mn == "JZ"    { return Op::Jz(get(labels, arg, 0)); }
    if mn == "PRINT" { return Op::Print; }
    return Op::Halt;   // unknown mnemonic → halt (fail closed)
}

fn assemble(src) {
    let raw = lines(src);
    // Pass 1: strip comments/blanks; record label -> instruction index.
    let mut insns = [];
    let mut labels = {};
    let mut idx = 0;
    for line in raw {
        let clean = strip_comment(line);
        if clean == "" { continue; }
        if ends_with(clean, ":") {
            let name = trim(substr(clean, 0, len(clean) - 1));
            labels[name] = idx;
        } else {
            push(insns, clean);
            idx = idx + 1;
        }
    }
    // Pass 2: parse each instruction, resolving jump targets against the label map.
    let mut prog = [];
    for ins in insns {
        let parts = split(ins, " ");
        let mn = upper(parts[0]);
        let arg = if len(parts) > 1 { parts[1] } else { "" };
        push(prog, parse_op(mn, arg, labels));
    }
    return prog;
}


// ---------------------------------------------------------------------------
// 4. THE VIRTUAL MACHINE  (one function, in-place state, exhaustive dispatch)
// ---------------------------------------------------------------------------
fn zeros(n) {
    let mut xs = [];
    let mut i = 0;
    while i < n { push(xs, 0); i = i + 1; }
    return xs;
}
fn top_of(stack) {
    if len(stack) == 0 { return 0; }
    return stack[len(stack) - 1];
}

// Execute `prog` with `nlocals` local slots and a fuel budget. Fails closed on
// fuel exhaustion and division by zero. Returns an Outcome<T>.
fn run_vm(label, prog, nlocals, fuel_limit) {
    let mut pc = 0;
    let mut stack = [];
    let mut locals = zeros(nlocals);
    let mut fuel = 0;
    let mut out = [];
    let mut status = "ok";
    let n = len(prog);

    while pc >= 0 && pc < n {
        if fuel >= fuel_limit { status = "fuel-exhausted"; pc = n; }
        else {
            fuel = fuel + 1;
            let op = prog[pc];
            let mut next = pc + 1;
            match op {
                Op::Push(v)  => { push(stack, v); }
                Op::Pop      => { pop(stack); }
                Op::Dup      => { push(stack, top_of(stack)); }
                Op::Swap     => { let a = pop(stack); let b = pop(stack); push(stack, a); push(stack, b); }
                Op::Add      => { let b = pop(stack); let a = pop(stack); push(stack, a + b); }
                Op::Sub      => { let b = pop(stack); let a = pop(stack); push(stack, a - b); }
                Op::Mul      => { let b = pop(stack); let a = pop(stack); push(stack, a * b); }
                Op::Div      => {
                    let b = pop(stack); let a = pop(stack);
                    if b == 0 { status = "div-by-zero"; next = n; } else { push(stack, a / b); }
                }
                Op::Mod      => {
                    let b = pop(stack); let a = pop(stack);
                    if b == 0 { status = "mod-by-zero"; next = n; } else { push(stack, a % b); }
                }
                Op::Lt       => { let b = pop(stack); let a = pop(stack); push(stack, if a < b { 1 } else { 0 }); }
                Op::Gt       => { let b = pop(stack); let a = pop(stack); push(stack, if a > b { 1 } else { 0 }); }
                Op::Eq       => { let b = pop(stack); let a = pop(stack); push(stack, if a == b { 1 } else { 0 }); }
                Op::Load(i)  => { push(stack, locals[i]); }
                Op::Store(i) => { let v = pop(stack); locals[i] = v; }
                Op::Jmp(t)   => { next = t; }
                Op::Jz(t)    => { let c = pop(stack); if c == 0 { next = t; } }
                Op::Print    => { push(out, top_of(stack)); }
                Op::Halt     => { status = "halt"; next = n; }
            }
            pc = next;
        }
    }

    let value = if len(out) > 0 { out[len(out) - 1] } else { top_of(stack) };
    return Outcome { label: label, value: value, status: status, steps: fuel };
}


// ---------------------------------------------------------------------------
// 5. SELF-SEAL  (an FNV-style hash chain over every result — the artifact's tag)
// ---------------------------------------------------------------------------
fn seal(entries) {
    let mut h = 2166136261;
    for e in entries {
        let s = str(e);
        for i in 0..len(s) {
            h = (h * 16777619 + ord(char_at(s, i))) % 2147483647;
        }
    }
    return h;
}


// ---------------------------------------------------------------------------
// 6. FOUR REAL PROGRAMS, written in Aegis assembly
// ---------------------------------------------------------------------------
// factorial(6) = 720           locals: 0=acc, 1=n
fn src_factorial() {
    return "PUSH 1
STORE 0
PUSH 6
STORE 1
loop:
LOAD 1
JZ done
LOAD 0
LOAD 1
MUL
STORE 0
LOAD 1
PUSH 1
SUB
STORE 1
JMP loop
done:
LOAD 0
PRINT
HALT";
}

// gcd(48, 36) = 12  (Euclid)   locals: 0=a, 1=b
fn src_gcd() {
    return "PUSH 48
STORE 0
PUSH 36
STORE 1
loop:
LOAD 1
JZ done
LOAD 0
LOAD 1
MOD
LOAD 1
STORE 0
STORE 1
JMP loop
done:
LOAD 0
PRINT
HALT";
}

// sum of squares 1..5 = 55     locals: 0=sum, 1=i
fn src_sumsq() {
    return "PUSH 0
STORE 0
PUSH 1
STORE 1
loop:
LOAD 1
PUSH 6
LT
JZ done
LOAD 0
LOAD 1
LOAD 1
MUL
ADD
STORE 0
LOAD 1
PUSH 1
ADD
STORE 1
JMP loop
done:
LOAD 0
PRINT
HALT";
}

// fibonacci(10) = 55           locals: 0=a, 1=b, 2=n
fn src_fib() {
    return "PUSH 0
STORE 0
PUSH 1
STORE 1
PUSH 10
STORE 2
loop:
LOAD 2
JZ done
LOAD 1
LOAD 0
LOAD 1
ADD
STORE 1
STORE 0
LOAD 2
PUSH 1
SUB
STORE 2
JMP loop
done:
LOAD 0
PRINT
HALT";
}


// ---------------------------------------------------------------------------
// 7. MAIN  —  prove, assemble, execute, seal
// ---------------------------------------------------------------------------
fn main() {
    print("═══════════════════════════════════════════════════════════════");
    print("  AEGIS — a verified stack machine in Anubis");
    print("═══════════════════════════════════════════════════════════════");

    // The safety envelope. At `anubis check` these five carry Z3 proofs; here at
    // runtime they simply compute — same functions, two readings.
    print("");
    print("proved safety envelope (discharged by the solver at check-time):");
    print("  advance_pc(41)     = ${advance_pc(41)}     |= result > pc");
    print("  fuel_tick(1000)    = ${fuel_tick(1000)}   |= result < fuel");
    print("  nonneg_double(21)  = ${nonneg_double(21)}    |= result >= x");
    print("  advance2(41)       = ${advance2(41)}     |= result > pc  (by composition)");
    print("  keep_positive(3)   = ${keep_positive(3)}      |= result > 0   (every path)");

    // Assemble and run four real programs on the VM.
    print("");
    print("stack machine (assemble → execute):");
    let jobs = [
        ["factorial(6)", src_factorial(), 2],
        ["gcd(48,36)",   src_gcd(),       2],
        ["sum_sq(1..5)", src_sumsq(),     2],
        ["fib(10)",      src_fib(),       3],
    ];

    let mut results = [];
    for job in jobs {
        let name = job[0];
        let prog = assemble(job[1]);
        let res = run_vm(name, prog, job[2], 100000);
        print("  ${res.report()}");
        push(results, res.value);
        push(results, res.status);
    }

    // Disassemble one program to show the trait-based Show in action.
    print("");
    print("disassembly of gcd(48,36) (via trait Show):");
    let gcd_prog = assemble(src_gcd());
    let listing = map(gcd_prog, |op| op.tag());
    print("  ${join(listing, " | ")}");

    // Self-seal every result into a single integrity tag.
    print("");
    let expected = [720, 12, 55, 55];
    let got = map(jobs, |j| run_vm(j[0], assemble(j[1]), j[2], 100000).value);
    let ok = got == expected;
    print("results  = ${got}");
    print("expected = ${expected}");
    print("SEAL#${seal(results)}  verdict=${if ok { "PASS" } else { "FAIL" }}");
    print("═══════════════════════════════════════════════════════════════");
    return seal(results);
}
