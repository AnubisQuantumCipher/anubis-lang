// ╔══════════════════════════════════════════════════════════════════════════╗
// ║  NEXUS — Checker-Only Security Verification Companion                   ║
// ║                                                                        ║
// ║  These functions use taint_source, declassify, cap_acquire, cap_use,   ║
// ║  and @verified — primitives that exist only in the checker lane.       ║
// ║  `anubis check` proves the information-flow discipline is sound.       ║
// ║  `anubis run` is not supported (by design: these are proof artifacts). ║
// ╚══════════════════════════════════════════════════════════════════════════╝

// ── Shared contracts (duplicated here for self-containment) ──────────────

fn clamp(val: i64, lo: i64, hi: i64) -> i64
    requires(lo >= 0) requires(hi >= lo) requires(hi < 1000000)
    requires(val >= -1000000) requires(val < 2000000)
    ensures(result >= lo) ensures(result <= hi)
{
    if val < lo { return lo }
    if val > hi { return hi }
    return val
}

fn disclosure_gate(surprise_level: secret<i64>, threshold: secret<i64>) -> secret<i64>
    requires(surprise_level >= 0) requires(surprise_level < 10000)
    requires(threshold >= 0) requires(threshold < 10000)
    ensures(result >= 0) ensures(result <= 1)
{
    if surprise_level > threshold { return 1 }
    return 0
}

// ═══════════════════════════════════════════════════════════════════════════
// I. TAINT-TRACKED PERCEPTION
// The checker proves: untrusted data (taint_source) is validated (clamp)
// before being released (declassify) with an auditable policy + reason.
// ═══════════════════════════════════════════════════════════════════════════

fn taint_checked_ingest() -> i64 {
    let raw = taint_source("external_sensor_array");
    let bounded = clamp(raw, 0, 9999);
    let clean = declassify(bounded, "sensor_validation", "clamped to physical range [0,9999]");
    return clean
}

fn taint_checked_command() -> i64 {
    let cmd = taint_source("operator_command_channel");
    let valid = clamp(cmd, 0, 99);
    return declassify(valid, "command_validation", "bounded to opcode range [0,99]")
}

// ═══════════════════════════════════════════════════════════════════════════
// II. CONTROLLED DISCLOSURE
// The checker proves: a secret is released ONLY when the surprise level
// exceeds the disclosure threshold. The declassify carries a policy
// ("regulatory_oversight") and a reason, creating an audit trail.
// ═══════════════════════════════════════════════════════════════════════════

fn controlled_disclosure(
    belief: secret<i64>,
    surprise_val: secret<i64>,
    threshold: secret<i64>
) -> i64 {
    let gate = disclosure_gate(surprise_val, threshold);
    if gate == 1 {
        return declassify(
            belief,
            "regulatory_oversight",
            "surprise exceeded threshold: mandatory disclosure"
        )
    }
    return -1
}

// ═══════════════════════════════════════════════════════════════════════════
// III. CAPABILITY-GATED BROADCAST
// @verified enforces: effect declared (uses), capability acquired before
// use (cap_acquire), linear token consumed exactly once (cap_use),
// lethal trifecta (fs.read + untrusted + net.send) not triggered.
// ═══════════════════════════════════════════════════════════════════════════

@verified
fn broadcast_certificate(payload: i64) uses(net.send) {
    let cap = cap_acquire("net.send");
    send("mission_control", 9001, payload);
    cap_use(cap)
}

// ═══════════════════════════════════════════════════════════════════════════
// IV. MAIN — exercises all checker-only features for verification
// ═══════════════════════════════════════════════════════════════════════════

fn main() {
    let sensor = taint_checked_ingest();
    let cmd = taint_checked_command();

    let belief: secret<i64> = 5000;
    let surprise: secret<i64> = 2000;
    let threshold: secret<i64> = 1000;
    let disclosed = controlled_disclosure(belief, surprise, threshold);

    print("checker-only verification complete")
}
