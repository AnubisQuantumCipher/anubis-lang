// VZ CONFINEMENT DEMO — the language derives a hypervisor confinement policy from its own PROVEN
// effect set. Run:  anubis vz confine examples/showcase/vz_confine_demo.anb
// This program declares NO capabilities and provably uses none, so Anubis derives the MOST confined
// posture: network:host-only (--net-host, no internet) + mount:none. If a future edit added an
// undeclared network egress, the checker would reject it in Safe mode — and even a MISSED higher-order
// flow would only make the guest MORE confined (fail-closed at the hypervisor). The manifest is sealed
// + re-derived-on-verify in every `anubis build --evidence` bundle (confinement_manifest.json).
// Bound both factors so free×free wrap-safety offline-proves (factor is non-negative demo scale).
fn scale(x: i64, factor: i64) -> i64
    requires(x >= -1000000)
    requires(x <= 1000000)
    requires(factor >= 0)
    requires(factor <= 1000)
{
    return x * factor;
}
fn total(base: i64) -> i64
    requires(base >= -1000000)
    requires(base <= 1000000)
{
    return scale(base, 3) + scale(base, 2);
}
fn main() { let _ = total(7); }
