// =============================================================================
// NEXUS ZK Decision Companion — minimal public journal shape
// =============================================================================
//
// Proves a *decision function* journal, not the private target.
// Public outputs (conceptual journal fields):
//   policy_version, kind_code, decision_code, scope_ok, declass_ok
//
// Private witnesses stay off-journal in the full NEXUS kernel; this program
// demonstrates the parameterized proof surface for the decision codes.
//
// Run:   ./target/release/anubis run examples/industry/nexus_zk_decision.anb
// Prove: ./target/release/anubis prove examples/industry/nexus_zk_decision.anb \
//          --backend risc0 --lane cpu --input-json '{...}' --evidence
//
// Honest: when run ordinarily, inputs are demo constants. Parameterized prove
// uses proof_input_* when the backend path is available.
// =============================================================================

// Decision codes: 0 Allow, 1 Watch, 2 Hold, 3 Deny, 4 Abort
fn decide(policy_version, kind_code, path_ok, host_ok, offensive_ok, sensitive, declass_ok, has_witness, fuel, expired, frozen) {
    if frozen != 0 { return 4; }
    if expired != 0 { return 4; }
    if fuel <= 0 { return 3; }
    if path_ok == 0 {
        // agent-style prod escape marker: kind CloudMutate(5) or Shell(1) + path fail → Abort
        if kind_code == 5 || kind_code == 1 { return 4; }
        return 3;
    }
    if host_ok == 0 { return 3; }
    // ExploitModule = 6
    if kind_code == 6 {
        if offensive_ok == 0 { return 3; }
        if has_witness == 0 { return 2; }
    }
    // Disclose = 7
    if kind_code == 7 {
        if sensitive != 0 && declass_ok == 0 { return 3; }
        if sensitive != 0 && declass_ok == 2 && has_witness == 0 { return 2; } // full needs witness
    }
    // Secret path marker path_ok==2 means secret class allowed but needs witness for agents
    if path_ok == 2 && has_witness == 0 { return 2; }
    // CloudMutate needs witness
    if kind_code == 5 && has_witness == 0 { return 3; }
    // Elevated risk watch for shell/net
    if kind_code == 1 || kind_code == 4 {
        if sensitive != 0 { return 1; }
    }
    // policy_version is bound into the public value mix below
    return 0;
}

fn public_mix(policy_version, kind_code, decision_code) {
    // Minimal public journal commitment (non-crypto demo mix)
    let x = policy_version;
    x = ((x * 33) + kind_code) % 1000003;
    x = ((x * 33) + decision_code) % 1000003;
    return x;
}

fn main() {
    // Prefer proof inputs when lowered to guest; for ordinary run use demos.
    // proof_input_* may be unsupported on plain run — keep pure demo path.
    let policy_version = 7;
    let kind_code = 7;       // Disclose
    let path_ok = 1;
    let host_ok = 1;
    let offensive_ok = 1;
    let sensitive = 1;       // credential material
    let declass_ok = 0;      // None → should Deny
    let has_witness = 0;
    let fuel = 10;
    let expired = 0;
    let frozen = 0;

    let d1 = decide(policy_version, kind_code, path_ok, host_ok, offensive_ok, sensitive, declass_ok, has_witness, fuel, expired, frozen);
    // hash-only declass
    let d2 = decide(policy_version, kind_code, path_ok, host_ok, offensive_ok, sensitive, 1, has_witness, fuel, expired, frozen);
    // exploit without witness
    let d3 = decide(policy_version, 6, path_ok, host_ok, offensive_ok, 0, 1, 0, fuel, expired, frozen);
    // exploit with witness
    let d4 = decide(policy_version, 6, path_ok, host_ok, offensive_ok, 0, 1, 1, fuel, expired, frozen);
    // prod-style path fail shell → abort
    let d5 = decide(policy_version, 1, 0, host_ok, offensive_ok, 0, 1, 0, fuel, expired, frozen);
    // frozen
    let d6 = decide(policy_version, 2, path_ok, host_ok, offensive_ok, 0, 1, 0, fuel, expired, 1);

    let j1 = public_mix(policy_version, 7, d1);
    let j2 = public_mix(policy_version, 7, d2);
    let j3 = public_mix(policy_version, 6, d3);
    let j4 = public_mix(policy_version, 6, d4);
    let j5 = public_mix(policy_version, 1, d5);
    let j6 = public_mix(policy_version, 2, d6);

    print("NEXUS_ZK_DECISION");
    print("d_disclose_no_declass=${d1} journal=${j1}");
    print("d_disclose_hash_only=${d2} journal=${j2}");
    print("d_exploit_no_wit=${d3} journal=${j3}");
    print("d_exploit_wit=${d4} journal=${j4}");
    print("d_shell_path_fail=${d5} journal=${j5}");
    print("d_frozen=${d6} journal=${j6}");

    // Expected: 3, 0, 2, 0, 4, 4
    let ok = 0;
    if d1 == 3 { ok = ok + 1; }
    if d2 == 0 { ok = ok + 1; }
    if d3 == 2 { ok = ok + 1; }
    if d4 == 0 { ok = ok + 1; }
    if d5 == 4 { ok = ok + 1; }
    if d6 == 4 { ok = ok + 1; }
    print("checks=${ok}/6");
    print("SEAL#${((j1 + j2 + j3 + j4 + j5 + j6) % 1000003)}");
    if ok == 6 {
        print("VERDICT=NEXUS_ZK_DECISION_PASS");
        return 0;
    }
    print("VERDICT=NEXUS_ZK_DECISION_FAIL");
    return 1;
}
