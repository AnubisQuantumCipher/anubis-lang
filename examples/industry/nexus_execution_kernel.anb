// =============================================================================
// Reporting
// =============================================================================

fn hr() {
    print("----------------------------------------------------------------------------");
}

fn print_journal(journal) {
    print("PUBLIC JOURNAL (selective disclosure · raw targets excluded)");
    hr();
    for r in journal {
        print("  #${pad_start(str(r.seq), 2)}  ${pad_end(r.actor_id, 14)}  kind=${r.kind_code}  ${pad_end(decision_label(r.decision_code), 6)}  taint=${r.taint_code} path=${r.path_code} fuel=${r.fuel_left}  chain=${r.chain}  tgt=${r.target_digest}");
    }
}

fn print_private_count(priv) {
    print("PRIVATE WITNESS STORE: ${len(priv)} rows retained offline (not in public journal)");
}

fn main() {
    print("NEXUS — Networked EXecution Under Sealed policy");
    print("Mode: SAFE · offline deterministic action kernel · not live tool mediation");
    hr();

    let charter = demo_charter();
    let actors0 = demo_actors();
    let intents = demo_intents();
    let hybrid_plan = plan_hybrid(len(intents));

    print("CHARTER  id=${charter.id}  policy=v${charter.policy_version}  kill_epoch=${charter.kill_epoch}  fuel=${charter.max_fuel}  offensive=${charter.allow_offensive}");
    print("ACTORS   ${len(actors0)}   INTENTS  ${len(intents)}");
    print("HYBRID   lane=${hybrid_plan.lane} planned=${hybrid_plan.planned} executed=${hybrid_plan.executed}  (${hybrid_plan.note})");
    print("");

    let result = process_stream(intents, actors0, charter);
    let journal = result["journal"];
    let priv = result["private"];
    let actors = result["actors"];
    let fuel = result["fuel"];
    let receipt = result["receipt"];
    let chain = result["chain"];
    let frozen = result["frozen"];
    let allow_n = result["allow"];
    let watch_n = result["watch"];
    let hold_n = result["hold"];
    let deny_n = result["deny"];
    let abort_n = result["abort"];

    print_journal(journal);
    print("");
    print_private_count(priv);

    print("");
    print("ACTOR POSTURE (post-stream)");
    hr();
    for a in actors {
        let st = if a.active == 1 { "ACTIVE" } else { "FROZEN" };
        print("  ${pad_end(a.id, 14)}  role=${pad_end(a.role, 10)}  trust=${a.trust}  ${st}");
    }

    print("");
    print("STREAM TOTALS");
    hr();
    print("  ALLOW   ${allow_n}");
    print("  WATCH   ${watch_n}");
    print("  HOLD    ${hold_n}");
    print("  DENY    ${deny_n}");
    print("  ABORT   ${abort_n}");
    print("  FUEL    ${fuel}");
    print("  RECEIPT ${receipt}");
    print("  CHAIN   ${chain}");
    print("  FROZEN  ${frozen}");

    // Expected-outcome battery — STRICT equality only (no soft aliases)
    let exp = expected_map();
    let hits = 0;
    let checks = 0;
    let mut mismatches = [];
    for r in journal {
        let key = str(r.seq);
        if has_key(exp, key) {
            checks = checks + 1;
            let want = exp[key];
            if r.decision_code == want {
                hits = hits + 1;
            } else {
                push(mismatches, "seq=${r.seq} want=${want} got=${r.decision_code}");
            }
        }
    }
    print("");
    print("EXPECTED-OUTCOME BATTERY (strict)");
    hr();
    print("  checks  ${checks}");
    print("  hits    ${hits}");
    for m in mismatches {
        print("  MISS    ${m}");
    }
    let exp_ok = if checks == 15 && hits == 15 { 1 } else { 0 };
    print("  pass    ${exp_ok}");

    // Negative controls
    let neg = negative_controls(actors0, charter);
    print("");
    print("NEGATIVE CONTROLS");
    hr();
    print("  passed  ${neg[0]}");
    print("  failed  ${neg[1]}");
    let neg_ok = if neg[0] == 10 && neg[1] == 0 { 1 } else { 0 };

    // Public journal must not contain private secrets strings
    let leak = 0;
    for r in journal {
        if contains(r.target_digest, "AWS_SECRET") { leak = leak + 1; }
        if contains(r.target_digest, "kubectl") { leak = leak + 1; }
        if contains(r.target_digest, "webhook.evil") { leak = leak + 1; }
    }
    let no_leak = if leak == 0 { 1 } else { 0 };

    // Private store size equals journal size
    let priv_ok = if len(priv) == len(journal) { 1 } else { 0 };

    // Freeze exercised
    let freeze_ok = if frozen == 1 && abort_n >= 1 { 1 } else { 0 };

    // Deny declass path exercised
    let deny_ok = if deny_n >= 1 { 1 } else { 0 };

    // Hold path exercised
    let hold_ok = if hold_n >= 1 { 1 } else { 0 };

    // Allow path exercised
    let allow_ok = if allow_n >= 1 { 1 } else { 0 };

    // Chain advanced
    let chain_ok = if chain > policy_id(charter.policy_version) { 1 } else { 0 };

    // Hybrid honesty: executed must be 0
    let hybrid_ok = if hybrid_plan.executed == 0 && hybrid_plan.planned == 1 { 1 } else { 0 };

    let seals = exp_ok + neg_ok + no_leak + priv_ok + freeze_ok + deny_ok + hold_ok + allow_ok + chain_ok + hybrid_ok;

    print("");
    print("INVARIANT SEALS");
    hr();
    print("  expected_outcomes     ${exp_ok}");
    print("  negative_controls     ${neg_ok}");
    print("  no_public_secret_leak ${no_leak}");
    print("  private_parity        ${priv_ok}");
    print("  freeze_on_abort       ${freeze_ok}");
    print("  deny_exercised        ${deny_ok}");
    print("  hold_exercised        ${hold_ok}");
    print("  allow_exercised       ${allow_ok}");
    print("  chain_advanced        ${chain_ok}");
    print("  hybrid_honest         ${hybrid_ok}");
    print("  seal_score            ${seals}/10");

    let verdict = if seals == 10 {
        "NEXUS_KERNEL_CERTIFIED"
    } else if seals >= 8 {
        "NEXUS_KERNEL_DEGRADED"
    } else {
        "NEXUS_KERNEL_REJECTED"
    };

    print("");
    hr();
    print("  VERDICT: ${verdict}");
    print("  SUMMARY: allow=${allow_n} watch=${watch_n} hold=${hold_n} deny=${deny_n} abort=${abort_n} chain=${chain} seals=${seals}/10 frozen=${frozen}");
    print("  PUBLIC_ROOT: ${chain}");
    print("  POLICY: v${charter.policy_version}  AUTH: ${charter.auth}");
    hr();
    print("Boundary: offline Anubis safe execution; fuel_tick/clamp_score/policy_id/advance_receipt carry SMT contracts.");
    print("Not claimed: live tool mediation, institutional deployment authority, or full-engine formal proof.");
    print("Companion: examples/industry/nexus_zk_decision.anb (minimal public decision journal shape).");

    if seals == 10 {
        return 0;
    }
    return 1;
}
