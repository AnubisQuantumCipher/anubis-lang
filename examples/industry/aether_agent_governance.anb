// =============================================================================
// AETHER — Agent Evidence-Tracked Execution & Release Authority
// =============================================================================
//
// Industry domain: AI-agent / autonomous-system governance (2026 critical need).
//
// Every coding agent, swarm worker, and tool-calling LLM that can touch:
//   - production deploys
//   - key material / Keychain
//   - fund movements
//   - external disclosure (bug bounty, press, regulators)
//   - shell / network / filesystem
// is today mostly governed by soft prompts and hope.
//
// AETHER is a deterministic, offline policy kernel that:
//   1) Registers agents with capability scopes and trust floors
//   2) Classifies each tool-call by risk class + irreversibility
//   3) Propagates taint from untrusted sources (web, user paste, third-party tools)
//   4) Enforces dual-control (second human/key) on irreversible actions
//   5) Quarantines agents that breach policy or climb a compromise kill-chain
//   6) Hash-chains every decision into a tamper-evident receipt ledger
//   7) Emits an operator verdict with same-evaluator reverse audit + negative controls
//
// This is NOT a live agent runtime and does NOT execute tools. It is the
// decision-and-evidence kernel that should sit in front of any agent that
// can cause irreversible harm.
//
// Run:   ./target/release/anubis run examples/industry/aether_agent_governance.anb
// Check: ./target/release/anubis check examples/industry/aether_agent_governance.anb
//
// Honest boundary: ordinary safe execution + SMT contract on severity clamp.
// Not a RISC0 proof of the full simulator; not production authorization.
// =============================================================================

// --- Risk class of a tool capability ----------------------------------------
enum RiskClass {
    ReadOnly,        // inspect, summarize, list
    MutableLocal,    // write local files, edit repo (reversible-ish)
    Privileged,      // shell, network, credentials read
    Irreversible,    // deploy, transfer funds, submit disclosure, key use
}

// --- Taint origin of an input or intermediate value -------------------------
enum TaintOrigin {
    Clean,           // operator-authored, sealed internal state
    UserPaste,       // human paste into chat (can carry prompt injection)
    WebFetch,        // untrusted remote content
    ToolOutput,      // previous tool result (may be poisoned)
    Compromised,     // elevated after policy breach / anomaly
}

// --- Decision the kernel may emit for one action ----------------------------
enum Decision {
    Allow { receipt: int },
    AllowWithWitness { receipt: int, witness_id: string },
    Deny { code: int, reason: string },
    Quarantine { agent: string, code: int },
}

// --- Kill-chain phase for agent compromise / abuse --------------------------
enum AgentPhase {
    Benign,
    Probe,           // capability enumeration / scope testing
    Escalate,        // attempting privileged tools without need
    Exfil,           // trying to leak secrets or outbound payload
    Irrev,           // attempting irreversible action under taint
}

// --- Static capability catalog entry ----------------------------------------
struct Cap {
    name: string,
    risk: RiskClass,
    min_trust: int,      // 0..100 agent trust floor required
    needs_witness: int,  // 1 = dual-control required
}

// --- Registered agent identity ----------------------------------------------
struct Agent {
    id: string,
    role: string,
    trust: int,          // 0..100
    scopes: list,        // list of capability name strings
    active: int,         // 1 active, 0 quarantined
}

// --- One proposed tool-call (the unit of adjudication) ----------------------
struct Action {
    seq: int,
    agent_id: string,
    cap: string,
    target: string,
    taint: TaintOrigin,
    claimed_need: string,
    witness: string,     // empty string if none; human/key id if dual-control present
}

// --- One sealed receipt row in the ledger -----------------------------------
struct Receipt {
    seq: int,
    agent_id: string,
    cap: string,
    decision_code: int,  // 0 allow, 1 allow+witness, 2 deny, 3 quarantine
    taint_code: int,
    risk_code: int,
    phase_code: int,
    chain: int,          // rolling hash after this row
}

// =============================================================================
// SMT-PROVEN helpers — fail-closed contracts the checker can discharge
// =============================================================================

// Severity/trust clamp: never silently deflate a score under the load bound.
fn clamp_score(x: u32) -> u32 requires(x < 1000000) ensures(result >= x) {
    return x + 0;
}

// Dual-control witness acceptance: non-empty witness id and trust floor.
fn witness_ok(witness: string, agent_trust: u32) -> u32
    requires(agent_trust < 1000000)
    ensures(result >= 0)
{
    if len(witness) > 0 {
        if agent_trust >= 50 {
            return 1;
        }
        return 0;
    }
    return 0;
}

// =============================================================================
// Encoding / utilities
// =============================================================================

fn risk_code(r) {
    match r {
        RiskClass::ReadOnly => 1,
        RiskClass::MutableLocal => 2,
        RiskClass::Privileged => 3,
        RiskClass::Irreversible => 4,
    }
}

fn risk_name(r) {
    match r {
        RiskClass::ReadOnly => "READ_ONLY",
        RiskClass::MutableLocal => "MUTABLE_LOCAL",
        RiskClass::Privileged => "PRIVILEGED",
        RiskClass::Irreversible => "IRREVERSIBLE",
    }
}

fn taint_code(t) {
    match t {
        TaintOrigin::Clean => 0,
        TaintOrigin::UserPaste => 1,
        TaintOrigin::WebFetch => 2,
        TaintOrigin::ToolOutput => 3,
        TaintOrigin::Compromised => 4,
    }
}

fn taint_name(t) {
    match t {
        TaintOrigin::Clean => "CLEAN",
        TaintOrigin::UserPaste => "USER_PASTE",
        TaintOrigin::WebFetch => "WEB_FETCH",
        TaintOrigin::ToolOutput => "TOOL_OUTPUT",
        TaintOrigin::Compromised => "COMPROMISED",
    }
}

fn phase_code(p) {
    match p {
        AgentPhase::Benign => 0,
        AgentPhase::Probe => 1,
        AgentPhase::Escalate => 2,
        AgentPhase::Exfil => 3,
        AgentPhase::Irrev => 4,
    }
}

fn phase_name(p) {
    match p {
        AgentPhase::Benign => "BENIGN",
        AgentPhase::Probe => "PROBE",
        AgentPhase::Escalate => "ESCALATE",
        AgentPhase::Exfil => "EXFIL",
        AgentPhase::Irrev => "IRREVERSIBLE_ATTEMPT",
    }
}

fn decision_code(d) {
    match d {
        Decision::Allow { receipt: _r } => 0,
        Decision::AllowWithWitness { receipt: _r, witness_id: _w } => 1,
        Decision::Deny { code: _c, reason: _s } => 2,
        Decision::Quarantine { agent: _a, code: _c } => 3,
    }
}

fn abs_i(x) {
    if x < 0 { 0 - x } else { x }
}

fn max_i(a, b) {
    if a > b { a } else { b }
}

fn min_i(a, b) {
    if a < b { a } else { b }
}

// Rolling chain: h = ((h * 131) + x) mod 1_000_000_007  (non-crypto seal seed)
fn chain_step(acc, x) {
    return ((acc * 131) + x) % 1000000007;
}

fn list_contains(xs, needle) {
    for x in xs {
        if x == needle { return 1; }
    }
    return 0;
}

fn find_agent(agents, id) {
    let i = 0;
    let n = len(agents);
    while i < n {
        if agents[i].id == id {
            return Some(agents[i]);
        }
        i = i + 1;
    }
    return None;
}

fn find_cap(caps, name) {
    let i = 0;
    let n = len(caps);
    while i < n {
        if caps[i].name == name {
            return Some(caps[i]);
        }
        i = i + 1;
    }
    return None;
}

// Replace agent row by id (by-value list rebuild).
fn set_agent_active(agents, id, active_flag) {
    let out = [];
    for a in agents {
        if a.id == id {
            push(out, Agent {
                id: a.id,
                role: a.role,
                trust: a.trust,
                scopes: a.scopes,
                active: active_flag,
            });
        } else {
            push(out, a);
        }
    }
    return out;
}

fn set_agent_trust(agents, id, new_trust) {
    let out = [];
    for a in agents {
        if a.id == id {
            push(out, Agent {
                id: a.id,
                role: a.role,
                trust: new_trust,
                scopes: a.scopes,
                active: a.active,
            });
        } else {
            push(out, a);
        }
    }
    return out;
}

// =============================================================================
// Policy: compromise phase inference from action + history counts
// =============================================================================

// Counts map: agent_id -> [probe, escalate, exfil, irrev_attempts]
fn bump_phase_counts(counts, agent_id, phase) {
    let cur = get(counts, agent_id, [0, 0, 0, 0]);
    let p = cur[0];
    let e = cur[1];
    let x = cur[2];
    let ir = cur[3];
    match phase {
        AgentPhase::Probe => { p = p + 1; },
        AgentPhase::Escalate => { e = e + 1; },
        AgentPhase::Exfil => { x = x + 1; },
        AgentPhase::Irrev => { ir = ir + 1; },
        AgentPhase::Benign => { p = p; },
    }
    let next = counts;
    next[agent_id] = [p, e, x, ir];
    return next;
}

// Infer the *attempted* phase of this single action (before aggregate).
fn infer_action_phase(cap_risk, taint, target) {
    let tgt = lower(target);
    // Exfil patterns on target strings (destination / sink hints)
    if contains(tgt, "exfil") || contains(tgt, "webhook.evil") || contains(tgt, "pastebin") || contains(tgt, "0xdead") {
        return AgentPhase::Exfil;
    }
    match cap_risk {
        RiskClass::Irreversible => {
            if taint_code(taint) >= 1 {
                return AgentPhase::Irrev;
            }
            return AgentPhase::Escalate;
        },
        RiskClass::Privileged => {
            if taint_code(taint) >= 2 {
                return AgentPhase::Escalate;
            }
            return AgentPhase::Probe;
        },
        RiskClass::MutableLocal => {
            if taint_code(taint) >= 2 {
                return AgentPhase::Probe;
            }
            return AgentPhase::Benign;
        },
        RiskClass::ReadOnly => {
            return AgentPhase::Benign;
        },
    }
}

// Aggregate phase for an agent from cumulative counters.
fn peak_agent_phase(counts, agent_id) {
    let cur = get(counts, agent_id, [0, 0, 0, 0]);
    if cur[3] > 0 { return AgentPhase::Irrev; }
    if cur[2] > 0 { return AgentPhase::Exfil; }
    if cur[1] >= 2 { return AgentPhase::Escalate; }
    if cur[0] >= 2 || cur[1] >= 1 { return AgentPhase::Probe; }
    return AgentPhase::Benign;
}

// =============================================================================
// Core adjudicator
// =============================================================================

// Returns [Decision, updated_agents, updated_counts, Receipt]
fn adjudicate(action, agents, caps, counts, chain_acc) {
    // Unknown agent → deny hard
    let maybe_agent = find_agent(agents, action.agent_id);
    let agent = match maybe_agent {
        Some(a) => a,
        None => {
            let d = Decision::Deny { code: 404, reason: "unknown_agent" };
            let rc = Receipt {
                seq: action.seq,
                agent_id: action.agent_id,
                cap: action.cap,
                decision_code: 2,
                taint_code: taint_code(action.taint),
                risk_code: 0,
                phase_code: 0,
                chain: chain_step(chain_acc, action.seq + 404),
            };
            return [d, agents, counts, rc];
        },
    };

    // Quarantined agents cannot act
    if agent.active == 0 {
        let d = Decision::Quarantine { agent: agent.id, code: 423 };
        let rc = Receipt {
            seq: action.seq,
            agent_id: agent.id,
            cap: action.cap,
            decision_code: 3,
            taint_code: taint_code(action.taint),
            risk_code: 0,
            phase_code: phase_code(peak_agent_phase(counts, agent.id)),
            chain: chain_step(chain_acc, action.seq + 423),
        };
        return [d, agents, counts, rc];
    }

    // Unknown capability → deny
    let maybe_cap = find_cap(caps, action.cap);
    let cap = match maybe_cap {
        Some(c) => c,
        None => {
            let d = Decision::Deny { code: 400, reason: "unknown_capability" };
            let rc = Receipt {
                seq: action.seq,
                agent_id: agent.id,
                cap: action.cap,
                decision_code: 2,
                taint_code: taint_code(action.taint),
                risk_code: 0,
                phase_code: 0,
                chain: chain_step(chain_acc, action.seq + 400),
            };
            return [d, agents, counts, rc];
        },
    };

    let rc_risk = risk_code(cap.risk);
    let phase_attempt = infer_action_phase(cap.risk, action.taint, action.target);
    let counts2 = bump_phase_counts(counts, agent.id, phase_attempt);
    let peak = peak_agent_phase(counts2, agent.id);

    // Scope check
    if list_contains(agent.scopes, cap.name) == 0 {
        let d = Decision::Deny { code: 403, reason: "scope_violation" };
        let agents2 = if phase_code(peak) >= 3 {
            set_agent_active(agents, agent.id, 0)
        } else {
            agents
        };
        let d2 = if phase_code(peak) >= 3 {
            Decision::Quarantine { agent: agent.id, code: 403 }
        } else {
            d
        };
        let dc = decision_code(d2);
        let rc = Receipt {
            seq: action.seq,
            agent_id: agent.id,
            cap: action.cap,
            decision_code: dc,
            taint_code: taint_code(action.taint),
            risk_code: rc_risk,
            phase_code: phase_code(peak),
            chain: chain_step(chain_acc, action.seq + 403 + rc_risk * 17),
        };
        return [d2, agents2, counts2, rc];
    }

    // Trust floor
    let trust = clamp_score(agent.trust);
    if trust < cap.min_trust {
        let d = Decision::Deny { code: 401, reason: "trust_floor" };
        let rc = Receipt {
            seq: action.seq,
            agent_id: agent.id,
            cap: action.cap,
            decision_code: 2,
            taint_code: taint_code(action.taint),
            risk_code: rc_risk,
            phase_code: phase_code(peak),
            chain: chain_step(chain_acc, action.seq + 401 + trust),
        };
        return [d, agents, counts2, rc];
    }

    // Compromised taint never leaves ReadOnly without quarantine escalation
    if taint_code(action.taint) >= 4 && rc_risk >= 2 {
        let agents_q = set_agent_active(agents, agent.id, 0);
        let d = Decision::Quarantine { agent: agent.id, code: 451 };
        let rc = Receipt {
            seq: action.seq,
            agent_id: agent.id,
            cap: action.cap,
            decision_code: 3,
            taint_code: 4,
            risk_code: rc_risk,
            phase_code: phase_code(peak),
            chain: chain_step(chain_acc, action.seq + 451),
        };
        return [d, agents_q, counts2, rc];
    }

    // Tainted irreversible / privileged without dual-control → deny or quarantine
    if cap.needs_witness == 1 || rc_risk >= 4 {
        let w = witness_ok(action.witness, trust);
        if w == 0 {
            // If already climbing kill-chain under taint → quarantine
            if taint_code(action.taint) >= 1 && phase_code(peak) >= 3 {
                let agents_q = set_agent_active(agents, agent.id, 0);
                let d = Decision::Quarantine { agent: agent.id, code: 460 };
                let rc = Receipt {
                    seq: action.seq,
                    agent_id: agent.id,
                    cap: action.cap,
                    decision_code: 3,
                    taint_code: taint_code(action.taint),
                    risk_code: rc_risk,
                    phase_code: phase_code(peak),
                    chain: chain_step(chain_acc, action.seq + 460),
                };
                return [d, agents_q, counts2, rc];
            }
            let d = Decision::Deny { code: 428, reason: "dual_control_required" };
            let rc = Receipt {
                seq: action.seq,
                agent_id: agent.id,
                cap: action.cap,
                decision_code: 2,
                taint_code: taint_code(action.taint),
                risk_code: rc_risk,
                phase_code: phase_code(peak),
                chain: chain_step(chain_acc, action.seq + 428),
            };
            return [d, agents, counts2, rc];
        }
        // Dual-control satisfied
        let receipt_id = chain_step(chain_acc, action.seq + rc_risk * 31 + trust);
        let d = Decision::AllowWithWitness {
            receipt: receipt_id,
            witness_id: action.witness,
        };
        let rc = Receipt {
            seq: action.seq,
            agent_id: agent.id,
            cap: action.cap,
            decision_code: 1,
            taint_code: taint_code(action.taint),
            risk_code: rc_risk,
            phase_code: phase_code(peak),
            chain: receipt_id,
        };
        return [d, agents, counts2, rc];
    }

    // Privileged under web/tool taint without clean claim → deny
    if rc_risk >= 3 && taint_code(action.taint) >= 2 {
        let d = Decision::Deny { code: 409, reason: "tainted_privileged" };
        let rc = Receipt {
            seq: action.seq,
            agent_id: agent.id,
            cap: action.cap,
            decision_code: 2,
            taint_code: taint_code(action.taint),
            risk_code: rc_risk,
            phase_code: phase_code(peak),
            chain: chain_step(chain_acc, action.seq + 409),
        };
        return [d, agents, counts2, rc];
    }

    // Default allow for in-scope, trust-ok, non-witness tools
    let receipt_id = chain_step(chain_acc, action.seq + rc_risk * 13 + trust);
    let d = Decision::Allow { receipt: receipt_id };
    let rc = Receipt {
        seq: action.seq,
        agent_id: agent.id,
        cap: action.cap,
        decision_code: 0,
        taint_code: taint_code(action.taint),
        risk_code: rc_risk,
        phase_code: phase_code(peak),
        chain: receipt_id,
    };
    return [d, agents, counts2, rc];
}

// =============================================================================
// Batch engine: process a full engagement action stream
// =============================================================================

fn process_stream(actions, agents, caps) {
    let ledger = [];
    let counts = {};
    let chain = 1;
    let agents_cur = agents;
    let allowed = 0;
    let witnessed = 0;
    let denied = 0;
    let quarantined = 0;
    let i = 0;
    let n = len(actions);
    while i < n {
        let act = actions[i];
        let res = adjudicate(act, agents_cur, caps, counts, chain);
        let dec = res[0];
        agents_cur = res[1];
        counts = res[2];
        let rc = res[3];
        chain = rc.chain;
        push(ledger, rc);
        let dc = decision_code(dec);
        if dc == 0 { allowed = allowed + 1; }
        if dc == 1 { witnessed = witnessed + 1; }
        if dc == 2 { denied = denied + 1; }
        if dc == 3 { quarantined = quarantined + 1; }
        i = i + 1;
    }
    return {
        "ledger": ledger,
        "agents": agents_cur,
        "counts": counts,
        "chain": chain,
        "allowed": allowed,
        "witnessed": witnessed,
        "denied": denied,
        "quarantined": quarantined,
    };
}

// Same-evaluator reverse traversal: re-run actions in reverse order with a
// fresh agent state for consistency of the *adjudicator pure function* on
// each isolated action (not full causal replay — labeled honestly).
fn reverse_isolated_tally(actions, agents, caps) {
    let allowed = 0;
    let denied = 0;
    let i = len(actions) - 1;
    while i >= 0 {
        let act = actions[i];
        let res = adjudicate(act, agents, caps, {}, 1);
        let dc = decision_code(res[0]);
        if dc == 0 || dc == 1 { allowed = allowed + 1; }
        if dc == 2 || dc == 3 { denied = denied + 1; }
        i = i - 1;
    }
    return [allowed, denied, allowed + denied];
}

