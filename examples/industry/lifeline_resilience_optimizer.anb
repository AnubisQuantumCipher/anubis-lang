// =============================================================================
// LIFELINE — CRITICAL-INFRASTRUCTURE CASCADE & RECOVERY OPTIMIZER
// =============================================================================
//
// Purpose
// -------
// LIFELINE is an offline, deterministic decision-support kernel for planning
// recovery after a compound disaster. It models coupled power, water, health,
// communications, fuel, shelter, wastewater, cooling, and cold-chain assets.
// It then:
//
//   1. validates the embedded model before any indexed access;
//   2. simulates monotone cascading failures to a bounded fixed point;
//   3. scores human impact with criticality and vulnerability weights;
//   4. exactly enumerates all 2^10 recovery portfolios;
//   5. enforces budget, crew, fuel, prerequisite, and equity constraints;
//   6. minimizes a lexicographic robust objective across four hazards;
//   7. ranks single points of failure and pairwise cascade synergy;
//   8. re-enumerates in reverse with the same evaluator as a traversal check;
//   9. rejects a deliberately over-budget tampered plan; and
//  10. emits a deterministic, non-cryptographic model certificate.
//
// Honest boundary
// ---------------
// This is a computational reference kernel with embedded demonstration data.
// It does not ingest live telemetry, control infrastructure, estimate deaths,
// solve an unbounded global planning problem, or replace emergency managers.
// Its exactness claim is only over the ten candidate actions and constraints
// declared below. The rolling seal is an audit checksum, not cryptography.
// The Anubis evidence bundle supplies the external tamper-evident envelope.
// =============================================================================


// -----------------------------------------------------------------------------
// 1. SMALL CONTRACT KERNEL — obligations suitable for Anubis's bounded solver
// -----------------------------------------------------------------------------

fn risk_join(a: u64, b: u64) -> u64
    requires(a >= 0) requires(a < 500000)
    requires(b >= 0) requires(b < 500000)
    ensures(result >= a) ensures(result >= b) {
    return a + b;
}

fn fuel_tick(fuel: u64) -> u64
    requires(fuel > 0) requires(fuel < 1000000)
    ensures(result >= 0) ensures(result < fuel) {
    return fuel - 1;
}

fn remaining_budget(budget: u64, used: u64) -> u64
    requires(budget >= 0) requires(budget < 1000000)
    requires(used >= 0) requires(used <= budget)
    ensures(result >= 0) ensures(result <= budget) {
    return budget - used;
}

fn service_gap(demand: u64, available: u64) -> u64
    requires(demand >= 0) requires(demand < 1000000)
    requires(available >= 0) requires(available <= demand)
    ensures(result >= 0) ensures(result <= demand) {
    return demand - available;
}


// -----------------------------------------------------------------------------
// 2. MODEL TYPES
// -----------------------------------------------------------------------------

enum Sector {
    Power,
    Water,
    Healthcare,
    Telecom,
    Fuel,
    Shelter,
    Wastewater,
    Cooling,
    ColdChain,
}

enum PlanVerdict {
    Certified { checksum: int },
    BudgetLimited { feasible_candidates: int },
    AuditRejected { code: int },
    InvalidModel { code: int },
}

struct Asset {
    id: int,
    name: string,
    sector: Sector,
    zone: string,
    population: int,
    demand_pct: int,
    criticality: int,
    vulnerability: int,
    hard_floor_pct: int,
}

struct Dependency {
    upstream: int,
    downstream: int,
    trigger_pct: int,
    base_impact_pct: int,
    slope_pct: int,
    label: string,
}

struct Scenario {
    id: int,
    name: string,
    probability_bps: int,
    surge_pct: int,
    initial_pct: list,
}

struct Action {
    id: int,
    asset: int,
    name: string,
    cost_units: int,
    crew_hours: int,
    fuel_units: int,
    restore_pct: int,
    floor_pct: int,
    prerequisites: list,
}

struct Simulation {
    availability: list,
    causes: list,
    loss: int,
    equity_loss: int,
    hard_violations: int,
    people_equivalent_served: int,
    cascade_rounds: int,
    converged: int,
    checksum: int,
}

struct PlanScore {
    mask: int,
    cost: int,
    crew: int,
    fuel: int,
    equity_actions: int,
    action_count: int,
    prerequisites_ok: int,
    feasible: int,
    hard_violations: int,
    worst_loss: int,
    expected_loss: int,
    equity_loss: int,
    objective: int,
    checksum: int,
}

struct Optimization {
    best: PlanScore,
    candidate_count: int,
    feasible_count: int,
}

struct AuditResult {
    recompute_match: int,
    deterministic: int,
    globally_optimal: int,
    improves_baseline: int,
    model_negative_rejected: int,
    powers_negative_rejected: int,
    overflow_negative_rejected: int,
    tamper_negative_rejected: int,
    checksum: int,
    ok: int,
}


// -----------------------------------------------------------------------------
// 3. INTEGER AND COLLECTION UTILITIES
// -----------------------------------------------------------------------------

fn min_i(a, b) {
    if a < b { return a; }
    return b;
}

fn max_i(a, b) {
    if a > b { return a; }
    return b;
}

fn clamp_pct(x) {
    if x < 0 { return 0; }
    if x > 100 { return 100; }
    return x;
}

fn zeros(n) {
    let mut xs = [];
    let mut i = 0;
    while i < n {
        push(xs, 0);
        i = i + 1;
    }
    return xs;
}

fn filled(n, value) {
    let mut xs = [];
    let mut i = 0;
    while i < n {
        push(xs, value);
        i = i + 1;
    }
    return xs;
}

fn selected(mask, power) {
    if (mask & power) != 0 { return 1; }
    return 0;
}

fn rolling_seal(values) {
    let mut h = 104729;
    let mut i = 0;
    while i < len(values) {
        let v = values[i] + 1000003;
        h = ((h * 131) + v) % 2147483647;
        i = i + 1;
    }
    if h < 0 { return 0 - h; }
    return h;
}

fn sector_name(sector) {
    match sector {
        Sector::Power => "power",
        Sector::Water => "water",
        Sector::Healthcare => "healthcare",
        Sector::Telecom => "telecom",
        Sector::Fuel => "fuel",
        Sector::Shelter => "shelter",
        Sector::Wastewater => "wastewater",
        Sector::Cooling => "cooling",
        Sector::ColdChain => "cold_chain",
    }
}


