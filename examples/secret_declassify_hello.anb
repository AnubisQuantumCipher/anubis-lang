// Day-one secret construction (the correct forms — not `secret(42)`).
//
// Secrets are a TYPE QUALIFIER `secret<T>`, not a constructor named `secret`.
// Two ways to mint a confidential value:
//   1. Annotated literal / expression:  let s: secret<i64> = 42;
//   2. Explicit source:                 let s = secret_source(42);
//
// A secret may not reach egress (`print`, network, shell, …) without
// declassify(value, policy, reason) where policy and reason are non-empty.
//
//   ./target/release/anubis check examples/secret_declassify_hello.anb
//   ./target/release/anubis run   examples/secret_declassify_hello.anb
//
// Negative control (must FAIL check): print the secret without declassify.

fn main() {
    // Form 1 — typed secret literal (same style as NEXUS showcase)
    let held: secret<i64> = 42;
    // Form 2 — explicit confidentiality source
    let minted = secret_source(7);

    let a = declassify(held, "tutorial", "demo only — not a production policy");
    let b = declassify(minted, "tutorial", "demo only — not a production policy");
    print(a + b); // → 49
}
