// EXPECT: FAIL
// ERROR_CONTAINS: ANUBIS_TAINTED_SINK_WITHOUT_DECLASSIFY
// W2.1 reduced integrity loop join: loop-updated array alternatives must reach a later return.
struct P { k: i64 }
struct S { k: tainted<i64> }

fn leak() {
    let mut xs = [P { k: 0 }];
    let mut i = 0;
    while i < 1 {
        xs = [S { k: 7 }];
        i = i + 1;
    }
    return xs[0].k;
}

fn main() uses(shell) {
    shell(leak());
}
