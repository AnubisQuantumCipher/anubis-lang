// EXPECT: PASS
// Tier 1 over-rejection guard for H5. The identical branch-forwarder shape carrying a NON-secret,
// non-capturing closure must still compile. H5 makes the registry accept MORE functions as forwarders,
// so the risk it introduces is a false reject on an innocent forwarder — not a missed leak.
fn fwd_same(cond, f) {
    if cond {
        return f;
    } else {
        return f;
    }
}
fn main() {
    let g = fwd_same(true, |x| x + 1);
    print(g(41));
}
