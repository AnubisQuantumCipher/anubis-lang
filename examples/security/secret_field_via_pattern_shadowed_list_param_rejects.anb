// EXPECT: FAIL
// ERROR_CONTAINS: ANUBIS_SECRET_EXFILTRATION
// W2.1 shadow identity: a spanless pattern binder updated in its arm must not replace a typed parameter.
struct P { k: i64 }
struct S { k: secret<i64> }

fn leak(xs: list<S>) {
    match 0 {
        xs => { xs = [P { k: 0 }]; }
    };
    print(xs[0].k);
}

fn main() {
    leak([S { k: 7 }]);
}
