// EXPECT: PASS
// Tier 1 over-rejection guard for H2/H3. A method forwarder carrying a harmless closure must still
// compile. The self-offset arithmetic is the specific risk here: a method summary's parameter list
// includes `self` at index 0, so the arity guard is `pnames.len() == args.len() + 1` and the forwarded
// argument is `args[i-1]` for i>=1. Getting that off by one would resolve the WRONG argument — which on
// this fixture would resolve the receiver instead of the closure, and on a secret fixture would silently
// resolve nothing. Both directions need a witness; this is the accept-side one.
struct W { id: u32 }
impl W {
    fn fwd(self, f) { return f; }
}
fn main() {
    let w = W { id: 1 };
    let g = w.fwd(|x| x + 1);
    print(g(41));
}
