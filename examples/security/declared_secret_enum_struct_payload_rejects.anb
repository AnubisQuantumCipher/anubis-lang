// EXPECT: FAIL
// ERROR_CONTAINS: ANUBIS_SECRET_EXFILTRATION
// D4, struct-variant form. Kept separate from the tuple form because the two payload shapes take
// different lookup paths — positional index versus field name — and closing one without the other
// would leave a working launder path behind a green fixture.
enum E { A { s: secret<i64> }, B }
fn main() {
    let e = E::A { s: 42 };
    match e {
        E::A { s } => { print(s); }
        E::B => { print(0); }
    }
}
