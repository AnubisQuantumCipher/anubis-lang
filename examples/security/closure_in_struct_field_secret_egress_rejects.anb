// EXPECT: FAIL
// ERROR_CONTAINS: ANUBIS_SECRET_EXFILTRATION
// Soundness hunt 2026-07-19 (#48-h): a closure that captures a secret, stored in a STRUCT FIELD and
// applied via `b.f(0)`, must carry its captured secret to the egress. The field-closure effect descent
// charged the body's own effects but never marked the APPLICATION RESULT secret, so `send(h, p, b.f(0))`
// saw a clean argument and evaded ANUBIS_SECRET_EXFILTRATION. Fixed by resolving the field-stored
// lambda in `expr_secret_source_m`'s CallExpr arm (twin of the var-bound closure rule).
struct Box { f: u64 }
fn run(k: secret<u64>) uses(net.send) {
    let g = |x| k;
    let b = Box { f: g };
    send("host", 80, b.f(0));
}
fn main() { }
