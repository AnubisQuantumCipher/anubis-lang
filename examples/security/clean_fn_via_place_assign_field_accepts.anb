// EXPECT: PASS
// Over-rejection guard for the Phase 4 place-assignment write-carrier fix (CLAIMS item 21 row 6):
// a genuinely CLEAN function reference stored into a struct field by place-assignment and applied
// must still ACCEPT. If a future change makes fn_alias_of_d's FieldAccess/Index arm blanket-reject
// every field-stored callable rather than only label-dangerous ones, this fixture flips to FAIL
// and catches the over-rejection before it ships.
struct Box { f: u64 }
fn safe() -> i64 { return 42; }
fn main() {
    let b = Box { f: 0 };
    b.f = safe;
    let g = b.f;
    print(g());
}
