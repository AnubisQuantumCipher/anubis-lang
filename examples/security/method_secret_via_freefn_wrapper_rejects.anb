// EXPECT: FAIL
// ERROR_CONTAINS: ANUBIS_SECRET_EXFILTRATION
// #71 joint return-summary fixpoint. A FREE function whose returned secret arrives from an impl
// METHOD. The free-fn and method return-secret summaries used to be STAGED (free-fn first, with an
// EMPTY method set), so `grab` was never marked secret-returning and `send(grab(v))` checked clean
// while the direct `send(v.key())` was correctly rejected. Both directions now converge together.
struct V { k: u32 }
impl V {
    fn key(self) { return secret_source("api_key"); }
}
fn grab(v) { return v.key(); }
fn main() uses(net.send) {
    let v = V { k: 1 };
    send("host", 80, grab(v));
}
