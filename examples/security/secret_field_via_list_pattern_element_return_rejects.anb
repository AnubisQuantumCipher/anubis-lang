// EXPECT: FAIL
// ERROR_CONTAINS: ANUBIS_SECRET_EXFILTRATION
// W2.1 pattern projection: a list-element binder inherits the matched list's exact element alternatives.
struct S { k: secret<i64> }

fn leak() {
    let xs = [S { k: 7 }];
    match xs {
        [item] => { return item.k; }
        _ => { return 0; }
    }
}

fn main() {
    print(leak());
}
