// EXPECT: FAIL
// ERROR_CONTAINS: ANUBIS_SECRET_EXFILTRATION
// Soundness hunt2 2026-07-19: a secret-capturing closure stored a level deep (Outer.inner.f) and
// applied via o.inner.f(0) must carry its secret to egress. The field-closure source rule now keys
// closures by a dotted ACCESS PATH (collect_container_closures) and resolves the callee's access
// chain (flatten_access_path), so nested/indexed/mapped applications all descend.
struct Inner { f: u64 }
struct Outer { inner: Inner }
fn run(k: secret<u64>) uses(net.send) {
    let g = |x| k;
    let o = Outer { inner: Inner { f: g } };
    send("host", 80, o.inner.f(0));
}
fn main() { }
