// EXPECT: FAIL
// ERROR_CONTAINS: ANUBIS_SECRET_EXFILTRATION
// GROK-SEKHMET round 9, free hunt. An impl method's `self` parameter carries NO declared type, so
// `self.k` had no struct type to key on and a field declared `secret<T>` was ignored entirely.
// The D1/D2/D3 work taught call RESULTS to resolve and left the RECEIVER itself untyped — which is
// the most ordinary way to read a field in this language, and the one nobody had probed.
// `self` now inherits the impl's type name at the analysis boundary.
struct S { k: secret<i64> }
impl S {
    fn leak(self) { print(self.k); }
}
fn main() {
    let s = S { k: 42 };
    s.leak();
}
