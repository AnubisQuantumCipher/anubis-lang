// EXPECT: FAIL
// ERROR_CONTAINS: ANUBIS_SECRET_EXFILTRATION
// The interprocedural face of the `while let` residual: a declared payload extracted through a
// `while let` and RETURNED leaked at the CALL SITE, because the summary walkers' loop arm recursed
// into the body without seeding the pattern it binds.
// Fourth instance in this arc of an enforcing lane being fixed while its summary sibling was not,
// which is why every pattern-binding construct is now checked in both.
enum E { Box(secret<i64>), Empty }
fn take(e: E) {
    let mut cur = e;
    while let E::Box(x) = cur {
        return x;
    }
    return 0;
}
fn main() {
    print(take(E::Box(42)));
}
