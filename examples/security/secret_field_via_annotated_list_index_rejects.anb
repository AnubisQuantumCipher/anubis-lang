// CLAIMS 21 root cause 8 — the INDEX carrier.
//
// `place_struct_type` matched Var/FieldAccess/Call/CallExpr and then `_ => None`, with no
// `Expr::Index` arm. So for `xs[0].k` the enclosing FieldAccess's `?` short-circuited on the
// base, the declared `secret<i64>` on field `k` was never looked up, and the qualifier went
// uncharged. Runtime-proven before the fix: `check` exited 0 and `run` printed 7.
//
// EXPECT: FAIL
// ERROR_CONTAINS: ANUBIS_SECRET_EXFILTRATION
struct S { k: secret<i64> }

fn main() {
    let xs: list<S> = [S { k: 7 }];
    print(xs[0].k);
}
