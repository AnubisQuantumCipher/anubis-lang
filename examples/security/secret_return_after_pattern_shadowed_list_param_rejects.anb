// EXPECT: FAIL
// ERROR_CONTAINS: ANUBIS_SECRET_EXFILTRATION
// W2.1 summary shadow identity: an arm-local binder update must not replace a typed parameter.
struct P { k: i64 }
struct S { k: secret<i64> }

fn keep_secret(xs: list<S>) {
    match 0 {
        xs => { xs = [P { k: 0 }]; }
    };
    return xs[0].k;
}

fn main() {
    print(keep_secret([S { k: 7 }]));
}
