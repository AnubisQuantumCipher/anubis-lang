// EXPECT: PASS
// CORPUS-1 2026-07-27. Over-rejection guard: the callee SHADOWS its own fn-valued parameter with a
// `let` of the same name before ever applying it (`let f = 7;` discards the passed-in secret-returning
// callable and `f` is a plain int from that point on). The fix must track shadowing precisely enough
// that a parameter which is never actually called does not still poison the function — verified this
// prints 7 (the shadow), never touches `key`.
fn key() -> secret<i64> { return 42; }
fn app(f) {
    let f = 7;
    print(f);
}
fn main() { app(key); }
