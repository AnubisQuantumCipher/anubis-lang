// EXPECT: PASS
// Cluster A2 over-rejection guard. Identical loop-wrapped forwarder shape carrying a NON-secret,
// non-capturing closure. The fix makes `tail_values` report MORE possible return values for statement
// kinds it cannot model, which feeds the secret/taint source walkers — so the risk it introduces is a
// false REJECT on an innocent forwarder, not a missed leak.
// Without this guard the three reject-side A2 fixtures would all pass while the compiler had started
// rejecting every program that returns through a loop.
fn fwd_loop(cond, f) {
    while cond {
        return f;
    }
}
fn main() {
    let g = fwd_loop(true, |x| x + 1);
    print(g(41));
}
