// CORPUS-1 2026-07-27. Over-rejection guard: a secret-returning function is passed as a parameter,
// applied, and the result is held in a local that never reaches an egress sink. A secret into a
// LOCAL is not exfiltration — the fix must key on the sink, not on the mere fact that a
// secret-returning callable was applied inside the callee.
fn key() -> secret<i64> { return 42; }
fn app(f) { let v = f(); }
fn main() { app(key); }
