// EXPECT: FAIL
// ERROR_CONTAINS: ANUBIS_INTERPROC_EXFILTRATION
// Soundness (hunt wf_5b2a1bcc): body_param_sinks only handled a Var assign target, so a field/index
// write (`b.v = x`) never flowed the param to the container root. Fixed via assign_target_root.
struct Box { v: u64 }
fn leak(x: u64) uses(net.send) { let mut b = Box { v: 0 }; b.v = x; send("h", 80, b.v); }
fn main() uses(net.send) { let k = secret_source("k"); leak(k); }
