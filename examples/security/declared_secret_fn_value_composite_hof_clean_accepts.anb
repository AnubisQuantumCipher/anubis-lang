// EXPECT: PASS
// CORPUS-1 2026-07-27. Over-rejection guard: a COMPOSITE higher-order path with no secret anywhere —
// a plain function aliased, stored in a struct field, read back off the field, and passed as a
// parameter to be applied. Stresses the general fn-value-through-a-boundary machinery under several
// mechanisms at once (alias + struct field + param) with nothing to reject, so a fix scoped too
// broadly to "any fn value crossing any boundary" would false-positive here even without a secret.
struct Box { f: u64 }
fn plain() -> i64 { return 9; }
fn app(f) { print(f()); }
fn main() {
    let g = plain;
    let b = Box { f: g };
    app(b.f);
}
