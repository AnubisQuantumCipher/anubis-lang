// Soundness hunt 2026-07-19: a secret passed through a FUNCTION-VALUE ALIAS of a user egress function
// (`let f = leak; f(k)`) laundered past the interproc egress check, which keyed only on the callee
// NAME. Fixed by resolving the alias (ScopeBinding.fn_alias) so `f(k)` consults `leak`'s param-egress
// summary. Direct `leak(k)` was already rejected — only the alias defeated it.
fn leak(h: string, p: u32, x: u64) uses(net.send) { send(h, p, x); }
fn run(k: secret<u64>) uses(net.send) {
    let f = leak;
    f("host", 80, k);
}
fn main() { }
