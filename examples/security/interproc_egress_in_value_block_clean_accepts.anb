// Over-rejection guard: a value-block egress of a CONSTANT (not the param) must still compile.
// Param is secret<T> so the call is not ANUBIS_SECRET_TO_PUBLIC; the point is send(42) is not
// exfiltration of k (egress-of-constant precision).
fn go(cmd: secret<u64>) uses(net.send) {
    let z = if true { let mut i = 0; while i < 1 { send("host", 80, 42); i = i + 1; } 0 } else { 0 };
}
fn run(k: secret<u64>) uses(net.send) { go(k); }
fn main() { }
