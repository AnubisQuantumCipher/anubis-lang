// EXPECT: FAIL
// ERROR_CONTAINS: ANUBIS_SECRET_EXFILTRATION
// W1 return-summary parity: a plain annotated container parameter must retain its nominal element
// type while an omitted-return function summarizes an indexed declared-secret field.
struct S { k: secret<i64> }

fn peel(xs: list<S>) {
    return xs[0].k;
}

fn main() {
    let xs: list<S> = [S { k: 7 }];
    print(peel(xs));
}
