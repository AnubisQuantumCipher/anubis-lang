// EXPECT: PASS
// FEATURE: pwn packing surface (p8/p16/p32/p64 + cyclic + list concat)
// Safe to run with --allow-research; no process spawn required.
// Note: hex integer literals are not in the parser yet — use decimal.

@research(
  authorization: "local-lab",
  scope: "local-fixture",
  reason: "packing unit smoke",
  non_destructive: true
)
fn main() {
    // 0x41414141 = 1094795585 ("AAAA" little-endian)
    let a = p32(1094795585);
    // 0x4242424242424242 = 4774451407313060418
    let b = p64(4774451407313060418);
    let c = cyclic(4);
    let payload = a + b + c;
    print(len(payload));
    print(payload[0]);
    print(payload[3]);
}
