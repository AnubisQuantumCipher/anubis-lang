// EXPECT: FAIL
// ERROR_CONTAINS: ANUBIS_SECRET_EXFILTRATION
// hunt2: reassigning a container to one holding a secret closure refreshes field_closures, so the
// new closure's captured secret is seen at b.f(0) (stale-closure laundering closed).
struct Box { f: u64 }
fn run(k: secret<u64>) uses(net.send) {
    let mut b = Box { f: |x| 0 };
    let h = |x| k;
    b = Box { f: h };
    send("host", 80, b.f(0));
}
fn main() { }
