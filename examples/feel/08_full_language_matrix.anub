// =============================================================================
// ANUBIS FULL LANGUAGE MATRIX
// =============================================================================
// Exercises every major ordinary-run surface of Anubis in one program.
// Each section prints PASS/FAIL lines and returns [pass, fail].
// Research / prove / AOP need separate CLI tools — noted in the seal footer.
// =============================================================================

struct Matrix { lines: list, pass: int, fail: int }

impl Matrix {
    fn note(self, msg) {
        let mut ls = self.lines;
        push(ls, msg)
        Matrix { lines: ls, pass: self.pass, fail: self.fail }
    }
    fn add(self, pf) {
        Matrix {
            lines: self.lines,
            pass: self.pass + pf[0],
            fail: self.fail + pf[1],
        }
    }
    fn dump(self) {
        for i in 0..len(self.lines) {
            print(self.lines[i])
        }
        let total = self.pass + self.fail;
        print("--------------------------------------------")
        print("TOTAL pass=${self.pass} fail=${self.fail} total=${total}")
        if self.fail == 0 {
            print("VERDICT: FULL LANGUAGE MATRIX SEALED")
        } else {
            print("VERDICT: FAULTS IN MATRIX")
        }
    }
}

fn check(cond, label) {
    if cond {
        print("  PASS ${label}");
        [1, 0]
    } else {
        print("  FAIL ${label}");
        [0, 1]
    }
}

fn pf_merge(a, b) { [a[0] + b[0], a[1] + b[1]] }

// ----- module (flat namespace) -----------------------------------------------
module matrix_util {
    struct Pair { a: int, b: int }
    fn make_pair(a, b) { Pair { a: a, b: b } }
    fn pair_sum(p) { p.a + p.b }
}

// ----- generics -------------------------------------------------------------
fn max_of<T>(a: T, b: T) -> T where T: Ord {
    if a > b { a } else { b }
}
struct BoxG<T> { value: T }
impl<T> BoxG<T> {
    // avoid method name `get` shadowing map builtin `get`
    fn value_of(self) { self.value }
    fn show(self) { "Box(${self.value})" }
}

// ----- traits ---------------------------------------------------------------
trait Describable {
    fn name(self);
    fn describe(self) { "item:${self.name()}" }
}
trait Measurable {
    fn size(self);
    fn big(self) { self.size() >= 10 }
}

// ----- enums ----------------------------------------------------------------
enum Shape {
    Point,
    Circle(int),
    Rect { w: int, h: int },
}
impl Shape {
    fn area(self) {
        match self {
            Shape::Point => 0,
            Shape::Circle(r) => 3 * r * r,
            Shape::Rect { w: ww, h: hh } => ww * hh,
        }
    }
    fn label(self) {
        match self {
            Shape::Point => "point",
            Shape::Circle(r) => "circle r=${r}",
            Shape::Rect { w: ww, h: hh } => "rect ${ww}x${hh}",
        }
    }
}
impl Describable for Shape {
    fn name(self) { self.label() }
}

struct Agent { id: string, level: int }
impl Describable for Agent {
    fn name(self) { self.id }
}
impl Measurable for Agent {
    fn size(self) { self.level }
}

enum Tree {
    Empty,
    Node { val: int, left: Tree, right: Tree },
}
impl Tree {
    // named `add` not `insert` — method names can shadow free builtins in typecheck
    fn add(self, x) {
        match self {
            Tree::Empty => Tree::Node { val: x, left: Tree::Empty, right: Tree::Empty },
            Tree::Node { val: v, left: l, right: r } => {
                if x < v {
                    Tree::Node { val: v, left: l.add(x), right: r }
                } else if x > v {
                    Tree::Node { val: v, left: l, right: r.add(x) }
                } else {
                    self
                }
            },
        }
    }
    fn inorder(self) {
        match self {
            Tree::Empty => [],
            Tree::Node { val: v, left: l, right: r } => l.inorder() + [v] + r.inorder(),
        }
    }
}

// ----- helpers (top-level only) ---------------------------------------------
fn is_even(n) { if n == 0 { true } else { is_odd(n - 1) } }
fn is_odd(n) { if n == 0 { false } else { is_even(n - 1) } }
fn fib(n: u32) -> u32 {
    if n < 2 { return n }
    fib(n - 1) + fib(n - 2)
}
fn fact(n) { if n <= 1 { 1 } else { n * fact(n - 1) } }
fn typed_add(a: u32, b: u32) -> u32 { a + b }
fn implicit_triple(n) { n * 3 }
fn make_adder(n) { |x| x + n }

fn safe_div(a, b) { if b == 0 { None } else { Some(a / b) } }
fn checked_div(a, b) { if b == 0 { Err("div0") } else { Ok(a / b) } }
fn chain_div(a, b, c, d) {
    let x = safe_div(a, b)?;
    let y = safe_div(c, d)?;
    Some(x + y)
}
fn stack_last(xs) {
    if len(xs) == 0 { None } else { Some(xs[len(xs) - 1]) }
}
fn stack_drop_last(xs) {
    let mut out = [];
    let mut i = 0;
    while i < len(xs) - 1 {
        push(out, xs[i])
        i = i + 1;
    }
    out
}
fn grade(n) {
    match n {
        n if n >= 90 => "A",
        n if n >= 80 => "B",
        n if n >= 70 => "C",
        _ => "F",
    }
}
fn kind(n) {
    match n {
        0 => "zero",
        1 | 2 | 3 => "small",
        n if n < 0 => "negative",
        _ => "other",
    }
}
fn divmod(a, b) { (a / b, a % b) }

// ----- sections -------------------------------------------------------------

fn sec_literals_ops() {
    print("--- literals / operators / casts ---")
    let mut pf = [0, 0];
    pf = pf_merge(pf, check(1_000 == 1000, "digit separators"))
    pf = pf_merge(pf, check(0xFF == 255, "hex literal"))
    pf = pf_merge(pf, check(0b1010 == 10, "binary literal"))
    pf = pf_merge(pf, check(0o17 == 15, "octal literal"))
    pf = pf_merge(pf, check(1 + 2.5 == 3.5, "int+float promote"))
    pf = pf_merge(pf, check(type(3.14) == "float", "float type"))
    pf = pf_merge(pf, check(!false == true, "logical not"))
    pf = pf_merge(pf, check(~0 == -1, "bitwise not"))
    pf = pf_merge(pf, check((5 & 3) == 1, "bitwise and"))
    pf = pf_merge(pf, check((5 | 2) == 7, "bitwise or"))
    pf = pf_merge(pf, check((5 ^ 1) == 4, "bitwise xor"))
    pf = pf_merge(pf, check((1 << 4) == 16, "shl"))
    pf = pf_merge(pf, check((16 >> 2) == 4, "shr"))
    pf = pf_merge(pf, check(3 < 4 && 5 >= 5, "compare+and"))
    pf = pf_merge(pf, check(false || true, "or"))
    pf = pf_merge(pf, check("a" + 1 == "a1", "string+num"))
    pf = pf_merge(pf, check([1, 2] + [3] == [1, 2, 3], "list concat"))
    pf = pf_merge(pf, check(1 == 1.0, "num eq int/float"))
    pf = pf_merge(pf, check("5" != 5, "type-exact eq"))
    pf = pf_merge(pf, check([1, [2]] == [1, [2]], "nested list eq"))
    pf = pf_merge(pf, check((3.9 as u32) == 3, "cast float->u32"))
    pf = pf_merge(pf, check((300 as u8) == 44, "cast wrap u8"))
    pf = pf_merge(pf, check('A' == "A", "char is string"))
    let mut y = 10;
    y = y + 1;
    pf = pf_merge(pf, check(y == 11, "mut reassignment"))
    let mut z = 5;
    z += 3;
    z *= 2;
    pf = pf_merge(pf, check(z == 16, "compound assign"))
    pf
}

fn sec_control() {
    print("--- control flow ---")
    let mut pf = [0, 0];
    let mut tag = "";
    let x = -3;
    if x > 0 {
        tag = "pos";
    } else if x < 0 {
        tag = "neg";
    } else {
        tag = "zero";
    }
    pf = pf_merge(pf, check(tag == "neg", "if/else if/else"))
    let n = 7;
    let label = if n % 2 == 0 {
        let k = n / 2;
        str(k)
    } else {
        "odd"
    }
    pf = pf_merge(pf, check(label == "odd", "if-expression"))
    let mut i = 0;
    let mut sum = 0;
    while i < 20 {
        i = i + 1;
        if i % 2 == 0 {
            continue;
        } else {
            if i > 9 {
                break;
            } else {
                sum = sum + i;
            }
        }
    }
    pf = pf_merge(pf, check(sum == 25, "while/break/continue"))
    let mut c = 0;
    loop {
        c = c + 1;
        if c >= 5 {
            break;
        } else {
            c = c;
        }
    }
    pf = pf_merge(pf, check(c == 5, "loop/break"))
    let mut rsum = 0;
    for i in 1..5 {
        rsum = rsum + i;
    }
    pf = pf_merge(pf, check(rsum == 10, "for range"))
    let mut lsum = 0;
    for v in [10, 20, 30] {
        lsum = lsum + v;
    }
    pf = pf_merge(pf, check(lsum == 60, "for list"))
    let m = { "a": 1, "b": 2 }
    let mut keys = [];
    for k in m {
        push(keys, k)
    }
    pf = pf_merge(pf, check(len(keys) == 2, "for map keys"))
    let mut negc = 0;
    for dr in -1..2 {
        negc = negc + 1;
    }
    pf = pf_merge(pf, check(negc == 3, "negative range"))
    pf
}

fn sec_functions() {
    print("--- functions / recursion ---")
    let mut pf = [0, 0];
    pf = pf_merge(pf, check(is_even(10) == true, "mutual even"))
    pf = pf_merge(pf, check(is_odd(10) == false, "mutual odd"))
    pf = pf_merge(pf, check(fib(10) == 55, "recursive fib"))
    pf = pf_merge(pf, check(fact(6) == 720, "recursive fact"))
    pf = pf_merge(pf, check(typed_add(2, 3) == 5, "typed params"))
    pf = pf_merge(pf, check(implicit_triple(4) == 12, "implicit return"))
    pf
}

fn sec_closures() {
    print("--- closures / higher-order ---")
    let mut pf = [0, 0];
    let inc = |x| x + 1;
    pf = pf_merge(pf, check(inc(41) == 42, "lambda"))
    let add10 = make_adder(10)
    pf = pf_merge(pf, check(add10(5) == 15, "closure capture"))
    let f = |x| { let y = x * x; y + 1 }
    pf = pf_merge(pf, check(f(3) == 10, "block lambda"))
    pf = pf_merge(pf, check(map([1, 2, 3], |x| x * x) == [1, 4, 9], "map"))
    pf = pf_merge(pf, check(filter(range(1, 11), |x| x % 2 == 0) == [2, 4, 6, 8, 10], "filter"))
    pf = pf_merge(pf, check(reduce([1, 2, 3, 4], |a, b| a + b, 0) == 10, "reduce"))
    pf = pf_merge(pf, check(any([1, 2, 3], |x| x == 2) == true, "any"))
    pf = pf_merge(pf, check(all([2, 4, 6], |x| x % 2 == 0) == true, "all"))
    pf = pf_merge(pf, check(count([1, 2, 3, 4], |x| x > 2) == 2, "count"))
    pf = pf_merge(pf, check(find([1, 3, 5], |x| x > 3) == 5, "find"))
    let people = [{ "age": 30 }, { "age": 20 }];
    let sorted = sort_by(people, |p| p["age"])
    pf = pf_merge(pf, check(sorted[0]["age"] == 20, "sort_by"))
    pf = pf_merge(pf, check(apply(|x| x * 2, [21]) == 42, "apply"))
    pf = pf_merge(pf, check(compose(|x| x + 1, |x| x * 2)(5) == 11, "compose"))
    pf = pf_merge(pf, check(identity(7) == 7, "identity"))
    pf = pf_merge(pf, check(times(3, |i| i + 1) == [1, 2, 3], "times"))
    // each is real; closures capture by value so outer mut isn't visible — use reduce to accumulate
    each([1, 2, 3], |x| x);
    pf = pf_merge(pf, check(reduce([1, 2, 3], |a, b| a + b, 0) == 6, "each+reduce"))
    pf
}

fn sec_structs_traits() {
    print("--- structs / methods / traits / modules ---")
    let mut pf = [0, 0];
    let p2 = make_pair(3, 4)
    pf = pf_merge(pf, check(pair_sum(p2) == 7, "module fns flat"))
    pf = pf_merge(pf, check(Shape::Circle(10).area() == 300, "enum method"))
    pf = pf_merge(pf, check(Shape::Rect { w: 5, h: 4 }.area() == 20, "struct-variant method"))
    pf = pf_merge(pf, check(Shape::Point.area() == 0, "unit variant method"))
    let agent = Agent { id: "sicarii", level: 12 }
    pf = pf_merge(pf, check(agent.describe() == "item:sicarii", "trait default"))
    pf = pf_merge(pf, check(agent.big() == true, "trait Measurable"))
    let names = map([Shape::Circle(2), agent], |a| a.name())
    pf = pf_merge(pf, check(len(names) == 2, "hetero trait map"))
    let boxv = BoxG { value: 42 }
    pf = pf_merge(pf, check(boxv.value_of() == 42, "generic method"))
    pf = pf_merge(pf, check(boxv.show() == "Box(42)", "generic interp"))
    let mut pt = Agent { id: "x", level: 1 }
    pt.level = 9;
    pf = pf_merge(pf, check(pt.level == 9, "field mut"))
    let mut grid = [{ "v": 0 }, { "v": 0 }];
    grid[1]["v"] = 99;
    pf = pf_merge(pf, check(grid[1]["v"] == 99, "nested place assign"))
    pf
}

fn sec_match() {
    print("--- enums / match / patterns ---")
    let mut pf = [0, 0];
    pf = pf_merge(pf, check(grade(95) == "A", "match guard A"))
    pf = pf_merge(pf, check(grade(72) == "C", "match guard C"))
    pf = pf_merge(pf, check(kind(2) == "small", "or-pattern"))
    pf = pf_merge(pf, check(kind(-5) == "negative", "guard neg"))
    let nested = Some(Shape::Rect { w: 3, h: 4 })
    let area = match nested {
        Some(Shape::Rect { w: ww, h: hh }) => ww * hh,
        Some(Shape::Circle(r)) => 3 * r * r,
        Some(Shape::Point) => 0,
        None => -1,
    }
    pf = pf_merge(pf, check(area == 12, "nested pattern"))
    let trip = [10, 20, 30];
    let s = match trip {
        [a, b, c] => a + b + c,
        _ => 0,
    }
    pf = pf_merge(pf, check(s == 60, "list pattern"))
    let lit = match 5 {
        "5" => "str",
        5.0 => "num",
        _ => "other",
    }
    pf = pf_merge(pf, check(lit == "num", "literal pattern"))
    let ag = Agent { id: "z", level: 3 }
    let lv = match ag {
        Agent { id: _, level: l } => l,
        _ => 0,
    }
    pf = pf_merge(pf, check(lv == 3, "struct pattern"))
    let mut t = Tree::Empty;
    for x in [5, 3, 8, 1, 4] {
        t = t.add(x)
    }
    pf = pf_merge(pf, check(t.inorder() == [1, 3, 4, 5, 8], "BST inorder"))
    pf
}

fn sec_option_result() {
    print("--- Option / Result / ? / if-let / while-let ---")
    let mut pf = [0, 0];
    pf = pf_merge(pf, check(safe_div(10, 2) == Some(5), "Some"))
    pf = pf_merge(pf, check(safe_div(1, 0) == None, "None"))
    pf = pf_merge(pf, check(chain_div(10, 2, 16, 2) == Some(13), "? ok"))
    pf = pf_merge(pf, check(chain_div(10, 0, 1, 1) == None, "? fail"))
    let emsg = match checked_div(1, 0) {
        Ok(v) => str(v),
        Err(e) => e,
    }
    pf = pf_merge(pf, check(emsg == "div0", "Result Err"))
    let mut got = 0;
    if let Some(v) = safe_div(8, 2) {
        got = v;
    } else {
        got = -1;
    }
    pf = pf_merge(pf, check(got == 4, "if-let Some"))
    if let Some(v) = safe_div(8, 0) {
        got = v;
    } else {
        got = -1;
    }
    pf = pf_merge(pf, check(got == -1, "if-let None"))
    let mut stack = [1, 2, 3];
    let mut popped = [];
    while let Some(top) = stack_last(stack) {
        push(popped, top)
        stack = stack_drop_last(stack)
    }
    pf = pf_merge(pf, check(popped == [3, 2, 1], "while-let"))
    pf
}

fn sec_destructure() {
    print("--- tuples / destructuring ---")
    let mut pf = [0, 0];
    let (q, r) = divmod(15, 4)
    pf = pf_merge(pf, check(q == 3 && r == 3, "tuple destructure"))
    let [first, second, third] = [9, 8, 7];
    pf = pf_merge(pf, check(first == 9 && third == 7, "list destructure"))
    let (_, keep) = (1, 2)
    pf = pf_merge(pf, check(keep == 2, "wildcard destructure"))
    let [[p, q2], z] = [[1, 2], 3];
    pf = pf_merge(pf, check(p == 1 && q2 == 2 && z == 3, "nested destructure"))
    let origin = Agent { id: "o", level: 0 }
    let Agent { id: idn, level: lv } = origin;
    pf = pf_merge(pf, check(idn == "o" && lv == 0, "struct destructure"))
    pf
}

fn sec_strings() {
    print("--- strings / interpolation ---")
    let mut pf = [0, 0];
    let who = "Ada";
    let s = 85;
    let msg = "Hello, ${who}! grade ${if s >= 90 { "A" } else { "B" }}";
    pf = pf_merge(pf, check(msg == "Hello, Ada! grade B", "interpolation"))
    pf = pf_merge(pf, check("$5" == "$5", "literal dollar"))
    pf = pf_merge(pf, check(upper("hi") == "HI", "upper"))
    pf = pf_merge(pf, check(lower("HI") == "hi", "lower"))
    pf = pf_merge(pf, check(trim("  x  ") == "x", "trim"))
    pf = pf_merge(pf, check(contains("hello", "ell") == true, "contains"))
    pf = pf_merge(pf, check(starts_with("anubis", "anu") == true, "starts_with"))
    pf = pf_merge(pf, check(ends_with("anubis", "bis") == true, "ends_with"))
    pf = pf_merge(pf, check(replace("a_b_a", "_", "-") == "a-b-a", "replace"))
    pf = pf_merge(pf, check(index_of("hello", "ll") == 2, "index_of"))
    pf = pf_merge(pf, check(substr("abcdef", 2, 3) == "cde", "substr"))
    pf = pf_merge(pf, check(char_at("abc", 1) == "b", "char_at"))
    pf = pf_merge(pf, check(ord("A") == 65, "ord"))
    pf = pf_merge(pf, check(chr(65) == "A", "chr"))
    pf = pf_merge(pf, check(repeat("ab", 3) == "ababab", "repeat"))
    pf = pf_merge(pf, check(reverse("abc") == "cba", "reverse str"))
    pf = pf_merge(pf, check(join(["a", "b", "c"], "-") == "a-b-c", "join"))
    pf = pf_merge(pf, check(split("a-b-c", "-") == ["a", "b", "c"], "split"))
    pf = pf_merge(pf, check(len(words("one two  three")) == 3, "words"))
    pf = pf_merge(pf, check(len(chars("hi")) == 2, "chars"))
    pf = pf_merge(pf, check(capitalize("hello") == "Hello", "capitalize"))
    pf = pf_merge(pf, check(pad_start("7", 3, "0") == "007", "pad_start"))
    pf = pf_merge(pf, check(pad_end("7", 3, "0") == "700", "pad_end"))
    pf
}

fn sec_collections() {
    print("--- collections / stdlib math ---")
    let mut pf = [0, 0];
    let mut xs = [1, 2, 3];
    push(xs, 4)
    pf = pf_merge(pf, check(xs == [1, 2, 3, 4], "push"))
    let popped = pop(xs)
    pf = pf_merge(pf, check(popped == 4 && xs == [1, 2, 3], "pop"))
    insert(xs, 1, 9)
    pf = pf_merge(pf, check(xs[1] == 9, "insert"))
    pf = pf_merge(pf, check(slice([1, 2, 3, 4, 5], 1, 4) == [2, 3, 4], "slice"))
    pf = pf_merge(pf, check(sum([1, 2, 3, 4]) == 10, "sum"))
    pf = pf_merge(pf, check(product([1, 2, 3, 4]) == 24, "product"))
    pf = pf_merge(pf, check(range(1, 5) == [1, 2, 3, 4], "range"))
    pf = pf_merge(pf, check([1, 2, 3][-1] == 3, "neg index"))
    pf = pf_merge(pf, check(first([9, 8, 7]) == 9, "first"))
    pf = pf_merge(pf, check(last([9, 8, 7]) == 7, "last"))
    pf = pf_merge(pf, check(take([1, 2, 3, 4], 2) == [1, 2], "take"))
    pf = pf_merge(pf, check(drop([1, 2, 3, 4], 2) == [3, 4], "drop"))
    pf = pf_merge(pf, check(unique([1, 2, 2, 3, 1]) == [1, 2, 3], "unique"))
    pf = pf_merge(pf, check(flatten([[1, 2], [3]]) == [1, 2, 3], "flatten"))
    pf = pf_merge(pf, check(zip([1, 2], ["a", "b"]) == [[1, "a"], [2, "b"]], "zip"))
    pf = pf_merge(pf, check(enumerate(["x", "y"])[1][0] == 1, "enumerate"))
    pf = pf_merge(pf, check(len(chunk([1, 2, 3, 4, 5], 2)) == 3, "chunk"))
    pf = pf_merge(pf, check(len(window([1, 2, 3, 4], 3)) == 2, "window"))
    let parts = partition([1, 2, 3, 4, 5], |x| x % 2 == 0)
    pf = pf_merge(pf, check(parts[0] == [2, 4] && parts[1] == [1, 3, 5], "partition"))
    pf = pf_merge(pf, check(min_by([{ "v": 3 }, { "v": 1 }], |p| p["v"])["v"] == 1, "min_by"))
    pf = pf_merge(pf, check(max_by([{ "v": 3 }, { "v": 1 }], |p| p["v"])["v"] == 3, "max_by"))
    pf = pf_merge(pf, check(position([10, 20, 30], |x| x == 20) == 1, "position"))
    pf = pf_merge(pf, check(take_while([1, 2, 3, 0, 4], |x| x > 0) == [1, 2, 3], "take_while"))
    pf = pf_merge(pf, check(drop_while([0, 0, 1, 2], |x| x == 0) == [1, 2], "drop_while"))
    pf = pf_merge(pf, check(flat_map([1, 2], |x| [x, x * 10]) == [1, 10, 2, 20], "flat_map"))
    pf = pf_merge(pf, check(concat([1], [2, 3]) == [1, 2, 3], "concat"))
    pf = pf_merge(pf, check(sort([3, 1, 2]) == [1, 2, 3], "sort"))
    pf = pf_merge(pf, check(reverse([1, 2, 3]) == [3, 2, 1], "reverse list"))
    let mut m = { "a": 1, "b": 2 }
    m["c"] = 3;
    pf = pf_merge(pf, check(m["c"] == 3, "map set"))
    pf = pf_merge(pf, check(has_key(m, "a") == true, "has_key"))
    pf = pf_merge(pf, check(get(m, "z", 99) == 99, "get default"))
    pf = pf_merge(pf, check(len(keys(m)) == 3, "keys"))
    pf = pf_merge(pf, check(len(values(m)) == 3, "values"))
    pf = pf_merge(pf, check(len(entries(m)) == 3, "entries"))
    let m2 = merge(m, { "d": 4 })
    pf = pf_merge(pf, check(has_key(m2, "d") == true, "map merge"))
    pf = pf_merge(pf, check(str(42) == "42", "str"))
    pf = pf_merge(pf, check(int("7") == 7, "int"))
    pf = pf_merge(pf, check(float("2.5") == 2.5, "float"))
    pf = pf_merge(pf, check(bool(1) == true, "bool"))
    pf = pf_merge(pf, check(type([1]) == "list", "type"))
    pf = pf_merge(pf, check(parse_int("99") == 99, "parse_int"))
    pf = pf_merge(pf, check(parse_float("1.5") == 1.5, "parse_float"))
    pf = pf_merge(pf, check(abs(-5) == 5, "abs"))
    pf = pf_merge(pf, check(min(3, 1, 2) == 1, "min"))
    pf = pf_merge(pf, check(max([1, 9, 3]) == 9, "max"))
    pf = pf_merge(pf, check(pow(2, 10) == 1024, "pow"))
    pf = pf_merge(pf, check(sqrt(25) == 5.0, "sqrt"))
    pf = pf_merge(pf, check(floor(3.9) == 3, "floor"))
    pf = pf_merge(pf, check(ceil(3.1) == 4, "ceil"))
    pf = pf_merge(pf, check(round(3.5) == 4, "round"))
    pf = pf_merge(pf, check(gcd(12, 8) == 4, "gcd"))
    pf = pf_merge(pf, check(sign(-3) == -1, "sign"))
    pf = pf_merge(pf, check(clamp(15, 0, 10) == 10, "clamp"))
    pf = pf_merge(pf, check(factorial(5) == 120, "factorial"))
    pf = pf_merge(pf, check(trunc(3.9) == 3, "trunc"))
    pf = pf_merge(pf, check(cbrt(8.0) == 2.0, "cbrt"))
    pf = pf_merge(pf, check(hypot(3, 4) == 5.0, "hypot"))
    pf = pf_merge(pf, check(sin(0) == 0.0, "sin0"))
    pf = pf_merge(pf, check(cos(0) == 1.0, "cos0"))
    pf = pf_merge(pf, check(ln(e()) > 0.99 && ln(e()) < 1.01, "ln(e)"))
    pf = pf_merge(pf, check(pi() > 3.14 && pi() < 3.15, "pi"))
    assert(true)
    pf = pf_merge(pf, check(true, "assert"))
    pf
}

fn sec_generics() {
    print("--- generics ---")
    let mut pf = [0, 0];
    pf = pf_merge(pf, check(max_of(3, 7) == 7, "generic max int"))
    pf = pf_merge(pf, check(max_of("apple", "banana") == "banana", "generic max str"))
    let b = BoxG { value: "hi" }
    pf = pf_merge(pf, check(b.value_of() == "hi", "generic box"))
    pf
}

fn sec_optional_semi() {
    print("--- optional semicolons / comments ---")
    let mut pf = [0, 0];
    let a = 1;
    let b = 2;
    pf = pf_merge(pf, check(a + b == 3, "optional semicolon"))
    /* block comment /* nested */ ok */
    pf = pf_merge(pf, check(true, "block comments"))
    pf
}

fn main() {
    print("##############################################");
    print("# ANUBIS FULL LANGUAGE MATRIX                #");
    print("##############################################");
    let mut m = Matrix { lines: [], pass: 0, fail: 0 };

    m = m.add(sec_literals_ops());
    m = m.add(sec_control())
    m = m.add(sec_functions())
    m = m.add(sec_closures())
    m = m.add(sec_structs_traits())
    m = m.add(sec_match())
    m = m.add(sec_option_result())
    m = m.add(sec_destructure())
    m = m.add(sec_strings())
    m = m.add(sec_collections())
    m = m.add(sec_generics())
    m = m.add(sec_optional_semi())

    m.dump()
    print("NOTE: research/prove/AOP are CLI surfaces — run separately:")
    print("  anubis check examples/taint_reject.anb")
    print("  anubis prove examples/proof/proof_factorial_input.anb --backend risc0 ...")
    print("  anubis engage-init / doctor / fuzz  (platform tools)")
}
