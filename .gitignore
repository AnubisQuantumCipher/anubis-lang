# Build artifacts
target/
**/*/target/
**/*-real-hybrid/target/
**/*-fast-hybrid/target/
*.rlib
*.rmeta
*.d

# Large generated
out/*/target/
out/audit/hybrid/*target/

# Experiment / A+ audit outputs (generated, do not commit raw runs)
out/a_plus_*/
out/a15_*/
out/codex_*/
out/*_tampered/
out/current_*/
implementer/a_plus_audit_run/*/proof_bundle/

# Gate / audit / study run output (generated, regenerable — never dirty the tree)
out/
implementer/a_plus_audit_run/
AGENT_STUDY/
forensics/
examples/**/out/
poc_kit/bin/
**/__pycache__/

# OS / editor
.DS_Store
*.swp
*~

# Env / secrets (never commit)
.env
*.pem
secrets/

# Temporary
tmp/
*.tmp

# Editor extension deps (install via npm install in editors/*)
editors/**/node_modules/

# Ammit evidence deck — local machine-produced artifacts (test reports), never committed
.ammit/

# Claude Code session data — transcripts, worktrees, workflow scripts (never publish)
.claude/

# Local agent-harness config + transient dev artifacts (not part of the language)
.grok/
goal/
.hunt2_findings/
scratchpad/

# Stray scratch files that were previously ignored only via a non-portable local
# .git/info/exclude — pin them here so a fresh clone ignores them too
run313131.anb
secret.txt
hello.txt
*.bak
*.zip

# Stray logs. The handful of deliberately-tracked evidence logs (implementer/evidence,
# gate parity logs) are already committed and stay tracked; this only stops NEW ones.
*.log

# Landing page — held out of the tree until its figures are reconciled to the gates.
# `git add -f site/` to include it once it is honest.
site/
