// EXPECT: PASS
// Phase-7 native-authoritative demo: a pure-integer contract the NATIVE QF_BV solver proves by
// itself. Under `ANUBIS_NATIVE_AUTHORITATIVE=1` with z3 absent from PATH, this file still checks
// green — the machine-checked native pipeline (parse → bit-blast → CDCL) carries the proof. In the
// default mode it proves identically via z3, so the two configurations must agree (the equivalence
// gate asserts exactly that).
pub fn clamp_add(x: u32, y: u32) -> u32
    requires(x <= 1000)
    requires(y <= 1000)
    ensures(result >= x)
    ensures(result <= 2000)
{
    return x + y;
}

// The ite lane: `max` lowers to `(ite (bvsle a b) b a)` — proof-backed since `iteBits_correct`
// admitted the mux, so this ∀-input floor contract also proves z3-free on proven blasts only.
pub fn floor0(x: int) -> int
    ensures(result >= 0)
    ensures(result >= x)
{
    return max(x, 0);
}

// The left-shift lane: `<<` lowers to `(bvshl v (zero_extend 58 (extract 5 0 amount)))` — the amount
// mask `mod 64` spelled as the low-6-bits identity (z3-proven equal to `bvurem`), so the WHOLE shift
// is built from proven blasts (bvshl + extract + zero_extend). A shift by a VARIABLE amount uses the
// (proven) barrel shifter. This ∀-input contract proves z3-free on proven blasts only.
pub fn shl_bounded(x: u8, k: u8) -> int
    requires(x <= 15)
    requires(k <= 3)
    ensures(result >= 0)
{
    return (x as int) << (k as int);
}

// The arithmetic-right-shift lane: `>>` lowers (from PROVEN ops, no bvashr) to a sign-filled logical
// shift — `ite(v<0, (v>>ᵤamt) | ~(allones>>ᵤamt), v>>ᵤamt)` — z3-proven identical to `bvashr`. A
// nonnegative value right-shifted stays nonnegative (and no larger). Proves z3-free on proven blasts.
pub fn shr_nonneg(x: u16, k: u8) -> int
    requires(k <= 4)
    ensures(result >= 0)
    ensures(result <= x)
{
    return (x as int) >> (k as int);
}

fn main() {
    // BOTH halves of this file are now z3-free proofs over the MACHINE-CHECKED fragment
    // (`solver/src/fragment.rs`): clamp_add's ∀-input contract discharges from {bvadd, bvsle, bvsge}
    // (rippleCarry_spec + sle/ule/slt/ult_correct), and this concrete call's u32 literal coercion
    // checks lower to `bvand` — proof-backed since `andBits_correct` (the bitsToNat_testBit bridge)
    // admitted bitwise into the fragment.
    print(clamp_add(700, 300));
}
