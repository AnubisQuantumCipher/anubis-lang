// Multi-file Phase-3: import io with uses(fs.read); main declares uses and exercises governed I/O.
// EXPECT: PASS
import io;

fn main() uses(fs.write, fs.read) {
    write_file("/tmp/anubis_phase3_io.txt", "xyz");
    let d = io::load("/tmp/anubis_phase3_io.txt");
    print(declassify(len(d), "self-io", "length of a file this program just wrote"));
}
