// Calling a private function across a module boundary is a fail-closed compile error
// (ANUBIS_PRIVATE_ITEM). Running this must fail. `secrets::public_ok()` would be fine; calling
// `secrets::internal()` is the rejected line.
// EXPECT: FAIL
// ERROR_CONTAINS: ANUBIS_PRIVATE_ITEM
import secrets;

fn main() {
    print(secrets::internal());
}
