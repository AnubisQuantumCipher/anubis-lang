// EXPECT: PASS
// FEATURE: Phase-5 broad export smoke across pure std modules
import std.math;
import std.testing;
import std.collections;
import std.str;
import std.option;
import std.result;
import std.iter;
import std.pwn;

fn double(x) { return x * 2; }
fn is_even(x) { return x % 2 == 0; }
fn add2(a, b) { return a + b; }

fn main() {
    testing::assert_eq(math::math_add(2, 3), 5);
    testing::assert_eq(math::math_gcd(48, 18), 6);
    testing::assert_eq(math::math_lcm(4, 6), 12);
    testing::assert_eq(math::math_pow_u(2, 8), 256);

    let s = collections::set_union([1, 2], [2, 3]);
    testing::assert_eq(collections::set_len(s), 3);
    let m = collections::omap_put(collections::omap_new(), "k", 1);
    testing::assert_eq(collections::omap_get(m, "k", 0), 1);

    testing::assert_eq(str::str_join(["a", "b"], "-"), "a-b");
    testing::assert_eq(str::str_pad_left("x", 3), "  x");

    testing::assert_eq(option::option_unwrap_or(option::option_map(Some(3), double), 0), 6);
    testing::assert_eq(result::result_unwrap_or(result::result_map(Ok(5), double), 0), 10);

    testing::assert_eq(iter::iter_sum([1, 2, 3, 4]), 10);
    testing::assert_eq(iter::iter_reduce([1, 2, 3], add2, 0), 6);
    testing::assert_true(option::option_is_some(iter::iter_find([1, 2, 3], is_even)));

    let le = pwn::pack_le_u32(0x41424344);
    testing::assert_eq(pwn::unpack_le_u32(le), 1094861636);
    testing::assert_eq(pwn::cyclic_find(16, [pwn::cyclic_pattern(16)[3]]), 3);
    testing::assert_eq(pwn::hexdump([0x0a]), "0a");
    testing::assert_eq(len(pwn::junk(5)), 5);
    testing::assert_eq(len(pwn::pad_right([1, 2], 4, 0)), 4);
    testing::assert_eq(len(pwn::chain_u32([1, 2])), 8);
    testing::assert_eq(pwn::signal_name(11), "SIGSEGV");
    testing::assert_eq(pwn::hexdump_compact([0x0a, 0x0b]), "0a0b");

    print(42);
}
