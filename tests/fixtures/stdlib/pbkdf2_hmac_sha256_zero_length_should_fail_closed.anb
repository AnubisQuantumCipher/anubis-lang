// would fail later with a confusing error, or worse, a caller might feed the empty result to
// an AEAD key check that panics inside crypto internals. Fail-closed at the KDF boundary.
fn main() {
    print(pbkdf2_hmac_sha256("password", "salt", 100, 0));
}
