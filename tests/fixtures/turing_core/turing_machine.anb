// EXPECT: PASS
// FEATURE: turing-core (UNIVERSALITY WITNESS: Turing machine simulator in Anubis)
// Simulates the 3-state 2-symbol busy beaver. Tape = two integer stacks; head symbol = cur.
// Halts after 14 transitions leaving 6 ones (known BB-3 constants S(3)=14, Sigma(3)=6),
// cross-checked against an independent reference simulator. Demonstrates that Anubis can
// simulate an arbitrary Turing machine using only loops, recursion, mutation and arithmetic.
fn popcount(x: u32) {
    let c = 0;
    while x != 0 {
        c = c + x % 2;
        x = x / 2;
    }
    return c;
}
fn main() {
    let state = 0;
    let left = 0;
    let right = 0;
    let cur = 0;
    let steps = 0;
    let w = 0;
    let mv = 0;
    let nx = 0;
    while state != 3 {
        if state == 0 && cur == 0 { w = 1; mv = 1; nx = 1; }
        else if state == 0 && cur == 1 { w = 1; mv = 1; nx = 3; }
        else if state == 1 && cur == 0 { w = 0; mv = 1; nx = 2; }
        else if state == 1 && cur == 1 { w = 1; mv = 1; nx = 1; }
        else if state == 2 && cur == 0 { w = 1; mv = 0; nx = 2; }
        else { w = 1; mv = 0; nx = 0; }
        cur = w;
        if mv == 1 {
            left = left * 2 + cur;
            cur = right % 2;
            right = right / 2;
        } else {
            right = right * 2 + cur;
            cur = left % 2;
            left = left / 2;
        }
        state = nx;
        steps = steps + 1;
    }
    let ones = cur + popcount(left) + popcount(right);
    print(steps);
    print(ones);
}
