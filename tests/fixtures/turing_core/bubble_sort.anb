// EXPECT: PASS
// FEATURE: collections (arrays, indexing, index-assign, nested for)
fn main() {
    let a = [5, 2, 9, 1, 7, 3, 8, 4, 6, 0];
    let n = len(a);
    for i in 0..n {
        for j in 0..n - 1 {
            if a[j] > a[j + 1] {
                let tmp = a[j];
                a[j] = a[j + 1];
                a[j + 1] = tmp;
            }
        }
    }
    print(a);
}
