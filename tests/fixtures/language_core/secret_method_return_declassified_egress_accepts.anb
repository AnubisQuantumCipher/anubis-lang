// EXPECT: PASS
// Precision guard: a well-formed declassify of the method return releases it — the Declassify arm of
// the walker clears before the method-return check is reached, so the send is accepted.
struct Vault { id: u32 }
impl Vault {
    fn key(self) { return secret_source("api_key"); }
}
fn main() uses(net.send) {
    let v = Vault { id: 1 };
    send("host", 80, declassify(v.key(), "release-policy", "audited"));
}
