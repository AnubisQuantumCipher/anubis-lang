// EXPECT: PASS
// The sanctioned release hatch: a secret explicitly declassify()'d — with a policy AND a reason — is
// cleared and may leave the program. This is the confidentiality dual of the taint declassify, and it
// is what separates a reviewed, redacted egress from an uncontrolled leak. A MALFORMED declassify
// (missing policy or reason) does NOT hatch — that path stays a rejection.
fn main() uses(net.send) {
    let k = secret_source("api_key");
    send("host", 80, declassify(k, "redacted-proof", "only redacted proof may leave boundary"));
}
