// EXPECT: FAIL
// ERROR_CONTAINS: ANUBIS_GENERIC_ARITY
// A user generic type instantiated with the wrong number of type arguments.
// `Pair` declares two parameters; `Pair<u32>` supplies one.
struct Pair<A, B> {
    a: A,
    b: B,
}

fn main() {
    let p: Pair<u32> = Pair { a: 1, b: 2 };
    print(p.a);
}
