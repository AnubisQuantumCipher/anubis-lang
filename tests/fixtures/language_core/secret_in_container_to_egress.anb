// EXPECT: FAIL
// ERROR_CONTAINS: ANUBIS_SECRET_EXFILTRATION
// Composite laundering, confidentiality side (the dual): a secret stashed in a container still
// reaches egress. Any secret element makes the container secret, so wrapping it in `[...]` no longer
// launders it past the egress check.
fn main() uses(net.send) {
    let k = secret_source("api_key");
    send("host", 80, [k]);
}
