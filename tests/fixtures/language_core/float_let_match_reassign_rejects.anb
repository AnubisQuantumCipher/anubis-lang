// EXPECT: FAIL
// ERROR_CONTAINS: ANUBIS_FLOAT_CONTRACT_UNMODELED
// Phase-3 QF_FP float `let` SOUNDNESS GUARD (Lens-1 false-accept the review caught). `y` starts at 2.0
// but the `match` arm for `c == 0` reassigns it to 100.0, so at runtime `leak(0)` returns 100.0 and the
// postcondition `result == 2.0` is FALSE. The statement-level frame sweep (drop_written_after_scope)
// only visits `Stmt::If`/`While`/… bodies — it does NOT visit a write embedded in a `match` arm — so a
// naive float `let` chaining would leak the stale `(= anb_y 2.0)` fact and certify the violable contract.
// The `reassigned_roots` gate refuses to model ANY float `let` whose variable is reassigned anywhere in
// the function (collect_assigned_roots finds the embedded `y = 100.0`), so `y` is left unmodeled and the
// contract correctly fails to prove at compile time. Fail-closed.
fn leak(c: i64) -> f64
    ensures(result == 2.0)
{
    let y = 2.0;
    match c { 0 => { y = 100.0; } _ => {} }
    return y;
}
fn main() { let r = leak(0); }
