// EXPECT: PASS
// Valid generic use must never be rejected: a parameter used consistently, a
// correct-arity instantiation, and calls that bind `T` to one concrete type
// each. This is the accept-side guard for the generic checks.
fn id<T>(x: T) -> T {
    return x;
}

struct Pair<A, B> {
    a: A,
    b: B,
}

fn main() {
    let n = id(5);
    let s = id("hi");
    let p: Pair<u32, u64> = Pair { a: 1, b: 2 };
    print(n);
    print(s);
    print(p.a);
}
