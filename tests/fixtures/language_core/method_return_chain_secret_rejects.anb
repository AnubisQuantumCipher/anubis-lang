// EXPECT: FAIL
// ERROR_CONTAINS: ANUBIS_SECRET_EXFILTRATION
// #70 method-RETURN chaining: `alias` returns the result of another method `key` which mints a secret.
// The combined method-return fixpoint (compute_method_secret_fns now consults the growing method set,
// not just the frozen free-fn set) marks `alias` secret-returning in round 2, so `send(v.alias())` is
// caught. Was the pinned #68 residual (formerly EXPECT:PASS); now closed.
struct Vault { id: u32 }
impl Vault {
    fn key(self) { return secret_source("api_key"); }
    fn alias(self) { return self.key(); }
}
fn main() uses(net.send) {
    let v = Vault { id: 1 };
    send("host", 80, v.alias());
}
