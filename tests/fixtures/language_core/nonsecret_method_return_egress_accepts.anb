// EXPECT: PASS
// Precision guard: a method that mints/returns NO secret never enters method_secret_fns, so its return
// is not flagged — using a method result that isn't private is fine.
struct Vault { id: u32 }
impl Vault {
    fn label(self) { return 7; }
}
fn main() uses(net.send) {
    let v = Vault { id: 1 };
    send("host", 80, v.label());
}
