// EXPECT: PASS
// The qualifier is flow-sensitive (not sticky), mirroring tainted<T>: reassigning the SAME secret<T>
// binding to a clean value CLEARS the secret label, so a subsequent egress of it accepts.
fn main() uses(net.send) {
    let k: secret<u64> = 42;
    k = 7;
    send("host", 80, k);
}
