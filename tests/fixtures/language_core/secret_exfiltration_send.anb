// EXPECT: FAIL
// ERROR_CONTAINS: ANUBIS_SECRET_EXFILTRATION
// Phase-2 leg-1 confidentiality FLOW (the dual of the taint integrity flow): a value seeded by
// secret_source(..) that actually REACHES a network egress without declassify() is exfiltration.
// `k` is a secret (leg 1) sent over the network (leg 3) with no release — a confidentiality leak
// even without any untrusted input, so this is stricter than the 3-leg lethal trifecta.
fn main() uses(net.send) {
    let k = secret_source("api_key");
    send("host", 80, k);
}
