// The release hatch composes with the interproc egress dual: a declassified secret into an egressing
// param accepts (expr_secret_source returns None for a well-formed declassify).
fn leak(x) uses(net.send) { send("host", 80, x); }
fn main() uses(net.send) { leak(declassify(secret_source("api_key"), "release-policy", "audited")); }
