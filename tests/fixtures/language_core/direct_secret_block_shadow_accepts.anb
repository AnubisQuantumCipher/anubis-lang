// EXPECT: PASS
// Accept-bias guard (block-let SHADOW): the nested `if` introduces a NEW `let r` that SHADOWS the outer
// block-local `r` — the tail reads the OUTER r (= 0, clean), so nothing secret is sent. Relies on the
// real-span patch so merge_taint_over's span-identity skips the shadow instead of leaking its label.
fn main(c: bool) uses(net.send) {
    let out = if true {
        let r = 0;
        if c { let r = secret_source("api_key"); }
        r
    } else {
        0
    };
    send("host", 80, out);
}
