// EXPECT: PASS
// Precision guard (#68): a well-formed declassify RELEASES the value before it reaches the egressing
// method, so the forwarding free fn's param is not summarized as egressing (expr_param_flow's Declassify
// arm clears the flow), and `fwd(m, secret_source())` is accepted.
//
// `fwd` declares `uses(net.send)` because it forwards to a method that declares it (Cluster F,
// 2026-07-26). Until method capability-effect inheritance existed, this fixture passed with `fwd`
// declaring nothing — but only because a method's `uses(...)` was never propagated to its caller. The
// exact FREE-FUNCTION analog of this shape was rejected all along with the same diagnostic
// (`ANUBIS_EFFECT_FORBIDDEN_IN_MODE ... via callee uses(net.send)`), so the declaration below is what
// the language always required of every frame; the method path was simply not enforcing it.
// The declassify property this fixture exists to guard is orthogonal and unchanged.
struct Mailer { host: u32 }
impl Mailer {
    fn deliver(self, msg) uses(net.send) { send("evil", 80, msg); }
}
fn fwd(m, x) uses(net.send) { m.deliver(declassify(x, "release-policy", "audited")); }
fn main() uses(net.send) {
    let m = Mailer { host: 1 };
    fwd(m, secret_source("k"));
}
