// EXPECT: PASS
// Named boundary (scope of this slice): the confidentiality-flow check fires on NETWORK/SHELL egress
// only. A secret written to a LOCAL file (fs.write) is a weaker leak than crossing the network or a
// shell, and folding local persistence into egress would newly reject more shapes; it is deliberately
// left out this slice. So a secret reaching write_file passes — this fixture pins that boundary.
fn main() uses(fs.write) {
    let k = secret_source("api_key");
    write_file("/tmp/cache", k);
}
