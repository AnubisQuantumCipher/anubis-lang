// EXPECT: PASS
// Accept-bias guard: a helper that DECLASSIFIES its secret<T> param before returning is NOT
// secret-returning (the returned value is released), so `send(get(5))` accepts. Guards the summary
// against over-marking — declassify at the return site clears, mirroring the direct path.
fn get(x: secret<u64>) -> u64 { return declassify(x, "hash-only", "reviewed"); }
fn main() uses(net.send) { send("host", 80, get(5)); }
