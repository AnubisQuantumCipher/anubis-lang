// EXPECT: PASS
// Flow-sensitive accept-guard (precision, not just over-secreting): a secret `x` REASSIGNED to a
// clean constant before the send is genuinely non-secret — the flow-sensitive CLEAR makes this pass.
// A reassignment-insensitive checker would over-reject it; this pins that the confidentiality flow
// clears as precisely as it sets (the dual of taint_reassign_to_clean_accepts).
fn main() uses(net.send) {
    let x = secret_source("api_key");
    x = 42;
    send("host", 80, x);
}
