// EXPECT: PASS
// Precision guard for the impl-method egress check: a secret IS passed to a method, but the method
// neither sinks nor egresses its parameter (it only binds it locally), so `store`'s parameter is NOT
// summarized as egressing/sinking and the call is accepted. Using a secret is fine; only leaking it is
// a violation.
struct Vault { id: u32 }
impl Vault {
    fn store(self, x) { let held = x; }
}
fn main() {
    let v = Vault { id: 1 };
    v.store(secret_source("api_key"));
}
