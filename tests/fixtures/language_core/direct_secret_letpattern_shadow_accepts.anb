// EXPECT: PASS
// Accept-bias guard (destructuring-let SHADOW): a nested `let [r, s] = [secret, 1]` SHADOWS the outer
// destructured `r`; the tail reads the OUTER r (= 0). This is safe ONLY because the span-patch is extended
// to LetPattern-bound vars — otherwise the shadow and outer would both carry span:None, collide in
// merge_taint_over, and the shadow's secret would falsely leak to the outer binding.
fn main(c: bool) uses(net.send) {
    let out = if true {
        let [r, s] = [0, 1];
        if c { let [r, s] = [secret_source("api_key"), 1]; }
        r
    } else {
        0
    };
    send("host", 80, out);
}
