// Scope-aware control-flow value walk: a secret selected by an if-expression branch carries
// (may-carry combine over branches). Previously the whole if-expression was opaque to the walkers.
fn main() uses(net.send) {
    let k = secret_source("api_key");
    let flag = true;
    let picked = if flag { k } else { 0 };
    send("host", 80, picked);
}
