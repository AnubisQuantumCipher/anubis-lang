// EXPECT: PASS
// Accept-bias guard (CLEAR-BOTH): a secret local reassigned to a clean constant on BOTH branches is
// precisely cleared, so the tail is clean. Requires the merge set to be exactly [then, else] (a uniform
// base path would OR the pre-branch secret back and over-reject). Mirrors the enforcing pass's If arm.
fn main(c: bool) uses(net.send) {
    let out = if true {
        let r = secret_source("api_key");
        if c { r = 0; } else { r = 0; }
        r
    } else {
        0
    };
    send("host", 80, out);
}
