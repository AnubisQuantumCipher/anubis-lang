// EXPECT: FAIL
// ERROR_CONTAINS: ANUBIS_SECRET_EXFILTRATION
// Confidentiality is flow-sensitive on reassignment (dual of the taint reassignment fail-open):
// `x` starts as a clean constant, is REASSIGNED to a secret, then sent. A reassignment-insensitive
// checker would read the stale clean `let` state and miss the leak; the flow-sensitive SET catches it.
fn main() uses(net.send) {
    let x = 5;
    x = secret_source("token");
    send("host", 80, x);
}
