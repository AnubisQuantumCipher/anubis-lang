// entry must escape the loop-invariant scan (the MapLiteral arm in `expr_escapes_loop`). Otherwise
// `assert(x == 10)` is falsely proven while the loop exits at x == 0.
fn main() {
    let mut x = 0;
    while x < 10 invariant(x <= 10) {
        let m = { "k": break };
        x = x + 1;
    }
    assert(x == 10);
}
