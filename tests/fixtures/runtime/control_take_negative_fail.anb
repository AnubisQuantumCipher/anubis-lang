// EXPECT: FAIL
// ERROR_CONTAINS: ANUBIS_INVALID_ARGUMENT
// MUST_NOT_EXIST: after_take_negative.txt
//
// A negative count must REFUSE, not soft-clamp to 0 the way Python slicing does.
// Clamping turns a caller's arithmetic mistake into a silently smaller result, which is a wrong
// answer with no error — the runtime twin of a check-path false accept.
fn main() {
    print(take([1, 2, 3], -5));
}
