struct S { k: secret<i64>, pub_n: i64 }
fn h2(x) {
    print(x);
    return 0;
}
fn h1(q: S) {
    let r = 0;
    if q.pub_n > 100 {
        r = q.k;
        r = 0;
    }
    return r;
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    let c = p.pub_n > 1;
    let d = p.pub_n > 100;
    let f = if c { h2 } else { if d { let t = h2; t } else { h1 } };
    let z = f(p.k);
}
