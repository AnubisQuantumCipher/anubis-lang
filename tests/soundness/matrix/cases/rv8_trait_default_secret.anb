fn getsec() -> secret<i64> { let s: secret<i64> = 42; return s; }
fn pub1() -> i64 { return 1; }
trait Pk { fn pick(self, c) { return getsec; } }
struct A { n: i64 }
impl Pk for A { fn pick(self, c) { if c < 5 { return pub1; } return pub1; } }
struct B { n: i64 }
impl Pk for B { }
fn main() { let b = B { n: 1 }; let g = b.pick(1); print(g()); }
