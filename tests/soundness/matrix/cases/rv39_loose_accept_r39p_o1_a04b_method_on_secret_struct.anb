struct S { k: secret<i64>, pub_n: i64 }
struct Badge { label: string }
impl Badge { fn render(self) -> string { return "${self}"; } }
struct Account { owner: S, visits: i64 }
impl Account {
    fn render(self) -> string { return "visits=${self.visits}"; }
}
impl S { fn account(self) -> Account { return Account { owner: self, visits: 1 }; } }
fn main() {
    let p = S { k: 42, pub_n: 3 };
    let a = p.account();
    println(a.render());
}
