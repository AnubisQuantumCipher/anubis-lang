struct S { k: secret<i64>, pub_n: i64 }
fn noop(x) { return 0; }
fn leak(x) { print(x); return 0; }
fn g(p) {
    let f1 = noop;
    let f2 = noop;
    let f3 = noop;
    let f4 = noop;
    let f5 = noop;
