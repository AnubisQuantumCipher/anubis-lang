struct S { k: secret<i64>, pub_n: i64 }
fn zero(x) { return 0; }
fn zero2(x) { return 2; }
fn id1(x) { return x; }
fn mk() { return id1; }

fn main() {
    let p = S { k: 42, pub_n: 3 };
    let z = if p.pub_n > 0 {
        let t = zero;
        let u = if p.pub_n > 1 { t = println; 1 } else { 0 };
        print(map([p], t));
        u
    } else { 0 };
    print(z);
}
