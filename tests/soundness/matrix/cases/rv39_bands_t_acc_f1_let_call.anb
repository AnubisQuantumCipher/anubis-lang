struct S { k: secret<i64>, pub_n: i64 }
fn show(q) { print(q.pub_n); return 0; }
fn zero(q) { return 0; }
fn mk() { return [call, call]; }
fn run(p, n) {
    let w = mk();
    let call = w[0];
    let r = call;
    r(show, p);
    return 0;
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    run(p, 5);
}
