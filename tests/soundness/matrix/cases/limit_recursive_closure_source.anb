struct S { k: secret<i64>, pub_n: i64 }
fn f(xs) {
    let g = |s| 0
    let h = |s| 1
    for i in 0..2 {
        for j in 0..2 {
            for k in 0..2 {
                g = |s| h(s) + g(s)
                h = |s| g(s) + h(s)
            }
        }
    }
    return 1
}
fn main() {
    let p = S { k: 42, pub_n: 3 }
    let xs = [p, S { k: 7, pub_n: 1 }]
    print(f(xs))
}
