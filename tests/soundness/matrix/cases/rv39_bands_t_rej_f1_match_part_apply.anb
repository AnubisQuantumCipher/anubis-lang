struct S { k: secret<i64>, pub_n: i64 }
fn show(q) { print(q); return 0; }
fn zero(q) { return 0; }
fn mk() { return [apply, apply]; }
fn run(p, n) {
    let w = mk();
    let r = match w { [apply, x] => apply, _ => 0 };
    r(show, [p]);
    return 0;
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    run(p, 5);
}
