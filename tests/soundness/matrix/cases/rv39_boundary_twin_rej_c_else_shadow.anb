struct S { k: secret<i64>, pub_n: i64 }
fn zero(x) { return 0; }
fn zero2(x) { return 2; }
fn id1(x) { return x; }
fn mk() { return id1; }

fn main() {
    let p = S { k: 42, pub_n: 3 };
    let g = zero;
    if p.pub_n > 5 {
        print(1);
    } else {
        g = println;
        let g = zero;
        print(g(1));
    }
    print(map([p], g));
}
