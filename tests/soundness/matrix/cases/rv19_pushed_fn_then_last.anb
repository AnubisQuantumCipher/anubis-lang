fn f(x: i64) -> i64 requires(x > 0) { print("f entered with ${x}"); return x; }
fn safe(x: i64) -> i64 { return x; }
struct H { h: any }
struct O { n: i64 }
impl O { fn h(self, x) { return x; } }
fn mk(c) { let xs = [1]; push(xs, f); let t = [H { h: last(xs) }]; if c > 0 { return t[0]; } return O { n: 1 }; }
fn main() { let m = mk(1); print(m.h(-1)); }
