struct S { k: secret<i64>, pub_n: i64 }
fn show(s) { println(s); return 0; }
fn other(s) { println(1); return 0; }
struct T { n: i64 }
struct U { n: i64 }
impl T { fn pick(self) { return other; } fn run(self, s) { return 0; } }
impl U { fn pick(self) { return show; } fn run(self, s) { println(s); return 0; } }
fn main() {
    let p = S { k: 42, pub_n: 3 };
    let xs: list<T> = [T { n: 1 }, T { n: 2 }];
    xs[1].run(p);
    let ys = [T { n: 3 }];
    ys[0].run(p);
}
