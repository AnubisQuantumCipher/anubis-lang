struct S { k: secret<i64>, pub_n: i64 }
struct T { n: i64 }
struct U { n: i64 }
struct W { t: T, m: i64 }
impl T {
    fn show(self, o) {
        print(self.n);
    }
}
impl U {
    fn show(self, o) {
        print(o);
    }
}
fn same(xs: list<T>) -> list<T> {
    return xs;
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    let ys = [T { n: 1 }];
    push(ys, U { n: 2 });
    let zs = same(ys);
    zs[1].show(p);
}
