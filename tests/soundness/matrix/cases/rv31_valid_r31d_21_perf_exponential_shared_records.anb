struct S { k: secret<i64>, pub_n: i64 }
fn f(p) {
    let m0 = {"a": p};
    let m1 = {"a": m0, "b": m0};
    let m2 = {"a": m1, "b": m1};
    let m3 = {"a": m2, "b": m2};
    let m4 = {"a": m3, "b": m3};
    let m5 = {"a": m4, "b": m4};
    let m6 = {"a": m5, "b": m5};
    let m7 = {"a": m6, "b": m6};
    let m8 = {"a": m7, "b": m7};
    let m9 = {"a": m8, "b": m8};
    let m10 = {"a": m9, "b": m9};
    let m11 = {"a": m10, "b": m10};
    let m12 = {"a": m11, "b": m11};
    let m13 = {"a": m12, "b": m12};
    let m14 = {"a": m13, "b": m13};
    let m15 = {"a": m14, "b": m14};
    let m16 = {"a": m15, "b": m15};
    let m17 = {"a": m16, "b": m16};
    let m18 = {"a": m17, "b": m17};
    return len(m18);
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    print(f(p));
}
