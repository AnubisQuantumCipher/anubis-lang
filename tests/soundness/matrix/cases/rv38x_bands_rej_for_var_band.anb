struct S { k: secret<i64>, pub_n: i64 }
fn run(p, n) {
    let y = |q| { print(q); 0 };
    let w = [y];
    let r = identity(if n > 0 {
        let t = 0;
        for y in w { t = y; }
        t
    } else { 0 });
    r(p);
    return 0;
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    run(p, 7);
}
