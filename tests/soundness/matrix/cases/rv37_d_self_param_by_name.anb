struct S { k: secret<i64>, pub_n: i64 }
struct T { v: i64 }
struct U { inner: S }
impl T {
  fn add(me, self) { return self; }
  fn show(self) -> str { return "t ${self.v}"; }
}
impl U { fn show(self) -> str { return "u ${self.inner}"; } }
fn main() {
  let p = S { k: 42, pub_n: 3 };
  let u = U { inner: p };
  let mut inv = T { v: 1 };
  inv = inv.add(u);
  println(inv.show());
}