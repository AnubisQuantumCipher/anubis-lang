struct S { k: secret<i64>, pub_n: i64 }
fn show(s) { println(s); return 0; }
fn other(s) { println(1); return 0; }
fn mks(x) { return S { k: 42, pub_n: x }; }
fn mkb() { return mks; }
fn run(p: S) -> i64 {
    let z = reduce([1], |acc, x| acc(x), mkb());
    println(z);
    return 0;
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    run(p);
}
