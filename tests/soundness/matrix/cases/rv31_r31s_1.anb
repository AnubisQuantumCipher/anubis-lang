struct S { k: secret<i64>, pub_n: i64 }
fn f(p) {
    let x = p;
    let a = [0, 0, 0, 0, 0, 0, 0, 0];
    let i = 0;
    while i < 3 {
        a = [a[1], a[2], a[3], a[4], a[5], a[6], a[7], p];
        if i > 100 { x = |y| y; }
        i = i + 1;
    }
    return x;
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    print(f(p));
}
