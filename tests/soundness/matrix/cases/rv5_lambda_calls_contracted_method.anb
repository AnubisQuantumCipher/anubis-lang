fn f(x: i64) -> i64 requires(x > 0) { print("f entered with ${x}"); return x; }
struct S { n: i64 }
impl S { fn m(self, x: i64) -> i64 requires(x > 0) { print("m entered with ${x}"); return x; } }
fn mk(c) { if c > 0 { return |x| S { n: 1 }.m(x); } return |x| x; }
fn main() { let g = mk(1); print(g(-1)); }
