struct S { k: secret<i64>, pub_n: i64 }
fn f(q: S) {
    let r = 0;
    let a0 = 0;
    let a1 = 1;
    let a2 = 2;
    let a3 = 3;
    let a4 = 4;
    let a5 = 5;
    let a6 = 6;
    let a7 = 7;
    let a8 = 8;
    let a9 = 9;
    let a10 = 10;
    let a11 = 11;
    match q.pub_n {
        1 | a0 => {
            r = r + a0;
        match q.pub_n {
            1 | a1 => {
                r = r + a1;
            match q.pub_n {
                1 | a2 => {
                    r = r + a2;
                match q.pub_n {
                    1 | a3 => {
                        r = r + a3;
                    match q.pub_n {
                        1 | a4 => {
                            r = r + a4;
                        match q.pub_n {
                            1 | a5 => {
                                r = r + a5;
                            match q.pub_n {
                                1 | a6 => {
                                    r = r + a6;
                                match q.pub_n {
                                    1 | a7 => {
                                        r = r + a7;
                                    match q.pub_n {
                                        1 | a8 => {
                                            r = r + a8;
                                        match q.pub_n {
                                            1 | a9 => {
                                                r = r + a9;
                                            match q.pub_n {
                                                1 | a10 => {
                                                    r = r + a10;
                                                match q.pub_n {
                                                    1 | a11 => {
                                                        r = r + a11;
                                                    }
                                                    _ => { }
                                                }
                                                }
                                                _ => { }
                                            }
                                            }
                                            _ => { }
                                        }
                                        }
                                        _ => { }
                                    }
                                    }
                                    _ => { }
                                }
                                }
                                _ => { }
                            }
                            }
                            _ => { }
                        }
                        }
                        _ => { }
                    }
                    }
                    _ => { }
                }
                }
                _ => { }
            }
            }
            _ => { }
        }
        }
        _ => { }
    }
    return r;
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    print(f(p));
}
