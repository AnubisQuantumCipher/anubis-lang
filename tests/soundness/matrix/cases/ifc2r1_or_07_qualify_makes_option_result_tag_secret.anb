// Startup: load a secret signing key (the loader rejects an empty path, a public check), then
// continue with ordinary public logging.
fn load_key(path) -> Result<secret<str>, str> {
    if path == "" {
        return Err("no key path configured");
    }
    return Ok("key-material-42");
}

fn start(path) {
    let key = load_key(path)?;
    print("key loaded");
    print("listening on :8080");
    return Ok(0);
}

fn main() {
    let r = start("/etc/app/key.pem");
    print("started");
}
