struct S { k: secret<i64>, pub_n: i64 }
struct T { n: i64 }
struct U { n: i64 }
struct W { t: T, m: i64 }
impl T {
    fn show(self, o) {
        print(self.n);
    }
}
impl U {
    fn show(self, o) {
        print(o);
    }
}
fn same(m: map<str, T>) -> map<str, T> {
    return m;
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    let m = { "a": T { n: 1 } };
    m["a"] = U { n: 2 };
    let z = same(m);
    z["a"].show(p);
}
