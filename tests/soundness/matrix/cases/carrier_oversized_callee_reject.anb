fn f(x: i64) -> i64 requires(x > 0) { return x; }
fn app(g, y) {
    let a = y;
    let a = a + a;
    let a = a + a;
    let a = a + a;
    let a = a + a;
    let a = a + a;
    let a = a + a;
    let a = a + a;
    let a = a + a;
    let a = a + a;
    let a = a + a;
