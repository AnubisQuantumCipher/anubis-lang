struct S { k: secret<i64>, pub_n: i64 }
struct Point { x: i64, y: i64 }
impl Point { fn show(self) -> string { return "${self}"; } }
impl S { fn show(self) -> string { return "S#${self.pub_n}"; } }
struct Team { lead: S, size: i64 }
impl Team { fn show(self) -> string { return "team of ${self.size}"; } }
fn promote(t: Team) -> Team { t.size = t.size + 1; return t; }
fn main() {
    let p = S { k: 42, pub_n: 3 };
    let t = Team { lead: p, size: 1 };
    let u = promote(t);
    println(u.show());
    println(u.lead.show());
}
