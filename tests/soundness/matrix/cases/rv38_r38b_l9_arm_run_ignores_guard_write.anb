struct S { k: secret<i64>, pub_n: i64 }
fn run(p) {
    let h = |q| { print(q); 0 };
    let o = Some(0);
    let r = identity(match o {
        Some(g) if if true { g = h; true } else { false } => g,
        _ => 0,
    });
    r(p);
    return 0;
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    run(p);
}
