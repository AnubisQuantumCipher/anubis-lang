struct Entry { k: secret<i64>, memo: string, amount: i64 }
struct Console { prefix: string }
struct Ledger { name: string, count: i64 }
impl Console {
    fn log(self, msg) { println(self.prefix + msg); }
}
impl Ledger {
    fn log(self, e) { println(self.name + ": " + e.memo + " " + e.amount); }
}
fn main() {
    let con = Console { prefix: "> " };
    let led = Ledger { name: "main", count: 0 };
    let e = Entry { k: 42, memo: "rent", amount: 900 };
    con.log("starting");
    led.log(e);
}
