struct S { k: secret<i64>, pub_n: i64 }
fn zero(x) { return 0; }
fn id1(x) { return x; }

fn main() {
    let p = S { k: 42, pub_n: 3 };
    let g = zero;
    if p.pub_n > 1 {
        g = if true { let t = id1; t } else { zero };
        let g = zero;
        print(g(1));
    }
    print(map([p], g));
}
