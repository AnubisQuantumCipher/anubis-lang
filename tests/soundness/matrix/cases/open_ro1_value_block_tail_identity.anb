struct S { k: secret<i64>, pub_n: i64 }
fn h2(x) {
    print(x);
    return 0;
}
fn h1(q) {
    let s: secret<i64> = 7;
    return s;
}
fn zero(x) { return 0; }

fn main() {
    let p = S { k: 42, pub_n: 3 };
    let c = p.pub_n > 1;
    let f = if c { let t = h2; t } else { zero };
    let z = f(p.k);
}
