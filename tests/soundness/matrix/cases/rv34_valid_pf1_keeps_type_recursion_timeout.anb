struct Acc { n: i64, tag: str }
impl Acc { fn show(self) -> str { return self.tag + str(self.n); } }
fn f0(a: Acc, v: i64) -> Acc { if v == 0 { return f1(a, v + 0); } if v == 1 { return f1(a, v + 1); } if v == 2 { return f1(a, v + 2); } if v == 3 { return f1(a, v + 3); } if v == 4 { return f1(a, v + 4); } if v == 5 { return f1(a, v + 5); } if v == 6 { return f1(a, v + 6); } if v == 7 { return f1(a, v + 7); } if v == 8 { return f1(a, v + 8); } if v == 9 { return f1(a, v + 9); } if v == 10 { return f1(a, v + 10); } if v == 11 { return f1(a, v + 11); } if v == 12 { return f1(a, v + 12); } if v == 13 { return f1(a, v + 13); } if v == 14 { return f1(a, v + 14); } if v == 15 { return f1(a, v + 15); } if v == 16 { return f1(a, v + 16); } if v == 17 { return f1(a, v + 17); } if v == 18 { return f1(a, v + 18); } if v == 19 { return f1(a, v + 19); } return f1(a, 0); }
fn f1(a: Acc, v: i64) -> Acc { if v == 0 { return f2(a, v + 0); } if v == 1 { return f2(a, v + 1); } if v == 2 { return f2(a, v + 2); } if v == 3 { return f2(a, v + 3); } if v == 4 { return f2(a, v + 4); } if v == 5 { return f2(a, v + 5); } if v == 6 { return f2(a, v + 6); } if v == 7 { return f2(a, v + 7); } if v == 8 { return f2(a, v + 8); } if v == 9 { return f2(a, v + 9); } if v == 10 { return f2(a, v + 10); } if v == 11 { return f2(a, v + 11); } if v == 12 { return f2(a, v + 12); } if v == 13 { return f2(a, v + 13); } if v == 14 { return f2(a, v + 14); } if v == 15 { return f2(a, v + 15); } if v == 16 { return f2(a, v + 16); } if v == 17 { return f2(a, v + 17); } if v == 18 { return f2(a, v + 18); } if v == 19 { return f2(a, v + 19); } return f2(a, 0); }
fn f2(a: Acc, v: i64) -> Acc { if v == 0 { return f3(a, v + 0); } if v == 1 { return f3(a, v + 1); } if v == 2 { return f3(a, v + 2); } if v == 3 { return f3(a, v + 3); } if v == 4 { return f3(a, v + 4); } if v == 5 { return f3(a, v + 5); } if v == 6 { return f3(a, v + 6); } if v == 7 { return f3(a, v + 7); } if v == 8 { return f3(a, v + 8); } if v == 9 { return f3(a, v + 9); } if v == 10 { return f3(a, v + 10); } if v == 11 { return f3(a, v + 11); } if v == 12 { return f3(a, v + 12); } if v == 13 { return f3(a, v + 13); } if v == 14 { return f3(a, v + 14); } if v == 15 { return f3(a, v + 15); } if v == 16 { return f3(a, v + 16); } if v == 17 { return f3(a, v + 17); } if v == 18 { return f3(a, v + 18); } if v == 19 { return f3(a, v + 19); } return f3(a, 0); }
fn f3(a: Acc, v: i64) -> Acc { if v == 0 { return Acc { n: 0, tag: "x" }; } if v == 1 { return Acc { n: 1, tag: "x" }; } if v == 2 { return Acc { n: 2, tag: "x" }; } if v == 3 { return Acc { n: 3, tag: "x" }; } if v == 4 { return Acc { n: 4, tag: "x" }; } if v == 5 { return Acc { n: 5, tag: "x" }; } if v == 6 { return Acc { n: 6, tag: "x" }; } if v == 7 { return Acc { n: 7, tag: "x" }; } if v == 8 { return Acc { n: 8, tag: "x" }; } if v == 9 { return Acc { n: 9, tag: "x" }; } if v == 10 { return Acc { n: 10, tag: "x" }; } if v == 11 { return Acc { n: 11, tag: "x" }; } if v == 12 { return Acc { n: 12, tag: "x" }; } if v == 13 { return Acc { n: 13, tag: "x" }; } if v == 14 { return Acc { n: 14, tag: "x" }; } if v == 15 { return Acc { n: 15, tag: "x" }; } if v == 16 { return Acc { n: 16, tag: "x" }; } if v == 17 { return Acc { n: 17, tag: "x" }; } if v == 18 { return Acc { n: 18, tag: "x" }; } if v == 19 { return Acc { n: 19, tag: "x" }; } return Acc { n: 0, tag: "y" }; }
fn main() {
    let mut acc = Acc { n: 0, tag: "t" };
    acc = f0(acc, 0);
    acc = f0(acc, 1);
    acc = f0(acc, 2);
    acc = f0(acc, 0);
    acc = f0(acc, 1);
    acc = f0(acc, 2);
    acc = f0(acc, 0);
    acc = f0(acc, 1);
    acc = f0(acc, 2);
    acc = f0(acc, 0);
    acc = f0(acc, 1);
    acc = f0(acc, 2);
    acc = f0(acc, 0);
    acc = f0(acc, 1);
    acc = f0(acc, 2);
    acc = f0(acc, 0);
    acc = f0(acc, 1);
    acc = f0(acc, 2);
    acc = f0(acc, 0);
    acc = f0(acc, 1);
    acc = f0(acc, 2);
    acc = f0(acc, 0);
    acc = f0(acc, 1);
    acc = f0(acc, 2);
    acc = f0(acc, 0);
    acc = f0(acc, 1);
    acc = f0(acc, 2);
    acc = f0(acc, 0);
    acc = f0(acc, 1);
    acc = f0(acc, 2);
    println(acc.show());
}
