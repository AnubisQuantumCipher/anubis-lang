struct S { k: secret<i64>, pub_n: i64 }
fn f1(s) { f2(s); }
fn f2(s) { f3(s); }
fn f3(s) { f4(s); }
fn f4(s) { f5(s); }
fn f5(s) { f6(s); }
fn f6(s) { f7(s); }
fn f7(s) { f8(s); }
fn f8(s) { f9(s); }
fn f9(s) { f10(s); }
fn f10(s) { print(s); }
fn main() { let p = S { k: 42, pub_n: 3 }; let xs = [p, S { k: 7, pub_n: 1 }]; let m = { "a": p }; f1(xs[0]); }
