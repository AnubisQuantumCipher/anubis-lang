struct S { k: secret<i64>, pub_n: i64 }
fn show(v) { println(v); return true; }
fn showl(v) { println(v); return [1]; }
fn nope(v) { return false; }
fn g(v) {
    let xs = [0];
    match 1 {
        1 if nope(push(xs, v)) => { println("a"); }
        _ => { println(xs); }
    }
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    g(p.k);
}
