struct S { k: secret<i64>, pub_n: i64 }
fn zero(x) { return 0; }
fn zero2(x) { return 2; }
fn id1(x) { return x; }
fn mk() { return id1; }

fn main() {
    let p = S { k: 42, pub_n: 3 };
    let f = zero;
    for mode in [1, 2, 3] {
        f = match mode {
            1 => zero2,
            2 => { let t = zero; t },
            _ => f,
        };
        println(map([p], f));
    }
}
