struct S { k: secret<i64>, pub_n: i64 }
struct T { n: i64 }
struct W { inner: S, n: i64 }
impl T {
    fn show(self) {
        print(self.n);
    }
}
impl W {
    fn show(self) {
        print(self);
    }
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    let push = |a, b| 0;
    let xs = [T { n: 1 }];
    push(xs, W { inner: p, n: 2 });
    let x = if len(xs) > 1 { xs[1] } else { T { n: 3 } };
    x.show();
}
