struct S { k: secret<i64>, pub_n: i64 }
fn zero(x) { return 0; }
fn zero2(x) { return 2; }
fn id1(x) { return x; }
fn mk() { return id1; }

fn main() {
    let p = S { k: 42, pub_n: 3 };
    let g = zero;
    for e in [1, 2] {
        g = if true { let t = id1; t } else { zero };
        let g = zero;
        print(g(1));
        break;
    }
    print(map([p], g));
}
