struct S { k: secret<i64>, pub_n: i64 }
struct T { n: i64 }
struct U { n: i64 }
struct W { t: T, m: i64 }
impl T {
    fn show(self, o) {
        print(self.n);
    }
}
impl U {
    fn show(self, o) {
        print(o);
    }
}
impl W {
    fn bump(self) -> W {
        let c = self;
        c.m = c.m + 1;
        return c;
    }
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    let w = W { t: T { n: 1 }, m: 0 };
    let w2 = w.bump();
    w2.t.show(p);
    print(w2.m);
}
