struct S { k: secret<i64>, pub_n: i64 }
struct T { v: i64 }
struct U { inner: S }
struct W { f: T }
impl T { fn show(self) -> str { return "t ${self.v}"; } }
impl U { fn show(self) -> str { return "u ${self.inner}"; } }
impl W { fn set_f(self, x) -> W { let mut c = self; c.f = x; return c; } }
fn main() {
  let p = S { k: 42, pub_n: 3 };
  let w = W { f: T { v: 0 } };
  let w2 = w.set_f(U { inner: p });
  println(w2.f.show());
}
