struct S { k: secret<i64>, pub_n: i64 }
struct T { n: i64 }
struct U { n: i64 }
struct W { t: T, m: i64 }
impl T {
    fn show(self, o) {
        print(self.n);
    }
}
impl U {
    fn show(self, o) {
        print(o);
    }
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    let us = [U { n: 2 }];
    let r: T = last(us);
    r.show(p);
}
