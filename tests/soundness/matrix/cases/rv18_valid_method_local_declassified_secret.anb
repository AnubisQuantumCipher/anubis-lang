fn getsec() -> secret<i64> { let s: secret<i64> = 42; return s; }
fn pub1() -> i64 { return 1; }
struct B { n: i64 }
impl B { fn pick(self, k) { let t = getsec; print(declassify(t(), "p", "r")); return pub1; } }
fn a(c, g, h) { if c > 5 { return g; } let b = B { n: 1 }; let r = a(c + 1, h, b.pick(1)); return r; }
fn main() { let q = a(1, pub1, pub1); print(q()); }
