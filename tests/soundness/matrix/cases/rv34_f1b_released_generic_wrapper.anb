struct S { k: secret<i64>, pub_n: i64 }
struct W<X> { inner: X }
struct T { n: i64 }
impl S { fn show(self, x) { print(x); return 0; } }
impl T { fn show(self, x) { return 0; } }
fn g(d, p) { return d.inner.show(p); }
fn main() { let p = S { k: 42, pub_n: 3 }; let d = declassify(W { inner: S { k: 1, pub_n: 0 } }, "demo-policy", "public sample"); let z = g(d, p); }