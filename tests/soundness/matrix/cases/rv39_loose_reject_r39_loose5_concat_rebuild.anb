struct S { k: secret<i64>, pub_n: i64 }
struct T { n: i64 }
struct U { n: i64 }
impl T {
    fn show(self, o) {
        print(self.n);
    }
}
impl U {
    fn show(self, o) {
        print(o);
    }
}
fn grow(xs: list<T>, u) -> list<T> {
    xs = xs + [u];
    return xs;
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    let rs = grow([T { n: 1 }], U { n: 2 });
    rs[1].show(p);
}
