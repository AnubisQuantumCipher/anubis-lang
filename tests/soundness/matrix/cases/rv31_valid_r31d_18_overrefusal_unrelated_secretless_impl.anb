struct S { k: secret<i64>, pub_n: i64 }
struct T { name: string, owner: S }
struct U { v: i64 }
impl T {
    fn describe(self) {
        return self.name;
    }
}
impl U {
    fn describe(self) {
        return str(self);
    }
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    let u = U { v: 1 };
    print(u.describe());
    let t = T { name: "tee", owner: p };
    print(t.describe());
}
