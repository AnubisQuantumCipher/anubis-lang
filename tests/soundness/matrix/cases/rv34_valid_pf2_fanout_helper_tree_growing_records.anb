struct S { k: secret<i64>, pub_n: i64 }
fn h0(s: S, r, q) -> str { let a0 = h1(s, [r, s, q], { "x": r, "y": s, "t": q }); let a1 = h1(s, { "x": r, "y": s, "t": q }, [s, q, r, r]); let a2 = h1(s, [s, q, r, r], { "z": [r, q], "w": s }); let a3 = h1(s, { "z": [r, q], "w": s }, [[r], [q], s]); let a4 = h1(s, [[r], [q], s], { "a": { "b": r }, "c": q }); let a5 = h1(s, { "a": { "b": r }, "c": q }, [q, [r, [s]]]); let a6 = h1(s, [q, [r, [s]]], [r, s, q]); return a0 + a1 + a2 + a3 + a4 + a5 + a6; }
fn h1(s: S, r, q) -> str { let a0 = h2(s, [r, s, q], { "x": r, "y": s, "t": q }); let a1 = h2(s, { "x": r, "y": s, "t": q }, [s, q, r, r]); let a2 = h2(s, [s, q, r, r], { "z": [r, q], "w": s }); let a3 = h2(s, { "z": [r, q], "w": s }, [[r], [q], s]); let a4 = h2(s, [[r], [q], s], { "a": { "b": r }, "c": q }); let a5 = h2(s, { "a": { "b": r }, "c": q }, [q, [r, [s]]]); let a6 = h2(s, [q, [r, [s]]], [r, s, q]); return a0 + a1 + a2 + a3 + a4 + a5 + a6; }
fn h2(s: S, r, q) -> str { let a0 = h3(s, [r, s, q], { "x": r, "y": s, "t": q }); let a1 = h3(s, { "x": r, "y": s, "t": q }, [s, q, r, r]); let a2 = h3(s, [s, q, r, r], { "z": [r, q], "w": s }); let a3 = h3(s, { "z": [r, q], "w": s }, [[r], [q], s]); let a4 = h3(s, [[r], [q], s], { "a": { "b": r }, "c": q }); let a5 = h3(s, { "a": { "b": r }, "c": q }, [q, [r, [s]]]); let a6 = h3(s, [q, [r, [s]]], [r, s, q]); return a0 + a1 + a2 + a3 + a4 + a5 + a6; }
fn h3(s: S, r, q) -> str { let a0 = h4(s, [r, s, q], { "x": r, "y": s, "t": q }); let a1 = h4(s, { "x": r, "y": s, "t": q }, [s, q, r, r]); let a2 = h4(s, [s, q, r, r], { "z": [r, q], "w": s }); let a3 = h4(s, { "z": [r, q], "w": s }, [[r], [q], s]); let a4 = h4(s, [[r], [q], s], { "a": { "b": r }, "c": q }); let a5 = h4(s, { "a": { "b": r }, "c": q }, [q, [r, [s]]]); let a6 = h4(s, [q, [r, [s]]], [r, s, q]); return a0 + a1 + a2 + a3 + a4 + a5 + a6; }
fn h4(s: S, r, q) -> str { let a0 = h5(s, [r, s, q], { "x": r, "y": s, "t": q }); let a1 = h5(s, { "x": r, "y": s, "t": q }, [s, q, r, r]); let a2 = h5(s, [s, q, r, r], { "z": [r, q], "w": s }); let a3 = h5(s, { "z": [r, q], "w": s }, [[r], [q], s]); let a4 = h5(s, [[r], [q], s], { "a": { "b": r }, "c": q }); let a5 = h5(s, { "a": { "b": r }, "c": q }, [q, [r, [s]]]); let a6 = h5(s, [q, [r, [s]]], [r, s, q]); return a0 + a1 + a2 + a3 + a4 + a5 + a6; }
fn h5(s: S, r, q) -> str { let a0 = h6(s, [r, s, q], { "x": r, "y": s, "t": q }); let a1 = h6(s, { "x": r, "y": s, "t": q }, [s, q, r, r]); let a2 = h6(s, [s, q, r, r], { "z": [r, q], "w": s }); let a3 = h6(s, { "z": [r, q], "w": s }, [[r], [q], s]); let a4 = h6(s, [[r], [q], s], { "a": { "b": r }, "c": q }); let a5 = h6(s, { "a": { "b": r }, "c": q }, [q, [r, [s]]]); let a6 = h6(s, [q, [r, [s]]], [r, s, q]); return a0 + a1 + a2 + a3 + a4 + a5 + a6; }
fn h6(s: S, r, q) -> str { let a0 = h7(s, [r, s, q], { "x": r, "y": s, "t": q }); let a1 = h7(s, { "x": r, "y": s, "t": q }, [s, q, r, r]); let a2 = h7(s, [s, q, r, r], { "z": [r, q], "w": s }); let a3 = h7(s, { "z": [r, q], "w": s }, [[r], [q], s]); let a4 = h7(s, [[r], [q], s], { "a": { "b": r }, "c": q }); let a5 = h7(s, { "a": { "b": r }, "c": q }, [q, [r, [s]]]); let a6 = h7(s, [q, [r, [s]]], [r, s, q]); return a0 + a1 + a2 + a3 + a4 + a5 + a6; }
fn h7(s: S, r, q) -> str { return str(s.pub_n); }
fn main() {
    let p = S { k: 42, pub_n: 3 };
    println(h0(p, p, [p]));
}
