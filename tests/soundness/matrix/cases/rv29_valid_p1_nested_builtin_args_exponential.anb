    let ids = [1, 2];
    print(len(map(enumerate(map(enumerate(map(enumerate(map(enumerate(map(enumerate(map(enumerate(map(enumerate(xs), |pr| pr[1])), |pr| pr[1])), |pr| pr[1])), |pr| pr[1])), |pr| pr[1])), |pr| pr[1])), |pr| pr[1])));
}
