struct Row { k: secret<bool>, n: bool }

fn emit(t: secret<bool>) {
    let s: secret<bool> = true;
    let once: secret<bool> = true;
    let row = Row { k: t, n: false };
    while s {
        row.n = !row.n;
        s = t && once;
        once = false;
    }
    println(row.n);
}

fn main() { emit(false); emit(true); }
