struct S { k: secret<i64>, pub_n: i64 }
struct T { n: i64 }
struct U { n: i64 }
impl T {
    fn show(self, o) {
        print(self.n);
    }
}
impl U {
    fn show(self, o) {
        print(o);
    }
}
fn mk() {
    return U { n: 2 };
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    let x: T = mk();
    x.show(p);
}
