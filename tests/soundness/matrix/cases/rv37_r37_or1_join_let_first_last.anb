struct Account { k: secret<i64>, owner: str }
struct Invoice { id: i64, total: i64, account: Account }
struct Tag { label: str }
impl Invoice {
    fn same(self, other: Invoice) -> bool {
        return self.id == other.id;
    }
}
impl Tag {
    fn same(self, other: Tag) -> bool {
        return self == other;
    }
}
fn main() {
    let acct = Account { k: 42, owner: "ann" };
    let a = Tag { label: "x" };
    let b = Tag { label: "y" };
    println("tags equal: ${a.same(b)}");
    let invs = [Invoice { id: 1, total: 10, account: acct }, Invoice { id: 2, total: 20, account: acct }];
    let fallback = Invoice { id: 0, total: 0, account: acct };
    let first = if len(invs) > 0 { invs[0] } else { fallback };
    let last = if len(invs) > 1 { invs[1] } else { fallback };
    println("first is last: ${first.same(last)}");
}
