struct S { k: secret<i64>, pub_n: i64 }
struct T { v: i64 }
struct U { inner: S }
struct W { f: T }
impl T { fn show(self) -> str { return "t ${self.v}"; } }
impl U { fn show(self) -> str { return "u ${self.inner}"; } }
struct H { n: i64 }
impl H { fn pick(self, w: W) -> W { return w; } }
fn main() {
  let p = S { k: 42, pub_n: 3 };
  let mut w = W { f: T { v: 0 } };
  w.f = U { inner: p };
  let h = H { n: 1 };
  let w2 = h.pick(w);
  println(w2.f.show());
}
