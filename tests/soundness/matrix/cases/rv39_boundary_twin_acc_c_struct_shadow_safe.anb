struct S { k: secret<i64>, pub_n: i64 }
fn zero(x) { return 0; }
fn zero2(x) { return 2; }
fn id1(x) { return x; }
fn mk() { return id1; }

fn main() {
    let p = S { k: 42, pub_n: 3 };
    let q = 0;
    if p.pub_n > 1 {
        q = p.pub_n;
        let q = p;
        print(q.pub_n);
    }
    print(q);
}
