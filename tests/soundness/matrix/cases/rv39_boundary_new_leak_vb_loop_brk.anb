struct S { k: secret<i64>, pub_n: i64 }
fn zero(x) { return 0; }

fn main() {
    let p = S { k: 42, pub_n: 3 };
    let z = if p.pub_n > 0 {
        let t = zero;
        let i = 0;
        loop {
            if i == 0 { t = println; break; }
            t = zero;
            i = i + 1;
        }
        print(map([p], t));
        0
    } else { 0 };
    print(z);
