    let a10: T = match mode { 0 => a9.next(), _ => b9.next() };
    let b10: T = match mode { 0 => b9.next(), _ => a9.next() };
    let a11: T = match mode { 0 => a10.next(), _ => b10.next() };
    let b11: T = match mode { 0 => b10.next(), _ => a10.next() };
    let a12: T = match mode { 0 => a11.next(), _ => b11.next() };
    let b12: T = match mode { 0 => b11.next(), _ => a11.next() };
    let a13: T = match mode { 0 => a12.next(), _ => b12.next() };
