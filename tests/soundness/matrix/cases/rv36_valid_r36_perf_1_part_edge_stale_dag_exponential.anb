struct S { k: secret<i64>, pub_n: i64 }
struct T { v: i64 }
impl T {
    fn show(self) -> str {
        return "t ${self.v}";
    }
    fn next(self) -> T {
        return T { v: self.v + 1 };
    }
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    let mode = 1;
    let a0: T = T { v: 1 };
    let b0: T = T { v: 2 };
    let a1: T = match mode { 0 => a0.next(), _ => b0.next() };
