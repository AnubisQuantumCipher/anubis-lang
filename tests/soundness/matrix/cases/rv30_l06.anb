struct S { k: secret<i64>, pub_n: i64 }
fn f(p) {
    let mut a1 = |z| z;
    let mut a2 = |z| z;
    let mut a3 = |z| z;
    let mut a4 = |z| z;
    let mut a5 = |z| z;
    let mut a6 = |z| z;
    let mut a7 = |z| z;
    let mut a8 = |z| z;
    let mut a9 = 0;
    let mut i = 0;
    while i < 10 {
        a1 = a2;
        a2 = a3;
        a3 = a4;
        a4 = a5;
        a5 = a6;
        a6 = a7;
        a7 = a8;
        a8 = a9;
        a9 = p;
        i = i + 1;
    }
    print(a1);
    return 0;
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    let r = f(p);
}
