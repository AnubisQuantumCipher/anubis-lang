struct S { k: secret<i64>, pub_n: i64 }
fn f(p: S) -> i64 {
    let u = 0;
    let v = if true { u = [u, p]; let a = if true { u = [u, p]; let a = if true { u = [u, p]; let a = if true { u = [u, p]; let a = if true { u = [u, p]; let a = if true { u = [u, p]; let a = if true { u = [u, p]; let a = if true { u = [u, p]; let a = if true { u = [u, p]; let a = if true { u = [u, p]; let a = if true { u = [u, p]; let a = if true { u = [u, p]; let a = 0; a } else { 0 }; a } else { 0 }; a } else { 0 }; a } else { 0 }; a } else { 0 }; a } else { 0 }; a } else { 0 }; a } else { 0 }; a } else { 0 }; a } else { 0 }; a } else { 0 }; a } else { 0 };
    return len(str(v));
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    print(f(p));
}
