struct Employee { k: secret<i64>, pin: secret<str>, name: str, role: str }
struct Team { name: str, members: list<Employee> }
impl Employee {
    fn card(self) -> str {
        return "${self}";
    }
}
impl Team {
    fn card(self) -> str {
        let mut names = [];
        for m in self.members {
            push(names, m.name);
        }
        return "team ${self.name}: ${join(names, ", ")}";
    }
}
fn main() {
    let e1 = Employee { k: 42, pin: "1234", name: "ann", role: "dev" };
    let e2 = Employee { k: 7, pin: "9999", name: "bob", role: "ops" };
    let team = Team { name: "core", members: [e1, e2] };
    println(team.card());
    let d = declassify(if e1.k > 5 { 1 } else { 0 }, "audit", "aggregate released for audit");
    println("audit ok");
}
