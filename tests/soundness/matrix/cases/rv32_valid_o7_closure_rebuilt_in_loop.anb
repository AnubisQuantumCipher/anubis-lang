struct S { k: secret<i64>, pub_n: i64 }
fn work(xs) {
    let mut f = |x| x.pub_n;
    let mut t = 0;
    for x0 in xs {
        let f0 = f;
        f = |x| f0(x) + x0.pub_n;
        t = t + f(x0);
    }
    return t;
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    let xs = [p, S { k: 7, pub_n: 1 }];
    println(str(work(xs)));
}
