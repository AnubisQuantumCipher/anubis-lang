// Staff directory: every user has a secret PIN. The roster report prints names and roles only.
struct User {
    name: str,
    role: str,
    email: str,
    dept: str,
    pin: secret<i64>,
}

fn roster(users) {
    let mut admins = 0;
    for u in users {
        print(u.name + " (" + u.role + ")");
        if u.role == "admin" {
            admins = admins + 1;
        }
    }
    print("admins: " + str(admins));
}

