struct Item { k: secret<i64>, sku: string, qty: i64 }
struct Stats { total: i64, n: i64 }
struct Inventory { count: i64, skus: string }
impl Stats {
    fn add(self, x) { return Stats { total: self.total + x, n: self.n + 1 }; }
    fn show(self) { return "total=" + self.total + " n=" + self.n; }
}
impl Inventory {
    fn add(self, it) { return Inventory { count: self.count + it.qty, skus: self.skus + it.sku + ";" }; }
    fn show(self) { return "count=" + self.count + " skus=" + self.skus; }
}
fn main() {
    let items = [Item { k: 42, sku: "A1", qty: 3 }, Item { k: 43, sku: "B2", qty: 5 }];
    let inv = Inventory { count: 0, skus: "" };
    let st = Stats { total: 0, n: 0 };
    for it in items {
        inv = inv.add(it);
        st = st.add(it.qty);
    }
    println(inv.show());
    println(st.show());
}
