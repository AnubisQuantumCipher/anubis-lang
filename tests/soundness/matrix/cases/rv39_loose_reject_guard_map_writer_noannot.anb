struct S { k: secret<i64>, pub_n: i64 }
struct T { n: i64 }
struct U { n: i64 }
struct W { t: T, m: i64 }
impl T {
    fn show(self, o) {
        print(self.n);
    }
}
impl U {
    fn show(self, o) {
        print(o);
    }
}
fn set_t(w: W) -> W {
    w.t = U { n: 2 };
    return w;
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    let rs = map([W { t: T { n: 1 }, m: 0 }], set_t);
    rs[0].t.show(p);
}
