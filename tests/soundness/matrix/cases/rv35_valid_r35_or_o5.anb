struct S { k: secret<i64>, pub_n: i64 }
fn main() {
    let p = S { k: 42, pub_n: 3 };
    let xs = [p, S { k: 7, pub_n: 1 }];
    let mut f = |y| y + p.pub_n;
    let mut outs = [];
    for x in xs {
        let g = f;
        f = |y| g(y) + x.pub_n;
        push(outs, f(1));
    }
    println(outs);
}
