struct S { k: secret<i64>, pub_n: i64 }
struct T { v: i64 }
struct U { inner: S }
struct W { f: T }
impl T { fn show(self) -> str { return "t ${self.v}"; } }
impl U { fn show(self) -> str { return "u ${self.inner}"; } }
fn main() {
  let p = S { k: 42, pub_n: 3 };
  let ws = [W { f: T { v: 0 } }];
  let mut x = ws[0];
  x.f = U { inner: p };
  let x = x.f;
  println(x.show());
}
