struct S { k: secret<i64>, pub_n: i64 }
fn f(p, n) {
    let mut m = { "a": 0 };
    let mut i0 = 0;
    while i0 < n {
        m["k0"] = [get(m, "k1", 0), p];
        m["k1"] = [get(m, "k2", 0), p];
        m["k2"] = [get(m, "k3", 0), p];
        m["k3"] = [get(m, "k4", 0), p];
        m["k4"] = [get(m, "k5", 0), p];
