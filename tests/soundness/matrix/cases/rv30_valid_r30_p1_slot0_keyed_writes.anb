        m["k74"] = [get(m, "k75", 0), p];
        m["k75"] = [get(m, "k76", 0), p];
        m["k76"] = [get(m, "k77", 0), p];
        m["k77"] = [get(m, "k78", 0), p];
        m["k78"] = [get(m, "k79", 0), p];
        m["k79"] = [get(m, "k0", 0), p];
        i0 = i0 + 1;
    }
    return len(m);
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    print(f(p, 1));
}
