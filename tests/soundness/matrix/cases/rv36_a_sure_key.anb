struct S { k: secret<i64>, pub_n: i64 }
struct W { n: i64 }
impl S { fn show(self, x) { print(x); return 0; } }
impl W { fn show(self, x) { return 0; } }
fn g(d, q) { return d.show(q); }
fn main() {
    let p = S { k: 42, pub_n: 3 };
    let t: W = declassify(S { k: 1, pub_n: 0 }, "demo-policy", "public sample");
    let z1 = g(W { n: 1 }, p);
    let z2 = g(t, p);
    print(0);
}
