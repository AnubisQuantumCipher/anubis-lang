struct S { k: secret<i64>, pub_n: i64 }
struct A { v: i64 }
impl S { fn m(self, x) { return 0; } }
impl A { fn m(self, x) { print(x); return 0; } }
fn g(xs, x) {
    let mut n = 0;
    for r in xs {
        n = n + r.m(x);
    }
    return n;
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    let a = A { v: 1 };
    let z = g([a, p], p);
}
