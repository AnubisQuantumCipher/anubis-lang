struct S { k: secret<i64>, pub_n: i64 }
fn f(q: S) {
    let x = 0;
    let i = 0;
    while i < 3 {
        i = i + 1;
        if i == 3 { return x; }
        x = q.k;
        match q.pub_n > 1 {
            true => continue,
            _ => {}
        }
        x = 0;
    }
    return 0;
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    print(f(p));
}
