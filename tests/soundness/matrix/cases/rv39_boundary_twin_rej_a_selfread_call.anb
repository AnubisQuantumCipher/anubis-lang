struct S { k: secret<i64>, pub_n: i64 }
fn zero(x) { return 0; }
fn zero2(x) { return 2; }
fn id1(x) { return x; }
fn mk() { return id1; }

fn main() {
    let p = S { k: 42, pub_n: 3 };
    let g = zero;
    for i in 0..2 {
        g = if i == 1 { let t = mk(); t } else { g };
    }
    print(map([p], g));
}
