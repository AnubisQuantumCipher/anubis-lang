struct Account { id: i64, owner: string, k: secret<i64>, balance: i64 }

fn lookup(xs, id) {
    let hits = filter(xs, |a| a.id == id);
    if is_empty(hits) {
        return None;
    }
    return Some(hits[0]);
}

fn owner(xs, id) {
    if let Some(a) = lookup(xs, id) {
        return a.owner;
    }
    return "?";
}

fn main() {
    let accts = [Account { id: 1, owner: "ann", k: 42, balance: 100 }, Account { id: 2, owner: "bob", k: 7, balance: 250 }, Account { id: 3, owner: "cy", k: 9, balance: 175 }];
    print(owner(accts, 2));
    print(owner(accts, 9));
}
