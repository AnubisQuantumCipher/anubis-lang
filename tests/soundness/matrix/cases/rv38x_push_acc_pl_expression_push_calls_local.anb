struct S { k: secret<i64>, pub_n: i64 }
struct T { n: i64 }
struct U { n: i64 }
impl T {
    fn show(self, o) {
        print(self.n);
    }
}
impl U {
    fn show(self, o) {
        print(o);
    }
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    let push = |a, b| a;
    let xs = [T { n: 1 }];
    let ys = push(xs, U { n: 2 });
    let x = if len(xs) > 1 { xs[1] } else { T { n: 3 } };
    x.show(p);
    print(len(ys));
}
