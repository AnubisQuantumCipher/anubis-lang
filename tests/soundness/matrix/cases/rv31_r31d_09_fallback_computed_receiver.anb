struct S { k: secret<i64>, pub_n: i64 }
struct U { v: i64 }
impl S {
    fn out(self) {
        return self;
    }
}
impl U {
    fn out(self) {
        return 0;
    }
}
fn g(p, n) {
    let a0 = p;
    let a1 = 0;
    let a2 = 0;
    let a3 = 0;
    let a4 = 0;
    let a5 = 0;
    let a6 = 0;
    let a7 = 0;
    let a8 = 0;
    let a9 = 0;
    let a10 = 0;
    let a11 = 0;
    let a12 = 0;
    let a13 = 0;
    let a14 = 0;
    let a15 = 0;
    let a16 = 0;
    let a17 = 0;
    let a18 = 0;
    let a19 = 0;
    let a20 = 0;
    let a21 = 0;
    let a22 = 0;
    let a23 = 0;
    let a24 = 0;
    let a25 = 0;
    let i = 0;
    while i < n {
        a25 = a24;
        a24 = a23;
        a23 = a22;
        a22 = a21;
        a21 = a20;
        a20 = a19;
        a19 = a18;
        a18 = a17;
        a17 = a16;
        a16 = a15;
        a15 = a14;
        a14 = a13;
        a13 = a12;
        a12 = a11;
        a11 = a10;
        a10 = a9;
        a9 = a8;
        a8 = a7;
        a7 = a6;
        a6 = a5;
        a5 = a4;
        a4 = a3;
        a3 = a2;
        a2 = a1;
        a1 = a0;
        i = i + 1;
    }
    return a0.out();
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    let u = U { v: 1 };
    print(u.out());
    print(g(p, 2));
}
