struct S { k: secret<i64>, pub_n: i64 }
fn g0(acc, x, d) {
    if d <= 0 {
        return acc;
    }
    let c0 = [acc, x, 0];
    let c1 = [acc, x, 1];
    let c2 = [acc, x, 2];
    let c3 = [acc, x, 3];
    let c4 = [acc, x, 4];
    let a = g0(acc, [x], d - 1);
    let b = g1([acc, x], x, d - 1);
    return [a, b];
}
