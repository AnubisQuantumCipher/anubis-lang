struct S { k: secret<i64>, pub_n: i64 }
struct W { s: S, n: i64 }
fn pick(xs) { let x = xs[0]?; return Ok(x); }
fn main() {
    let p = S { k: 42, pub_n: 3 };
    let xs = [p, S { k: 7, pub_n: 1 }];
    let m = { "a": p };
    let r = pick([Ok(p), Err("e")]);
    match r { Ok(v) => print(v.pub_n), Err(e) => print(e) }
}
