struct S { k: secret<i64>, pub_n: i64 }
fn f10(x) {
    print(x["a"]["a"]["a"]["a"]["a"]["a"]["a"]["a"]["a"]);
}
fn f9(x) {
    f10({ "a": x });
}
fn f8(x) {
    f9({ "a": x });
}
fn f7(x) {
    f8({ "a": x });
}
fn f6(x) {
    f7({ "a": x });
}
fn f5(x) {
    f6({ "a": x });
}
fn f4(x) {
    f5({ "a": x });
}
fn f3(x) {
    f4({ "a": x });
}
fn f2(x) {
    f3({ "a": x });
}
fn f1(x) {
    f2({ "a": x });
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    f1(p);
}
