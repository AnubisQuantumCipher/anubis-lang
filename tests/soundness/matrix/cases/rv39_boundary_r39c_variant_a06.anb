struct S { k: secret<i64>, pub_n: i64 }
fn zero(x) { return 0; }

fn main() {
    let p = S { k: 42, pub_n: 3 };
    let g = |x| 0;
    let i = 0;
    while let Some(e) = if i < 3 { Some(i) } else { None } {
        if e == 0 { g = println; break; }
        g = |x| 0;
        i = i + 1;
    }
    print(map([p], g));
}
