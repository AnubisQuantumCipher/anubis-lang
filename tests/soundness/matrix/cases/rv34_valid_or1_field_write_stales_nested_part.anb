struct Account { k: secret<i64>, id: i64, owner: str }
struct Ledger { count: i64, total: i64 }
struct Audit { lines: list<str> }
struct Book { led: Ledger, n: i64, notes: list<str> }

impl Ledger {
    fn add(self, a: Account) -> Ledger { return Ledger { count: self.count + 1, total: self.total + a.id }; }
    fn show(self) -> str { return "count=" + str(self.count) + " total=" + str(self.total); }
}
impl Audit {
    fn add(self, line: str) -> Audit { return Audit { lines: self.lines + [line] }; }
    fn show(self) -> str { return join(self.lines, ";"); }
}


fn main() {
    let p = Account { k: 42, id: 3, owner: "ann" };
    let xs = [p, Account { k: 7, id: 1, owner: "bob" }];
    let led = Ledger { count: 0, total: 0 };
    let mut book = Book { led: led, n: 0, notes: [] };
    for a in xs {
        book.n = book.n + 1;
    }
    let l2 = book.led.add(p);
    println(l2.show() + " n=" + str(book.n));
}
