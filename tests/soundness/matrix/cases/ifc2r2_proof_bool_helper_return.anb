fn committed() { proof_commit_bool("flag", P { v: 1 }) }
struct P { v: i64 }
struct Q { v: i64 }
impl P {
    fn m(self) {
        0
    }
}
impl Q {
    fn m(self, x) {
        0
    }
}
fn pick(c) {
    let v = if c { 7 } else { 3 };
    v
}
fn main() {
    let s: secret<i64> = 42;
    let r = committed();
    let y = r.m(println(pick(s > 100)));
    println("end");
}
