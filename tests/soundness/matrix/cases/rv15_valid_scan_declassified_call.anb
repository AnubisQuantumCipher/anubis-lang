fn getsec() -> secret<i64> { let s: secret<i64> = 42; return s; }
fn pub1() -> i64 { return 1; }
fn pub2() -> i64 { return 2; }
fn pick(c) { let t = [pub2]; t = [pub1]; let z = declassify(getsec(), "p", "r"); print(z); if c > 5 { return pub2; } return t[0]; }
fn main() { let h = pick(1); print(h()); }
