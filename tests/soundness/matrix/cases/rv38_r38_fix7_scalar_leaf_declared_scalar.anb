struct S { k: secret<i64>, pub_n: i64 }
struct T { n: i64 }
struct U { n: i64 }
impl T {
    fn show(self, o) {
        print(self.n);
    }
}
impl U {
    fn show(self, o) {
        print(o);
    }
}
fn mk() {
    return U { n: 2 };
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    let n: i64 = mk();
    let c = len(str(p.pub_n)) > 5;
    let xs = if c { [T { n: 1 }] } else { [n] };
    xs[0].show(p);
}
