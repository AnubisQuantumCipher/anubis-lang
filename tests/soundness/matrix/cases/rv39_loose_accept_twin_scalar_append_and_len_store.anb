struct S { k: secret<i64>, pub_n: i64 }
struct T { n: i64 }
struct U { n: i64 }
struct W { t: T, m: i64 }
impl T {
    fn show(self, o) {
        print(self.n);
    }
}
impl U {
    fn show(self, o) {
        print(o);
    }
}
fn stamp(w: W, n: i64) -> W {
    let log = [0];
    log = log + [n];
    w.m = len(log);
    return w;
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    let w = stamp(W { t: T { n: 1 }, m: 0 }, 3);
    w.t.show(p);
}
