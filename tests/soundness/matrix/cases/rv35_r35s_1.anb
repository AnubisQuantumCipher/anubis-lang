struct S { k: secret<i64>, pub_n: i64 }
impl S {
    fn show(self, other) {
        print(other);
        return 0;
    }
}
fn run(ys, p) {
    return match ys {
        [g] => g.show(p),
        _ => 0,
    };
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    let q = S { k: 7, pub_n: 1 };
    let r = run([q], p);
}
