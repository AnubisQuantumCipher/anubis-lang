struct Account { k: secret<i64>, id: i64, balance: i64 }
struct Report { title: string, ids: list<i64> }
struct Console { prefix: string }
impl Report {
    fn render(self, accts) {
        for a in accts { print("${self.title} #${a.id} bal=${a.balance}"); }
        print("${self.title}: ${len(self.ids)} accounts");
    }
}
impl Console {
    fn render(self, lines) {
        for l in lines { print("${self.prefix}${l}"); }
    }
}
fn main() {
    let accts = [Account { k: 42, id: 1, balance: 10 }, Account { k: 7, id: 2, balance: 20 }];
    let ids = [];
    for a in accts { push(ids, a.id); }
    let rep = Report { title: "accts", ids: ids };
    rep.render(accts);
    let con = Console { prefix: "> " };
    con.render(["done"]);
}
