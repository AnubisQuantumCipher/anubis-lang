struct User { k: secret<i64>, id: i64, name: string }
struct Ticket { title: string, owner: User }
struct Point { x: i64, y: i64 }
impl Point {
    fn describe(self) { return "point " + str(self); }
}
impl Ticket {
    fn describe(self) { return self.title + " for " + self.owner.name; }
}
fn main() {
    let u = User { k: 42, id: 1, name: "ann" };
    let t = Ticket { title: "fix login", owner: u };
    println(Point { x: 1, y: 2 }.describe());
    println(t.describe());
}
