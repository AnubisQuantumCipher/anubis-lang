struct S { k: secret<i64>, pub_n: i64 }
fn main() {
    let p = S { k: 42, pub_n: 3 };
    let c = p.pub_n > 1;
    let x = 0;
    let i = 0;
    while i < 2 {
        i = i + 1;
        if i == 2 { print(x); }
        x = p.k;
        match c {
            true => continue,
            _ => {}
        }
        x = 0;
    }
}
