struct S { k: secret<i64>, pub_n: i64 }
fn main() {
  let p = S { k: 42, pub_n: 3 };
  let xs = [p, S { k: 7, pub_n: 1 }];
  let m = { "a": p };
  let mut w = [0, 0, 0, 0, 0, 0];
  for q in xs {
    w[5] = w[4];
    w[4] = w[3];
    w[3] = w[2];
    w[2] = w[1];
    w[1] = w[0];
    w[0] = q;
  }
  print(len(w));
}