struct S { k: secret<i64>, pub_n: i64 }
fn zero(x) { return 0; }
fn zero2(x) { return 2; }
fn id1(x) { return x; }
fn mk() { return id1; }

fn main() {
    let p = S { k: 42, pub_n: 3 };
    let state = zero;
    let tick = 0;
    while tick < 4 {
        println(map([p], state));
        let next = if tick % 2 == 0 { let t = println; t } else { zero };
        state = next;
        tick = tick + 1;
    }
}
