struct S { k: secret<i64>, pub_n: i64 }
struct Acc { total: i64, peak: i64 }
fn f(q: S) {
    let mut a = Acc { total: 0, peak: 0 };
    for i in 0..3 {
        a.total = a.total + i;
        if i == 1 { a.peak = q.k; }
    }
    return a.total;
}
fn main() { let p = S { k: 42, pub_n: 3 }; print(f(p)); }
