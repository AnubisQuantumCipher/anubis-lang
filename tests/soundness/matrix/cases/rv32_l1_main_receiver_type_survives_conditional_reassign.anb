struct S { k: secret<i64>, pub_n: i64 }
struct Console { prefix: string }
impl Console {
    fn write(self, msg) {
        println(self.prefix + str(msg));
        return 0;
    }
}
struct Ledger { total: i64 }
impl Ledger {
    fn write(self, e) {
        return self.total + e.pub_n;
    }
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    let mut b = Ledger { total: 1 };
    let n = 1;
    if n > 0 {
        b = Console { prefix: "log: " };
    }
    b.write(p);
}
