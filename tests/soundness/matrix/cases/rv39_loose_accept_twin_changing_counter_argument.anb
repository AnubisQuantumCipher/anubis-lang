struct S { k: secret<i64>, pub_n: i64 }
struct T { n: i64 }
struct U { n: i64 }
struct W { t: T, m: i64 }
impl T {
    fn show(self, o) {
        print(self.n);
    }
}
impl U {
    fn show(self, o) {
        print(o);
    }
}
fn mk(t: T, i: i64) -> W {
    return W { t: t, m: i };
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    let mut i = 0;
    while i < 3 {
        let w = mk(T { n: 1 }, i);
        w.t.show(p);
        i = i + 1;
    }
}
