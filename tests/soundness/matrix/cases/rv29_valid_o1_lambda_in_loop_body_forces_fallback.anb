struct S { k: secret<i64>, pub_n: i64 }
fn f(xs) {
    let total = 0
    for s in xs {
        let h = |t| t.pub_n * 10
        total = total + h(s)
    }
    return [total, len(xs), xs[0].pub_n]
}
fn main() {
    let p = S { k: 42, pub_n: 3 }
    let xs = [p, S { k: 7, pub_n: 1 }]
    print(f(xs))
}
