struct Account { k: secret<i64>, owner: str }
struct Invoice { id: i64, total: i64, account: Account }
struct Tag { label: str }
impl Invoice {
    fn summary(self) -> str {
        return "invoice ${self.id}: ${self.total}";
    }
}
impl Tag {
    fn summary(self) -> str {
        return "tag ${self}";
    }
}
fn main() {
    let acct = Account { k: 42, owner: "ann" };
    let invs = [Invoice { id: 1, total: 10, account: acct }, Invoice { id: 2, total: 20, account: acct }];
    let t = Tag { label: "urgent" };
    println(t.summary());
    let inv = Invoice { id: 3, total: 30, account: acct };
    let big = filter(invs, |inv| inv.total > 15);
    println("big ${len(big)}");
    let current = if len(big) > 5 { inv } else { Invoice { id: 0, total: 0, account: acct } };
    println(current.summary());
}
