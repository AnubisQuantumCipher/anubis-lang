struct S { k: secret<i64>, pub_n: i64 }
struct B { n: i64 }
impl S {
    fn describe(self) {
        return str(self);
    }
    fn run_with(self, b) {
        return b.apply(|z| self.describe());
    }
}
impl B {
    fn describe(self) {
        return "B" + str(self.n);
    }
    fn apply(self, f) {
        return f(0);
    }
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    let xs = [p, S { k: 7, pub_n: 1 }];
    print(p.run_with(B { n: 1 }));
}
