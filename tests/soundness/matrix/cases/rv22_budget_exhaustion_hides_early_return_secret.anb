fn getsec() -> secret<i64> { let s: secret<i64> = 42; return s; }
fn pub1() -> i64 { return 1; }
fn pub2() -> i64 { return 2; }
fn pick(g, c) { if c < 5 { return g; } return pub1; }
fn q0_0(c) { if c > 50 { return q1_0(c); } if c > 40 { return q1_1(c); } return q1_2(c); }
fn q0_1(c) { if c > 50 { return q1_0(c); } if c > 40 { return q1_1(c); } return q1_2(c); }
fn q0_2(c) { if c > 50 { return q1_0(c); } if c > 40 { return q1_1(c); } return q1_2(c); }
fn q1_0(c) { if c > 50 { return q2_0(c); } if c > 40 { return q2_1(c); } return q2_2(c); }
fn q1_1(c) { if c > 50 { return q2_0(c); } if c > 40 { return q2_1(c); } return q2_2(c); }
fn q1_2(c) { if c > 50 { return q2_0(c); } if c > 40 { return q2_1(c); } return q2_2(c); }
fn q2_0(c) { if c > 50 { return q3_0(c); } if c > 40 { return q3_1(c); } return q3_2(c); }
fn q2_1(c) { if c > 50 { return q3_0(c); } if c > 40 { return q3_1(c); } return q3_2(c); }
fn q2_2(c) { if c > 50 { return q3_0(c); } if c > 40 { return q3_1(c); } return q3_2(c); }
fn q3_0(c) { if c > 0 { return pub1; } return pub2; }
fn q3_1(c) { if c > 1 { return pub1; } return pub2; }
fn q3_2(c) { if c > 2 { return pub1; } return pub2; }
fn main() {
  let x0 = q0_0(0); print(x0());
  let x1 = q0_0(1); print(x1());
  let x2 = q0_0(2); print(x2());
  let x3 = q0_0(3); print(x3());
  let x4 = q0_0(4); print(x4());
  let x5 = q0_0(5); print(x5());
  let x6 = q0_0(6); print(x6());
  let x7 = q0_0(7); print(x7());
  let x8 = q0_0(8); print(x8());
  let x9 = q0_0(9); print(x9());
  let x10 = q0_0(10); print(x10());
  let x11 = q0_0(11); print(x11());
  let x12 = q0_0(12); print(x12());
  let x13 = q0_0(13); print(x13());
  let x14 = q0_0(14); print(x14());
  let x15 = q0_0(15); print(x15());
  let x16 = q0_0(16); print(x16());
  let x17 = q0_0(17); print(x17());
  let x18 = q0_0(18); print(x18());
  let x19 = q0_0(19); print(x19());
  let s = getsec; let q = pick(s, 1); print(q());
}
