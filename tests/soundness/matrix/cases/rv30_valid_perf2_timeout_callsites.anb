fn g7(acc, x, d) {
    if d <= 0 {
        return acc;
    }
    let a = g7(acc, [x], d - 1);
    let b = g0([acc, x], x, d - 1);
    return [a, b];
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    let xs = [p, S { k: 7, pub_n: 1 }];
    let r0 = g0([], p, 2);
    print(len(r0));
