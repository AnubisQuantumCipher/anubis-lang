struct S { k: secret<i64>, pub_n: i64 }
fn g0(acc, x, d) {
    if d <= 0 {
        return acc;
    }
    let a = g0(acc, [x], d - 1);
    let b = g1([acc, x], x, d - 1);
    return [a, b];
}
fn g1(acc, x, d) {
    if d <= 0 {
        return acc;
    }
    let a = g1(acc, [x], d - 1);
    let b = g2([acc, x], x, d - 1);
    return [a, b];
}
fn g2(acc, x, d) {
