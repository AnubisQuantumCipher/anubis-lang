struct Account { k: secret<i64>, name: str }
struct State { acct: Account, n: i64, mode: str }
struct Report { title: str, lines: i64 }
impl Report {
    fn show(self) -> str {
        return "${self}";
    }
}
impl State {
    fn show(self) -> str {
        return "state ${self.mode} ${self.n} for ${self.acct.name}";
    }
    fn step(self, ev: str) -> State {
        if let Some(x) = parse_int_opt(ev) {
            State { acct: self.acct, n: x, mode: "set" }
        } else {
            self
        }
    }
}
fn main() {
    let r = Report { title: "t", lines: 1 };
    println(r.show());
    let a = Account { k: 42, name: "alice" };
    let mut st = State { acct: a, n: 0, mode: "idle" };
    for ev in ["inc", "inc", "reset", "inc"] {
        st = st.step(ev);
    }
    println(st.show());
}
