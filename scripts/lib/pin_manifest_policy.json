    "secret.txt": {
      "kind": "file",
      "reason": "documented local secret scratch file"
    },
    "secrets": {
      "kind": "directory",
      "reason": "local secret material"
    },
    "site": {
      "kind": "directory",
      "reason": "held-back landing-page source outside the release tree"
    },
    "target": {
      "kind": "directory",
      "reason": "Cargo build output"
