    ".git": {
      "kind": "file_or_directory",
      "reason": "Git administrative metadata or linked-worktree pointer"
    },
    ".grok": {
      "kind": "directory",
      "reason": "local agent harness configuration"
    },
    ".hermes": {
      "kind": "directory",
      "reason": "local Hermes agent session state"
    },
    ".hunt2_findings": {
      "kind": "directory",
      "reason": "local generated security findings"
    },
    ".ruff_cache": {
      "kind": "directory",
      "reason": "generated Ruff analysis cache"
    },
    "AGENT_STUDY": {
      "kind": "directory",
      "reason": "generated agent study output"
    },
    "adversary": {
      "kind": "directory",
      "reason": "local adversarial review output"
    },
    "forensics": {
      "kind": "directory",
      "reason": "generated forensic run output"
    },
    "goal": {
      "kind": "directory",
      "reason": "local agent goal state"
