# Anubis.toml.example
# Copy to Anubis.toml (or place next to your .anb sources) and edit.
# Parsed by the typed manifest reader (compiler/src/project). Every section is optional.
# Resolution order for risc0 metal-hybrid reference:
#   1. --metal-reference (CLI)
#   2. ANUBIS_RISC0_METAL_REFERENCE (env)
#   3. This file: [backend.risc0_metal] reference_path
#   4. Built-in local default (only for the canonical development host)

# Project identity. Parsed today; consumed when the package manager lands (roadmap Phase 6).
#
# `edition` declares which version of the LANGUAGE this package is written
# against, independently of which compiler builds it. Declare it: a compiler
# that meets an edition it does not recognise refuses rather than compiling your
# code under different rules, and a manifest with no edition is a warning today
# and an error at 1.0. See docs/language/EDITIONS.md.
# [package]
# edition = "2026"
# name = "my-app"
# version = "0.1.0"
# description = "what it does"
# authors = ["you"]

# Dependencies. Parsed today (version string / { path = ... } / { git = ..., rev = ... });
# resolution + a lockfile + proof-carrying composition land in roadmap Phase 6.
# [dependencies]
# math  = "1.2"
# utils = { path = "../utils" }

[backend.risc0]
enabled = true
version = "3.0.5"
prove_mode = "in-process"

[backend.risc0_metal]
enabled = true
reference_path = "/path/to/metal-hybrid-prover"
vendored_patch_path = "/path/to/metal-hybrid-prover/vendor/risc0-circuit-rv32im"
require_tier2_metal = true
allow_cpu_fallback = false

[evidence]
schema_version = "1.0"
require_manifest = true
require_tamper_check = true
