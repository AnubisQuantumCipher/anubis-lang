{
  "version": "1",
  "description": "Pre-tool safety rules for Anubis A+ work. Enforced by tools/grok-safety-check.sh and agent discipline.",
  "rules": [
    {
      "id": "no-destructive-outside-generated",
      "pattern": "rm -rf /|rm -rf ~|rm -rf $HOME|rm -rf /Users/[^/]+$",
      "except": ["target/", "out/", "tmp/", "worktrees/"],
      "action": "block",
      "message": "Broad rm only allowed inside generated directories."
    },
    {
      "id": "git-no-force-outside-branch",
      "pattern": "git (reset --hard|push -f|clean -fdx)",
      "require": "branch matches a-plus-maturity",
      "action": "block"
    },
    {
      "id": "no-network-unless-declared",
      "pattern": "curl |wget |git (clone|fetch|push) .*[^0-9a-zA-Z./_-]",
      "allowlist": ["cargo", "rustup", "z3", "risc0 allowed toolchain ops"],
      "action": "warn"
    },
    {
      "id": "require-evidence-for-claims",
      "action": "document",
      "message": "Any claim of behavior change must cite test + artifact or sealed bundle."
    }
  ]
}
