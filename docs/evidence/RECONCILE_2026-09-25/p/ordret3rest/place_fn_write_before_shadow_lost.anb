struct S { k: secret<i64>, pub_n: i64 }
struct B { g: i64 }
fn pr(x) {
    print(x);
    return 0;
}
fn zero(x) {
    return 0;
}
fn main() {
    let p = S { k: 42, pub_n: 3 };
    let c = p.pub_n > 1;
    let b = B { g: zero };
    if c {
        b.g = pr;
        let b = B { g: zero };
    }
    let z = b.g(p.k);
}
