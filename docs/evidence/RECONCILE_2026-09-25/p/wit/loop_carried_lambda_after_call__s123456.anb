struct S { k: secret<i64>, pub_n: i64 }
fn pr(x) {
    print(x);
    return 0;
}
fn zero(x) {
    return 0;
}
fn idf(x) {
    return x;
}
fn main() {
    let p = S { k: 123456, pub_n: 3 };
    let f = zero;
    let i = 0;
    while i < 2 {
        let z = f(p.k);
        f = |x| { print(x); 0 };
        i = i + 1;
    }
}
