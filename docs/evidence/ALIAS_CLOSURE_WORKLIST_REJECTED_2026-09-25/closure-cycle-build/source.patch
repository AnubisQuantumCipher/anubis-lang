+/// Every free function (in modules too) with its formals and body.
+fn collect_free_fn_bodies<'a>(
+    items: &'a [Item],
+    out: &mut Vec<(&'a str, Vec<String>, &'a [Stmt])>,
+) {
+    for item in items {
+        match item {
+            Item::Module { items, .. } => collect_free_fn_bodies(items, out),
+            Item::Fn {
+                name, params, body, ..
+            } => out.push((
+                name.as_str(),
