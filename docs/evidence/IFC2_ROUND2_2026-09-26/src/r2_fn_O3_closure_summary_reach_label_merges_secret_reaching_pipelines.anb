fn wrap(next, name) {
    return |req| next(req + 1);
}
fn pipeline(base) {
    return wrap(wrap(wrap(wrap(wrap(base, "log"), "trace"), "limit"), "cors"), "gzip");
}
fn main() {
    let key: secret<i64> = 50;
    let check = pipeline(|req| declassify(req == key, "auth", "only whether the request is authorized"));
    let issue = pipeline(|req| req * key);
    let token = issue(3);
    let ok = check(37);
    println(ok);
}
