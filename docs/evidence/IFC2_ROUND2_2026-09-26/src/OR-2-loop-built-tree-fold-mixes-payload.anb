// A binary search tree of accounts: public ids as keys, secret balances as values, built in a
// loop. The report prints only how many accounts the tree holds.
enum Tree {
    Leaf,
    Node(i64, secret<i64>, Tree, Tree),
}

fn insert(t, k, v) {
    return match t {
        Tree::Leaf => Tree::Node(k, v, Tree::Leaf, Tree::Leaf),
        Tree::Node(k2, v2, l, r) => if k < k2 {
            Tree::Node(k2, v2, insert(l, k, v), r)
        } else {
            Tree::Node(k2, v2, l, insert(r, k, v))
        },
    };
}

fn size(t) {
    return match t {
        Tree::Leaf => 0,
        Tree::Node(k, v, l, r) => size(l) + 1 + size(r),
    };
}

fn main() {
    let base: secret<i64> = 42;
    let ids = [50, 20, 80];
    let mut t = Tree::Leaf;
    for id in ids {
        t = insert(t, id, base + id);
    }
    print("accounts: " + str(size(t)));
}
