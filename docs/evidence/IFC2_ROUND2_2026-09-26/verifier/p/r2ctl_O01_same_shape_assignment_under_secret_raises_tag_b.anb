struct Reading {
    level: i64,
}

impl Reading {
    fn describe(self) {
        println("reading");
    }
}

fn main() {
    let s: secret<i64> = 123456;
    let mut last = Some(0);
    let mut r = Reading { level: 0 };
    for i in [1, 2, 3] {
        if s > 100 {
            continue;
        }
        last = Some(i);
        r = Reading { level: i };
    }
    match last {
        Some(_) => println("have a reading"),
        None => println("no reading"),
    }
    r.describe();
}
