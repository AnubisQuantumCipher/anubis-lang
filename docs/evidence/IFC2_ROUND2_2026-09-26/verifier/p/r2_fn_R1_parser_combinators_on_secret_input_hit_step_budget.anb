fn lit(c) {
    return |s, i| if i < len(s) && s[i] == c { [1, i + 1] } else { [0, i] };
}
fn digit() {
    return |s, i| if i < len(s) && contains("0123456789", s[i]) { [1, i + 1] } else { [0, i] };
}
fn seq(p, q) {
    return |s, i| {
        let r = p(s, i);
        if r[0] == 1 { q(s, r[1]) } else { [0, i] }
    };
}
fn alt(p, q) {
    return |s, i| {
        let r = p(s, i);
        if r[0] == 1 { r } else { q(s, i) }
    };
}
fn many1(p, s, i) {
    let r = p(s, i);
    if r[0] == 0 {
        return [0, i];
    }
    let more = many1(p, s, r[1]);
    if more[0] == 1 {
        return more;
    }
    return r;
}
fn number(s, i) {
    return many1(digit(), s, i);
}
fn factor(s, i) {
    let paren = seq(lit("("), seq(|s2, j| expr(s2, j), lit(")")));
    return alt(paren, |s2, j| number(s2, j))(s, i);
}
fn term(s, i) {
    let op = alt(lit("*"), lit("/"));
    return alt(seq(|s2, j| factor(s2, j), seq(op, |s2, j| term(s2, j))), |s2, j| factor(s2, j))(s, i);
}
fn expr(s, i) {
    let op = alt(lit("+"), lit("-"));
    return alt(seq(|s2, j| term(s2, j), seq(op, |s2, j| expr(s2, j))), |s2, j| term(s2, j))(s, i);
}
fn parses(text) {
    let r = expr(text, 0);
    return r[0] == 1 && r[1] == len(text);
}
fn main() {
    let pin: secret<i64> = 42;
    println(parses("12+(3*4)-5"));
    println(parses("(1+2"));
    let hidden = parses(str(pin) + "*2");
    println(declassify(hidden, "demo", "validity bit only"));
}
