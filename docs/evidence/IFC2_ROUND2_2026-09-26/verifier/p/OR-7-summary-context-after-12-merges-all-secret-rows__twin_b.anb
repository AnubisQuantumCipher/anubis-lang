// Timesheets: each row is an employee name followed by the hours logged per day. Hours are
// confidential; the summary line shows the name and how many days were logged.
fn summary(row) {
    return row[0] + ": " + str(len(row) - 1) + " days";
}

fn main() {
    let h = 123456;
    print(summary(["ana", h + 0]));
    print(summary(["ben", h + 0, h + 1]));
    print(summary(["cho", h + 0, h + 1, h + 2]));
    print(summary(["dev", h + 0, h + 1, h + 2, h + 3]));
    print(summary(["eli", h + 0, h + 1, h + 2, h + 3, h + 4]));
    print(summary(["fay", h + 0, h + 1, h + 2, h + 3, h + 4, h + 5]));
    print(summary(["gus", h + 0, h + 1, h + 2, h + 3, h + 4, h + 5, h + 6]));
    print(summary(["hal", h + 0, h + 1, h + 2, h + 3, h + 4, h + 5, h + 6, h + 7]));
    print(summary(["ivy", h + 0, h + 1, h + 2, h + 3, h + 4, h + 5, h + 6, h + 7, h + 8]));
    print(summary(["jon", h + 0, h + 1, h + 2, h + 3, h + 4, h + 5, h + 6, h + 7, h + 8, h + 9]));
    print(summary(["kai", h + 0, h + 1, h + 2, h + 3, h + 4, h + 5, h + 6, h + 7, h + 8, h + 9, h + 10]));
    print(summary(["lea", h + 0, h + 1, h + 2, h + 3, h + 4, h + 5, h + 6, h + 7, h + 8, h + 9, h + 10, h + 11]));
    print(summary(["max", h + 0, h + 1, h + 2, h + 3, h + 4, h + 5, h + 6, h + 7, h + 8, h + 9, h + 10, h + 11, h + 12]));
    print(summary(["nia", h + 0, h + 1, h + 2, h + 3, h + 4, h + 5, h + 6, h + 7, h + 8, h + 9, h + 10, h + 11, h + 12, h + 13]));
}
