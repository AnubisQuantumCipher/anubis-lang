fn apply_all(xs, f) {
    if len(xs) == 0 {
        return [];
    }
    let rest = apply_all(drop(xs, 1), f);
    return [f(xs[0])] + rest;
}
fn main() {
    let s: secret<i64> = 123456;
    let hidden = apply_all([1, 2, 3], |x| x + s);
    let shown = apply_all([1, 2, 3], |x| x * 2);
    println(shown);
}
