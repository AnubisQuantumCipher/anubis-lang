+}
+
+#[test]
+fn minmax_repeatable_explicit_returns_preserve_public_argument_transcript() {
+    for op in ["min_by", "max_by"] {
+        for body in [
+            "println(x); return s;",
+            "let key = s; println(x); return [key];",
