+        );
+        assert_accepts(&source);
+    }
+}
+
+#[test]
+fn minmax_repeatable_keys_preserve_selected_value_labels() {
+    for op in ["min_by", "max_by"] {
+        for collection in ["[1, 2, 3]", "range(1, 4)"] {
+            let source = format!(
+                "fn main() {{ let s: secret<i64> = 42; \
+                 let m = {op}({collection}, |x| s); println(m); }}"
