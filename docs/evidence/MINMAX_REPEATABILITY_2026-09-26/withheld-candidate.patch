+}
+
+#[test]
+fn minmax_repeatability_is_per_fixed_capture_snapshot() {
+    for op in ["min_by", "max_by"] {
+        let source = format!(
+            "fn make(s) {{ return |x| {{ println(x); s }}; }} \
